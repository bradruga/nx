@namespace Nx.Components

@* Always rendered (empty when valid), so screen readers hear messages that appear. *@
<div @attributes="AdditionalAttributes" class="@CssClass" aria-live="polite">
    @foreach (var message in messages)
    {
        <div class="nx-validation-message">
            <svg class="nx-validation-message-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" />
            </svg>
            <span>@message</span>
        </div>
    }
</div>
