@namespace Nx.Components

<span @attributes="AdditionalAttributes" class="@CssClass" style="@Style" role="progressbar" aria-label="@AriaLabel">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        switch (Type)
        {
            case NxLoaderType.Pulsing:
                <span class="nx-loader-dot"></span><span class="nx-loader-dot"></span><span class="nx-loader-dot"></span>
                break;
            default:
                <span class="nx-loader-ring"></span>
                break;
        }
    }
</span>
