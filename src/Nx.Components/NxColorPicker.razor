@namespace Nx.Components

<div class="@CssClass" style="@Style">
    <button @ref="toggle"
            @attributes="AdditionalAttributes"
            id="@ToggleId"
            type="button"
            class="@ToggleCssClass"
            disabled="@Disabled"
            aria-haspopup="listbox"
            aria-expanded="@(isOpen ? "true" : "false")"
            aria-controls="@(isOpen ? PaletteId : null)"
            aria-label="@ToggleLabel"
            aria-invalid="@(validation.IsInvalid ? "true" : null)"
            @onclick="HandleToggleClick"
            @onkeydown="HandleToggleKeyDown">
        <span class="@SwatchCssClass" style="@SwatchStyle" aria-hidden="true"></span>
        @if (ShowValue)
        {
            <span class="nx-colorpicker-value">@(current ?? Placeholder)</span>
        }
        <svg class="nx-colorpicker-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </button>

    @if (isOpen)
    {
        @* No style attribute on the popup or its body: nx-popup.js places and sizes them. *@
        <div class="nx-colorpicker-popup" @ref="popup" @onkeydown="HandlePopupKeyDown">
            <div class="nx-colorpicker-body" @ref="body">
                <div class="nx-colorpicker-palette" @ref="palette" id="@PaletteId" role="listbox" aria-label="@(AriaLabel ?? "Colors")"
                     style="--nx-colorpicker-columns: @Columns">
                    @foreach (var (color, index) in Palette.Select((c, i) => (c, i)))
                    {
                        var selected = Same(color, current);
                        <button type="button"
                                class="@(selected ? "nx-colorpicker-cell nx-colorpicker-cell-selected" : "nx-colorpicker-cell")"
                                role="option"
                                aria-selected="@(selected ? "true" : "false")"
                                aria-label="@color"
                                title="@color"
                                tabindex="@(index == FocusIndex ? 0 : -1)"
                                style="background-color: @color"
                                @onclick="() => PickAsync(color)"></button>
                    }
                </div>
                @if (Clearable)
                {
                    <button type="button" class="nx-colorpicker-clear" disabled="@(current is null)" @onclick="() => PickAsync(null)">
                        <span class="nx-colorpicker-swatch nx-colorpicker-swatch-empty" aria-hidden="true"></span>
                        No color
                    </button>
                }
            </div>
        </div>
    }
</div>
