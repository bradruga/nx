@namespace Nx.Components

@* The strokes live in nx-signature.js; .NET holds the exported PNG (Value) and draws only the frame around the canvas. *@
<div @ref="root" @attributes="AdditionalAttributes" class="@CssClass" style="@OuterStyle" role="group" aria-label="@(AriaLabel ?? "Signature")"
     data-locked="@(Editable ? null : "true")">
    <canvas @ref="canvas" class="nx-signature-canvas" role="img" aria-label="@(IsEmpty ? "Not signed" : "Signed")"></canvas>
    <div class="nx-signature-line" aria-hidden="true"></div>
    @if (IsEmpty && !string.IsNullOrEmpty(Placeholder))
    {
        <div class="nx-signature-placeholder" aria-hidden="true">@Placeholder</div>
    }
    @if (!IsEmpty && Editable)
    {
        <button type="button" class="nx-signature-clear" aria-label="Clear signature" title="Clear" @onclick="ClearAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
                <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
            </svg>
        </button>
    }
</div>
