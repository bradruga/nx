@namespace Nx.Components
@implements IDisposable

@* The category axis registers with its NxChart and renders nothing. *@

@code {
    [CascadingParameter] private NxChart? Chart { get; set; }

    /// <summary>The axis title, under the labels.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The categories, in order, for series without a <c>CategoryField</c>.</summary>
    [Parameter] public System.Collections.IEnumerable? Categories { get; set; }

    /// <summary>The text shown under each category instead of the category itself (an empty text shows nothing).</summary>
    [Parameter] public IEnumerable<string?>? Labels { get; set; }

    /// <summary>Plain or date categories. Default: <see cref="NxChartAxisType.Auto"/>.</summary>
    [Parameter] public NxChartAxisType Type { get; set; } = NxChartAxisType.Auto;

    /// <summary>For dates: one category per hour, day, week, month or year. Default: <see cref="NxChartBaseUnit.Auto"/>.</summary>
    [Parameter] public NxChartBaseUnit BaseUnit { get; set; } = NxChartBaseUnit.Auto;

    /// <summary>The label format, e.g. <c>MMM yy</c> or <c>{0:MMM yy}</c>. Default: by the base unit for dates.</summary>
    [Parameter] public string? LabelFormat { get; set; }

    /// <summary>Labels every this many categories. Default: as many as fit.</summary>
    [Parameter] public int? LabelStep { get; set; }

    /// <summary>Categories without a label before the first one labelled. Default: <c>0</c>.</summary>
    [Parameter] public int LabelSkip { get; set; }

    /// <summary>Shows the labels and title. Default: <c>true</c>.</summary>
    [Parameter] public bool Visible { get; set; } = true;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Chart is null)
            throw new InvalidOperationException("NxChartCategoryAxis must be placed inside an NxChart.");
        Chart.Register(this);
    }

    /// <inheritdoc />
    public void Dispose() => Chart?.Unregister(this);
}
