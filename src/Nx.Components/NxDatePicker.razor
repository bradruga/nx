@namespace Nx.Components
@typeparam TValue

<NxFieldFrame ClassPrefix="nx-datepicker"
              InputId="@InputId"
              Label="@Label"
              ShowClear="ShowClear"
              OnClear="HandleClearClick"
              Disabled="Disabled"
              ReadOnly="ReadOnly"
              Invalid="validation.IsInvalid"
              Class="@RootClass"
              Style="@Style">
    <ChildContent>
        <input @ref="input"
               @attributes="AdditionalAttributes"
               id="@InputId"
               class="@InputCssClass"
               type="text"
               role="@(ShowCalendar ? "combobox" : null)"
               autocomplete="off"
               placeholder="@PlaceholderText"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-haspopup="@(!ShowCalendar ? null : UseSheet ? "dialog" : "grid")"
               aria-expanded="@(!ShowCalendar ? null : popupOpen ? "true" : "false")"
               aria-description="@(formatter.Shape is null ? null : "Up and Down change the day, month or year")"
               aria-controls="@(popupOpen ? CalendarId : null)"
               aria-activedescendant="@(popupOpen ? calendar?.ActiveDescendant : null)"
               aria-invalid="@(validation.IsInvalid ? "true" : null)"
               data-nx-edit="@(Editable ? FormatEdit(current) : null)"
               @bind="currentText"
               @bind:event="oninput"
               @bind:after="HandleInputAfter"
               @onchange="HandleChange"
               @onkeydown="HandleKeyDown"
               @onfocus="HandleFocus"
               @onblur="HandleBlur" />
    </ChildContent>
    <Buttons>
        @if (ShowCalendar)
        {
        <button @ref="toggle" type="button" class="nx-field-button nx-datepicker-button nx-datepicker-toggle" tabindex="-1"
                aria-label="Choose date" title="Choose date" aria-controls="@InputId"
                aria-expanded="@(popupOpen || sheetOpen ? "true" : "false")"
                disabled="@(!Editable)"
                @onmousedown:preventDefault="true" @onclick="HandleToggleClick">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </button>
        }
    </Buttons>
    <Below>
        @if (popupOpen)
        {
            @* No style attribute: nx-picker.js owns the popup's position. *@
            <div class="nx-datepicker-popup" @ref="popup" @onmousedown:preventDefault="true">
                <div class="nx-datepicker-popup-body" @ref="popupBody">
                    @RenderCalendar(focusable: false)
                </div>
            </div>
        }
        @if (sheetOpen)
        {
            <div class="nx-datepicker-sheet-host">
                <NxPickerSheet Title="@SheetTitle" Class="nx-datepicker-sheet" OnClose="CloseSheet">
                    @RenderCalendar(focusable: true)
                </NxPickerSheet>
            </div>
        }
    </Below>
</NxFieldFrame>

@code {
    private RenderFragment RenderCalendar(bool focusable) =>
        @<NxCalendar @ref="calendar"
                     Id="@CalendarId"
                     Value="current"
                     ValueChanged="HandleCalendarPick"
                     Min="Min"
                     Max="Max"
                     IsDateDisabled="IsDateDisabled"
                     ShowWeekNumbers="ShowWeekNumbers"
                     FirstDayOfWeek="FirstDayOfWeek"
                     Culture="EffectiveCulture"
                     ShowTodayButton="ShowTodayButton"
                     Focusable="focusable"
                     AriaLabel="@(Label ?? "Calendar")"
                     FooterContent="@(focusable && Clearable && DateConversion<TValue>.IsNullable ? SheetClear : null)"
                     OnNavigate="StateHasChanged" />;

    private RenderFragment SheetClear =>
        @<button type="button" class="nx-datepicker-sheet-clear" disabled="@(current is null)" @onclick="HandleSheetClear">Clear</button>;
}
