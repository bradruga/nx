@namespace Nx.Components
@typeparam TItem
@implements IDisposable

@* A column of an NxTreeList. It renders nothing itself: it registers with the list, which draws the header and cells. *@

@code {
    private NxTreeList<TItem>.Column? registered;

    [CascadingParameter] private NxTreeList<TItem>? List { get; set; }

    /// <summary>The property shown in the cell, by name (<c>nameof</c>), as Telerik's <c>Field</c>.</summary>
    [Parameter] public string? Field { get; set; }

    /// <summary>The header text.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The column's width (CSS). The tree column is at least this wide and takes the room left over.</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Holds the tree's arrows and indent. Default: the first column; only one column can.</summary>
    [Parameter] public bool Expandable { get; set; }

    /// <summary>The cell's content in place of the field's value.</summary>
    [Parameter] public RenderFragment<TItem>? Template { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (List is null)
            throw new InvalidOperationException("NxTreeListColumn must be placed inside an NxTreeList's Columns.");
        var column = new NxTreeList<TItem>.Column(Field, Title, Width, Expandable, Template);
        List.SetColumn(registered, column);
        registered = column;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (registered is not null)
            List?.RemoveColumn(registered);
    }
}
