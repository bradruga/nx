@namespace Nx.Components
@typeparam TValue

<span class="@CssClass" style="@Style">
    <button @ref="button"
            @attributes="AdditionalAttributes"
            id="@BoxId"
            type="button"
            role="checkbox"
            class="nx-checkbox-box"
            aria-checked="@AriaChecked"
            aria-readonly="@(ReadOnly ? "true" : null)"
            aria-invalid="@(validation.IsInvalid ? "true" : null)"
            disabled="@Disabled"
            @onclick="HandleClick">
        @if (State == true)
        {
            <svg class="nx-checkbox-mark" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
            </svg>
        }
        else if (State is null)
        {
            <svg class="nx-checkbox-mark" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true">
                <line x1="6" y1="12" x2="18" y2="12" />
            </svg>
        }
    </button>
    @if (HasLabel)
    {
        <label class="nx-checkbox-label" for="@BoxId">@Label@ChildContent</label>
    }
</span>
