@namespace Nx.Components

<NxFieldFrame ClassPrefix="nx-textbox"
              InputId="@InputId"
              Label="@Label"
              FloatingLabel="FloatingLabel"
              HasValue="HasText"
              PrefixContent="Prefix"
              SuffixContent="Suffix"
              ShowClear="ShowClear"
              OnClear="HandleClearClick"
              Disabled="Disabled"
              ReadOnly="ReadOnly"
              Invalid="validation.IsInvalid"
              Class="@Class"
              Style="@Style">
    <ChildContent>
        <input @ref="input"
               @attributes="AdditionalAttributes"
               id="@InputId"
               class="@InputCssClass"
               type="@InputType"
               placeholder="@Placeholder"
               maxlength="@MaxLength"
               inputmode="@InputModeAttribute"
               autocomplete="@AutoComplete"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-invalid="@(validation.IsInvalid ? "true" : null)"
               aria-describedby="@(ShowCounterText ? CounterId : null)"
               @bind="currentText"
               @bind:event="oninput"
               @bind:after="HandleInputAfter"
               @onchange="HandleChange"
               @onkeydown="HandleKeyDown"
               @onfocus="OnFocus"
               @onblur="OnBlur" />
    </ChildContent>
    <Buttons>
        @if (ShowToggle)
        {
            <button type="button" class="nx-field-button nx-textbox-button nx-textbox-password-toggle"
                    aria-label="@(showPassword ? "Hide password" : "Show password")"
                    title="@(showPassword ? "Hide password" : "Show password")"
                    aria-pressed="@(showPassword ? "true" : "false")"
                    aria-controls="@InputId"
                    @onclick="TogglePassword">
                @if (showPassword)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
                    </svg>
                }
            </button>
        }
    </Buttons>
    <Below>
        @if (ShowCounterText)
        {
            <div class="nx-field-counter nx-textbox-counter" id="@CounterId">@currentText.Length / @MaxLength</div>
        }
    </Below>
</NxFieldFrame>
