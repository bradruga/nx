@page "/datetimepicker/playground"
@using System.Globalization

<DocHeader Slug="datetimepicker" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner demo-preview-inner-stretch">
                <NxDateTimePicker Id="playground-datetime" @bind-Value="pgValue" @bind-Value:after="Changed"
                                  Format="@(OrNull(pgFormat) ?? "g")" Culture="Culture" TimeStep="pgStep"
                                  Min="pgMinOn ? MinValue : null" Max="pgMaxOn ? MaxValue : null"
                                  ShowWeekNumbers="pgWeeks" ShowTodayButton="pgToday"
                                  Label="@OrNull(pgLabel)" Placeholder="@OrNull(pgPlaceholder)"
                                  Clearable="pgClearable" ReadOnly="pgReadOnly" Disabled="pgDisabled" MobileMode="pgMobile" />
            </div>
            <div class="demo-row">
                <span class="demo-value" id="playground-value">Value: <strong>@(pgValue?.ToString("yyyy-MM-dd HH:mm:ss") ?? "null")</strong></span>
                <span class="demo-counter" id="playground-changes">ValueChanged × @pgChanges</span>
            </div>
        </div>

        <div class="demo-controls">
            <div class="demo-controls-title">Format</div>
            <label class="demo-control"><span>Format</span><input type="text" id="pg-format" placeholder="g" @bind="pgFormat" /></label>
            <label class="demo-control">
                <span>Culture</span>
                <select id="pg-culture" @bind="pgCulture">
                    <option value="en-US">en-US</option>
                    <option value="en-GB">en-GB</option>
                    <option value="de-DE">de-DE</option>
                    <option value="fr-CA">fr-CA</option>
                </select>
            </label>
            <label class="demo-control"><span>TimeStep</span><input type="number" id="pg-step" min="1" @bind="pgStep" /></label>

            <div class="demo-controls-title">Limits</div>
            <label class="demo-control"><span>Min (today 8:00)</span><input type="checkbox" id="pg-min" @bind="pgMinOn" /></label>
            <label class="demo-control"><span>Max (+14 days 17:00)</span><input type="checkbox" id="pg-max" @bind="pgMaxOn" /></label>

            <div class="demo-controls-title">Calendar</div>
            <label class="demo-control"><span>ShowWeekNumbers</span><input type="checkbox" id="pg-weeks" @bind="pgWeeks" /></label>
            <label class="demo-control"><span>ShowTodayButton</span><input type="checkbox" id="pg-today" @bind="pgToday" /></label>

            <div class="demo-controls-title">Text</div>
            <label class="demo-control"><span>Label</span><input type="text" @bind="pgLabel" @bind:event="oninput" /></label>
            <label class="demo-control"><span>Placeholder</span><input type="text" @bind="pgPlaceholder" @bind:event="oninput" /></label>

            <div class="demo-controls-title">Behavior</div>
            <label class="demo-control"><span>Clearable</span><input type="checkbox" id="pg-clearable" @bind="pgClearable" /></label>
            <label class="demo-control"><span>ReadOnly</span><input type="checkbox" id="pg-readonly" @bind="pgReadOnly" /></label>
            <label class="demo-control"><span>Disabled</span><input type="checkbox" id="pg-disabled" @bind="pgDisabled" /></label>
            <label class="demo-control">
                <span>MobileMode</span>
                <select id="pg-mobile" @bind="pgMobile">
                    @foreach (var m in Enum.GetValues<NxMobileMode>())
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
        </div>

        <div class="demo-playground-code">
            <pre class="doc-code">@PlaygroundCode</pre>
        </div>
    </div>
</div>

<DocPager Slug="datetimepicker" Page="playground" />

@code {
    static string? OrNull(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    static readonly DateTime MinValue = DateTime.Today.AddHours(8);
    static readonly DateTime MaxValue = DateTime.Today.AddDays(14).AddHours(17);

    DateTime? pgValue = DateTime.Today.AddDays(1).AddHours(10);
    string pgFormat = "g", pgCulture = "en-US", pgLabel = "Starts", pgPlaceholder = "";
    int pgStep = 30, pgChanges;
    bool pgMinOn, pgMaxOn, pgWeeks, pgToday = true, pgClearable = true, pgReadOnly, pgDisabled;
    NxMobileMode pgMobile = NxMobileMode.Auto;

    CultureInfo Culture => CultureInfo.GetCultureInfo(pgCulture);

    void Changed() => pgChanges++;

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string> { "@bind-Value=\"job.Start\"" };
            if (OrNull(pgFormat) is { } f && f != "g") attrs.Add($"Format=\"{f}\"");
            if (pgCulture != "en-US") attrs.Add($"Culture=\"CultureInfo.GetCultureInfo(\\\"{pgCulture}\\\")\"");
            if (pgStep != 30) attrs.Add($"TimeStep=\"{pgStep}\"");
            if (pgMinOn) attrs.Add("Min=\"DateTime.Today.AddHours(8)\"");
            if (pgMaxOn) attrs.Add("Max=\"DateTime.Today.AddDays(14).AddHours(17)\"");
            if (pgWeeks) attrs.Add("ShowWeekNumbers=\"true\"");
            if (!pgToday) attrs.Add("ShowTodayButton=\"false\"");
            if (OrNull(pgLabel) is { } l) attrs.Add($"Label=\"{l}\"");
            if (OrNull(pgPlaceholder) is { } p) attrs.Add($"Placeholder=\"{p}\"");
            if (pgClearable) attrs.Add("Clearable=\"true\"");
            if (pgReadOnly) attrs.Add("ReadOnly=\"true\"");
            if (pgDisabled) attrs.Add("Disabled=\"true\"");
            if (pgMobile != NxMobileMode.Auto) attrs.Add($"MobileMode=\"NxMobileMode.{pgMobile}\"");
            return "<NxDateTimePicker " + string.Join("\n                  ", attrs) + " />";
        }
    }
}
