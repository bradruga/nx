@page "/datetimepicker/api"

<DocHeader Slug="datetimepicker" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Value</td><td>DateTime / DateTime?</td><td>—</td><td>Use <code>@@bind-Value</code>. The kind (local, UTC) is kept.</td></tr>
                <tr><td>Format</td><td>string</td><td>"g"</td><td>Any .NET date and time format; all-number 24-hour ones are masked.</td></tr>
                <tr><td>Culture</td><td>CultureInfo?</td><td>current</td><td>Format, typing, names, AM/PM, first day of week.</td></tr>
                <tr><td>TimeStep</td><td>int</td><td>30</td><td>Minutes between listed times.</td></tr>
                <tr><td>Min / Max</td><td>DateTime?</td><td>—</td><td>Limits for days, listed times and typed values.</td></tr>
                <tr><td>IsDateDisabled</td><td>Func&lt;DateOnly, bool&gt;?</td><td>—</td><td>Days that cannot be picked.</td></tr>
                <tr><td>ShowWeekNumbers / FirstDayOfWeek / ShowTodayButton</td><td>bool / DayOfWeek? / bool</td><td>false / culture / true</td><td>The calendar, as NxDatePicker.</td></tr>
                <tr><td>Label / FloatingLabel / Placeholder</td><td></td><td></td><td>As NxTextBox; the placeholder defaults to the pattern.</td></tr>
                <tr><td>Clearable</td><td>bool</td><td>false</td><td>Clear button and Esc; nullable types only.</td></tr>
                <tr><td>ReadOnly / Disabled / AutoFocus</td><td>bool</td><td>false</td><td>As NxTextBox.</td></tr>
                <tr><td>MobileMode / MobileBreakpoint / MobileTitle</td><td>NxMobileMode / int / string?</td><td>Auto / 600 / Label</td><td>When the popup is a full-screen sheet.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>Input id; outer class and style. Other attributes go to the input.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ValueChanged</td><td>TValue</td><td>Committed: a day or time picked, Enter, or leaving the field.</td></tr>
                <tr><td>OnFocus / OnBlur</td><td>FocusEventArgs</td><td>Focus in and out (after the commit).</td></tr>
                <tr><td>FocusAsync()</td><td>ValueTask</td><td>Focuses the input.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <p class="doc-note">
        The field reads NxTextBox's variables, the calendar NxCalendar's (<code>--nx-calendar-*</code>), and the time list
        NxTimePicker's item tokens (<code>--nx-item-hover-bg</code>, <code>--nx-item-active-bg</code>, <code>--nx-item-selected-fg</code>).
    </p>
</div>

