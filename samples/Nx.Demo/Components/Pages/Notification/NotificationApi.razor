    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>HorizontalPosition</td><td>NxNotificationHorizontalPosition</td><td>Right</td><td>Left, Center, Right.</td></tr>
                <tr><td>VerticalPosition</td><td>NxNotificationVerticalPosition</td><td>Bottom</td><td>Top (newest first) or Bottom (newest last).</td></tr>
                <tr><td>MaxVisible</td><td>int</td><td>5</td><td>A new message beyond it closes the oldest.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the stack, e.g. <code>--nx-notification-offset</code>.</td></tr>
                <tr><td>Show(model)</td><td>NxNotificationModel</td><td></td><td>Shows a message; safe from any thread. Returns the model.</td></tr>
                <tr><td>Show(text, type)</td><td>NxNotificationModel</td><td></td><td>The short form with the model's defaults.</td></tr>
                <tr><td>Hide(model) / HideAll()</td><td>void</td><td></td><td>Closes one message, or all.</td></tr>
                <tr><td>Visible</td><td>IReadOnlyList&lt;NxNotificationModel&gt;</td><td></td><td>The messages showing, oldest first.</td></tr>
            </tbody>
        </table>
