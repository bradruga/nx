@page "/gantt/examples"

<DocHeader Slug="gantt" Page="examples" />

<div class="doc-section">
    <h2>Editing</h2>
    <p class="doc-note">
        Drag a bar to move its task, or either end to change its start or end: an outline snaps to whole days and Escape
        drops the drag. Click a title to edit it in place, double-click a row or bar for your own form, and press Delete on
        a row to remove it. Every edit arrives in <code>OnUpdate</code>, as in NxGrid: a drag has not touched the item, so
        write <code>args.Start</code> and <code>args.End</code> or your own dates (ERP moves them to the next working day); a cell's editor
        has already written it. Summary bars span their tasks and do not drag. <code>Editable="false"</code> turns it all off.
    </p>
    <div class="demo-stage demo-stage-column">
        <NxGantt TItem="ScheduleTask" Id="edit-gantt" Data="editTasks"
                 ItemId="t => t.Id" ParentId="t => t.ParentId" ItemTitle="t => t.Title" ItemStart="t => t.Start" ItemEnd="t => t.End"
                 Dependencies="editLinks" Editable="editable" @bind-SelectedItems="picked"
                 OnUpdate="Update" OnEdit="OpenForm" OnDelete="Delete" OnDependencyCreate="e => editLinks.Add(new NxGanttDependency(e.Predecessor.Id, e.Successor.Id, e.Type))"
                 TreeListWidth="400px" Height="420px" Style="width:100%">
            <ToolBarTemplate>
                <NxButton id="edit-add" Size="NxSize.Small" Disabled="!editable" OnClick="Add">Add task</NxButton>
                <NxButton id="edit-delete" Size="NxSize.Small" Disabled="@(!editable || Picked is null)" OnClick="() => Delete(Picked!)">Delete</NxButton>
                <NxCheckBox Id="edit-editable" @bind-Value="editable" Label="Editable" />
            </ToolBarTemplate>
            <Columns>
                <NxGanttColumn Value="t => t.Title" Title="Task" Width="200px" Expandable="true">
                    <EditorTemplate><NxTextBox @bind-Value="context.Title" Immediate="true" aria-label="Task" AutoFocus="true" /></EditorTemplate>
                </NxGanttColumn>
                <NxGanttColumn Value="t => t.Start" Title="Start" Width="90px" DisplayFormat="{0:MM/dd/yy}" />
                <NxGanttColumn Value="t => t.End" Title="End" Width="90px" DisplayFormat="{0:MM/dd/yy}" />
                <NxGanttColumn Value="t => t.Days" Title="Days" Width="60px" />
            </Columns>
        </NxGantt>
        <div class="demo-row">
            <span class="demo-value" id="edit-log">@log</span>
            <span class="demo-value" id="edit-selected">Selected: <strong>@(Picked?.Title ?? "none")</strong></span>
        </div>
    </div>
    <DocCode Code="@editCode" />
</div>

<NxDialog Id="edit-dialog" Visible="form is not null" VisibleChanged="v => { if (!v) form = null; }" Title="Edit task">
    <ChildContent>
        @if (form is not null)
        {
            <div class="demo-gantt-form">
                <NxTextBox Id="edit-title" Label="Task" @bind-Value="formTitle" />
                <NxTextBox Id="edit-resources" Label="Resources" @bind-Value="formResources" />
            </div>
        }
    </ChildContent>
    <Buttons>
        <NxButton OnClick="() => form = null">Cancel</NxButton>
        <NxButton id="edit-save" Variant="NxButtonVariant.Primary" OnClick="SaveForm">Save</NxButton>
    </Buttons>
</NxDialog>

<div class="doc-section">
    <h2>Drawing Dependencies</h2>
    <p class="doc-note">
        With <code>OnDependencyCreate</code> each bar shows a handle at both ends: drag from one to another bar to link them
        (end to start is finish-to-start). Add the link to <code>Dependencies</code> and its arrow appears.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxGantt TItem="ScheduleTask" Id="links-gantt" Data="linkTasks"
                 ItemId="t => t.Id" ParentId="t => t.ParentId" ItemTitle="t => t.Title" ItemStart="t => t.Start" ItemEnd="t => t.End"
                 Dependencies="drawn" OnDependencyCreate="Link" TreeListWidth="260px"
                 Height="360px" Style="width:100%">
            <Columns>
                <NxGanttColumn Value="t => t.Title" Title="Task" Width="200px" Expandable="true" />
            </Columns>
        </NxGantt>
        <span class="demo-value" id="links-count">@drawn.Count links@(lastLink is null ? "" : $" · last: {lastLink}")</span>
    </div>
    @* /code *@
    <DocExampleCode Key="drawing-dependencies" />
</div>

<div class="doc-section">
    <h2>Sorting &amp; the Filter Row</h2>
    <p class="doc-note">
        <code>Sortable</code>: a header click sorts tasks among their siblings (again for descending, a third time for the
        data's order). <code>FilterRow</code>: tasks containing the text, with their parents. <code>HasSort</code> and
        <code>HasFilter</code> drive the Clear buttons, as ERP's toolbar does.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxGantt @ref="filtered" TItem="ScheduleTask" Id="filter-gantt" Data="filterTasks"
                 ItemId="t => t.Id" ParentId="t => t.ParentId" ItemTitle="t => t.Title" ItemStart="t => t.Start" ItemEnd="t => t.End"
                 Sortable="true" FilterRow="true" OnStateChanged="StateHasChanged"
                 TreeListWidth="420px" Height="380px" Style="width:100%">
            <ToolBarTemplate>
                @if (filtered?.HasFilter == true)
                {
                    <NxButton id="clear-filter" Size="NxSize.Small" Variant="NxButtonVariant.Danger" OnClick="() => filtered.ClearFilterAsync()">Clear Filter</NxButton>
                }
                @if (filtered?.HasSort == true)
                {
                    <NxButton id="clear-sort" Size="NxSize.Small" Variant="NxButtonVariant.Danger" OnClick="() => filtered.ClearSortAsync()">Clear Sort</NxButton>
                }
                <span class="demo-value">Sort or filter to see the Clear buttons</span>
            </ToolBarTemplate>
            <Columns>
                <NxGanttColumn Value="t => t.Title" Title="Task" Width="200px" Expandable="true" />
                <NxGanttColumn Value="t => t.Resources" Title="Resources" Width="130px" />
                <NxGanttColumn Value="t => t.Days" Title="Days" Width="80px" />
            </Columns>
        </NxGantt>
    </div>
    @* /code *@
    <DocExampleCode Key="sorting-and-the-filter-row" />
</div>

<div class="doc-section">
    <h2>Templates</h2>
    <p class="doc-note">
        <code>TaskTemplate</code> draws each bar (here in the task's color, with its days), <code>TooltipTemplate</code> what
        shows under it, and <code>WeekHeaderTemplate</code> / <code>DayHeaderTemplate</code> the timeline's headers — ERP shows
        one letter per day.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxGantt TItem="ScheduleTask" Id="template-gantt" Data="templateTasks"
                 ItemId="t => t.Id" ParentId="t => t.ParentId" ItemTitle="t => t.Title" ItemStart="t => t.Start" ItemEnd="t => t.End"
                 Dependencies="templateLinks" SlotWidth="22" TreeListWidth="240px"
                 Height="360px" Style="width:100%">
            <TaskTemplate>
                <div class="demo-gantt-bar" style="background:@(string.IsNullOrEmpty(context.Color) ? "#5f6b73" : context.Color)">@context.Title · @context.Days d</div>
            </TaskTemplate>
            <TooltipTemplate>
                <strong>@context.Title</strong>
                <span>Start: @context.Start.ToString("ddd, MMM d")</span>
                <span>End: @context.End.AddDays(-1).ToString("ddd, MMM d")</span>
            </TooltipTemplate>
            <WeekHeaderTemplate>@context.ToString("MMM d, yy")</WeekHeaderTemplate>
            <DayHeaderTemplate><span title="@context.ToString("dddd, MMMM d, yyyy")">@context.ToString("ddd")[..1]</span></DayHeaderTemplate>
            <Columns>
                <NxGanttColumn Value="t => t.Title" Title="Task" Width="200px" Expandable="true" />
            </Columns>
        </NxGantt>
    </div>
    @* /code *@
    <DocExampleCode Key="templates" />
</div>

<DocPager Slug="gantt" Page="examples" />

@code {
    readonly List<ScheduleTask> editTasks = DemoGantt.Tasks();
    readonly List<NxGanttDependency> editLinks = DemoGantt.Links();
    IEnumerable<ScheduleTask> picked = [];
    bool editable = true;
    string log = "Drag a bar, or one of its ends";
    ScheduleTask? form;
    string? formTitle, formResources;

    ScheduleTask? Picked => picked.FirstOrDefault();

    void Update(NxGanttUpdateArgs<ScheduleTask> args)
    {
        if (args.Start is { } start) args.Item.Start = start;
        if (args.End is { } end) args.Item.End = end;
        DemoGantt.Rollup(editTasks);
        var task = args.Item;
        log = args.Kind == NxGanttUpdateKind.Edit
            ? $"Edit: {task.Title}"
            : $"{args.Kind}: {task.Title}, {task.Start:MMM d} to {task.End.AddDays(-1):MMM d} ({task.Days} d)";
    }

    // After the selected task, among its siblings; else at the end.
    void Add()
    {
        var after = Picked;
        var start = after?.Start ?? DateTime.Today;
        var task = new ScheduleTask { Id = editTasks.Max(t => t.Id) + 1, ParentId = after?.ParentId, Title = "New task", Start = start, End = start.AddDays(2) };
        editTasks.Insert(after is null ? editTasks.Count : editTasks.IndexOf(after) + 1, task);
        DemoGantt.Rollup(editTasks);
        picked = [task];
        log = "Added: New task";
    }

    void Delete(ScheduleTask task)
    {
        var gone = new HashSet<int> { task.Id };
        // Children follow their parent out.
        while (editTasks.Where(t => t.ParentId is int p && gone.Contains(p)).Select(t => t.Id).Where(gone.Add).ToList().Count > 0) { }
        editTasks.RemoveAll(t => gone.Contains(t.Id));
        editLinks.RemoveAll(l => gone.Contains((int)l.PredecessorId) || gone.Contains((int)l.SuccessorId));
        DemoGantt.Rollup(editTasks);
        picked = [];
        log = $"Deleted: {task.Title}";
    }

    void OpenForm(ScheduleTask task)
    {
        form = task;
        formTitle = task.Title;
        formResources = task.Resources;
    }

    void SaveForm()
    {
        if (form is null) return;
        form.Title = formTitle ?? "";
        form.Resources = formResources ?? "";
        log = $"Saved: {form.Title}";
        form = null;
    }

    const string editCode =
        """
        <NxGantt Data="tasks"
                 ItemId="t => t.Id" ParentId="t => t.ParentId" ItemTitle="t => t.Title" ItemStart="t => t.Start" ItemEnd="t => t.End"
                 Dependencies="links" Editable="canEdit" @bind-SelectedItems="selected"
                 OnUpdate="SaveAsync" OnEdit="OpenTaskForm" OnDelete="DeleteAsync">
            …
        </NxGantt>

        async Task SaveAsync(NxGanttUpdateArgs<Task> args)
        {
            // args.Kind: Edit (a cell: args.OldValue, args.NewValue), Move, ResizeStart or ResizeEnd.
            if (args.Start is { } start) args.Item.Start = start;
            if (args.End is { } end) args.Item.End = end;
            await db.SaveAsync(args.Item);
        }
        """;

    readonly List<ScheduleTask> linkTasks = DemoGantt.Tasks(), filterTasks = DemoGantt.Tasks(), templateTasks = DemoGantt.Tasks();
    readonly List<NxGanttDependency> templateLinks = DemoGantt.Links();
    readonly List<NxGanttDependency> drawn = [];
    NxGantt<ScheduleTask>? filtered;
    string? lastLink;

    void Link(NxGanttDependencyCreateEventArgs<ScheduleTask> e)
    {
        drawn.Add(new NxGanttDependency(e.Predecessor.Id, e.Successor.Id, e.Type));
        lastLink = $"{e.Predecessor.Title} → {e.Successor.Title} ({e.Type})";
    }
}
