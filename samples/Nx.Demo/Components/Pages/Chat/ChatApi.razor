@page "/chat/api"

<DocHeader Slug="chat" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Data</td><td>IEnumerable&lt;TItem&gt;?</td><td>—</td><td>The messages, oldest first.</td></tr>
                <tr><td>AuthorId</td><td>string?</td><td>—</td><td>The user: messages with this author id are on the right.</td></tr>
                <tr><td>ItemId</td><td>Func&lt;TItem, object?&gt;?</td><td>—</td><td>A message's unique id, to keep its markup through updates.</td></tr>
                <tr><td>ItemAuthorId</td><td>Func&lt;TItem, object?&gt;?</td><td>—</td><td>A message's author id, compared with <code>AuthorId</code> as text.</td></tr>
                <tr><td>ItemAuthorName</td><td>Func&lt;TItem, string?&gt;?</td><td>—</td><td>The author's name, over their messages; also their initials.</td></tr>
                <tr><td>ItemAuthorImageUrl</td><td>Func&lt;TItem, string?&gt;?</td><td>—</td><td>The author's picture; initials or an icon without one.</td></tr>
                <tr><td>ItemText</td><td>Func&lt;TItem, string?&gt;?</td><td>—</td><td>The text, shown as plain text with its line breaks.</td></tr>
                <tr><td>ItemTimestamp</td><td>Func&lt;TItem, object?&gt;?</td><td>—</td><td>When it was sent (<code>DateTime</code> / <code>DateTimeOffset</code>): times and day lines.</td></tr>
                <tr><td>ItemIsTyping</td><td>Func&lt;TItem, bool&gt;?</td><td>—</td><td>Marks a "typing" message, shown as moving dots.</td></tr>
                <tr><td>MessageContentTemplate</td><td>RenderFragment&lt;NxChatMessageContext&lt;TItem&gt;&gt;?</td><td>the text</td><td>A bubble's content: <code>Message</code>, <code>IsOwn</code>, <code>IsTyping</code>.</td></tr>
                <tr><td>MessageWidthMode</td><td>NxChatMessageWidthMode</td><td>Standard</td><td>Standard (¾ of the width) or Full.</td></tr>
                <tr><td>Height / Width</td><td>string?</td><td>500px / —</td><td>CSS sizes; <code>100%</code> fills a container with a height.</td></tr>
                <tr><td>Placeholder</td><td>string?</td><td>Type a message…</td><td>The message box's placeholder.</td></tr>
                <tr><td>NoDataText</td><td>string?</td><td>No messages yet</td><td>Shown while there are no messages.</td></tr>
                <tr><td>Culture</td><td>CultureInfo?</td><td>current</td><td>Times and dates.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>No sending; the messages stay readable.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>Messages</td><td>The message list's accessible name.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>On the outer element; the box is <code>{Id}-input</code>. Other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>OnSendMessage</td><td>EventCallback&lt;NxChatSendMessageEventArgs&gt;</td><td>The user sent <code>Message</code> (trimmed, never empty). Add it to <code>Data</code>.</td></tr>
                <tr><td>Refresh()</td><td>void</td><td>Redraws after <code>Data</code> changed in place outside a render.</td></tr>
                <tr><td>ScrollToBottomAsync()</td><td>Task</td><td>Back to the newest message, following new ones again.</td></tr>
                <tr><td>FocusAsync()</td><td>ValueTask</td><td>Focuses the message box.</td></tr>
            </tbody>
        </table>
    </div>
</div>

