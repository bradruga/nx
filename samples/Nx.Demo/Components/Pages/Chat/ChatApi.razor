            <tbody>
                <tr><td>--nx-chat-bg</td><td>--nx-surface</td><td>The chat's background.</td></tr>
                <tr><td>--nx-chat-own-bg / --nx-chat-own-fg</td><td>--nx-accent / --nx-accent-fg</td><td>The user's bubbles.</td></tr>
                <tr><td>--nx-chat-other-bg / --nx-chat-other-fg</td><td>#f0f0f3 (#26262c dark) / --nx-fg</td><td>Everyone else's bubbles.</td></tr>
                <tr><td>--nx-chat-meta</td><td>--nx-fg-muted</td><td>Names, times, day lines.</td></tr>
                <tr><td>--nx-chat-avatar-bg</td><td>#d9dce3 (#34343d dark)</td><td>Avatars without a picture.</td></tr>
                <tr><td>--nx-chat-avatar-size</td><td>32px</td><td>Avatar size.</td></tr>
                <tr><td>--nx-chat-bubble-radius</td><td>14px</td><td>Bubble corners.</td></tr>
                <tr><td>--nx-chat-bubble-width</td><td>75%</td><td>The widest a Standard bubble grows.</td></tr>
            </tbody>
        </table>
    </div>
</div>

