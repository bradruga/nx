@page "/multiselect/examples"
@using System.ComponentModel.DataAnnotations

<DocHeader Slug="multiselect" Page="examples" />

<div class="doc-section">
    <h2>Select All &amp; Filter</h2>
    <p class="doc-note">
        Type to filter, then <strong>Select all</strong> selects only what is listed — type <em>new</em> and Select all picks the
        New… states. With everything listed already selected, it clears them.
    </p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <label class="demo-field-label" for="all-multi">States</label>
        <NxMultiSelect Id="all-multi" TItem="string" TValue="string" Data="SampleData.States" @bind-Values="states" SelectAll="true" Placeholder="Pick states" />
        <div class="demo-row"><span class="demo-value" id="all-value">Values: <strong>[@string.Join(", ", states)]</strong></span></div>
    </div>
</div>

<div class="doc-section">
    <h2>Summary</h2>
    <p class="doc-note">
        <code>SummaryThreshold</code> swaps the chips for one summary once more than that many are selected; <code>0</code>
        always summarizes. <code>SummaryFormat</code> sets the text.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="summary-multi">Plants (summary above 2)</label>
                <NxMultiSelect Id="summary-multi" TItem="string" TValue="string" Data="Plants" @bind-Values="plants" SummaryThreshold="2" SelectAll="true" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="summary-value">Values: <strong>[@string.Join(", ", plants)]</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="summary-always">Shifts (always a summary)</label>
                <NxMultiSelect Id="summary-always" TItem="string" TValue="string" Data="Shifts" @bind-Values="shifts" SummaryThreshold="0"
                               SummaryFormat="{0} shifts" Filterable="false" Placeholder="Any shift" />
            </div>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Max Selections</h2>
    <p class="doc-note">
        <code>MaxSelections</code> caps the count: once reached, the rest of the list greys out until something is removed.
        Select all stops at the cap too.
    </p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <label class="demo-field-label" for="max-multi">Inspectors (up to 3)</label>
        <NxMultiSelect Id="max-multi" Data="SampleData.Employees" ItemText="e => e.Name" ItemValue="e => e.Id" @bind-Values="inspectors"
                       MaxSelections="3" Placeholder="Up to three" />
        <div class="demo-row"><span class="demo-value" id="max-value">Values: <strong>[@string.Join(", ", inspectors)]</strong></span></div>
    </div>
</div>

<div class="doc-section">
    <h2>Grouping, Templates &amp; Chips</h2>
    <p class="doc-note"><code>ItemGroup</code>, <code>ItemTemplate</code>, <code>ChipTemplate</code> and <code>MaxVisibleChips</code> work as on the combo box.</p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <label class="demo-field-label" for="group-multi">Team</label>
        <NxMultiSelect Id="group-multi" Data="SampleData.Employees" ItemText="e => e.Name" ItemValue="e => e.Id" ItemGroup="e => e.Department"
                       @bind-Values="team" MaxVisibleChips="3" Placeholder="Pick people">
            <ItemTemplate Context="e"><span class="demo-person"><strong>@e.Name</strong><span>@e.Title</span></span></ItemTemplate>
            <ChipTemplate Context="e"><span class="demo-person-inline"><DemoIcon Name="user" /> @e.Name.Split(' ')[0]</span></ChipTemplate>
        </NxMultiSelect>
    </div>
</div>

<div class="doc-section">
    <h2>Columns &amp; Long Lists</h2>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <label class="demo-field-label" for="virtual-multi">Parts (50,000, virtualized)</label>
        <NxMultiSelect Id="virtual-multi" Data="SampleData.Parts" ItemText="p => p.Number" ItemValue="p => p.Id" @bind-Values="parts"
                       Virtualize="true" SummaryThreshold="3" PopupWidth="420px" Placeholder="Search parts">
            <Columns>
                <NxComboBoxColumn Field="p => p.Number" Header="Part" Width="90px" />
                <NxComboBoxColumn Field="p => p.Description" Header="Description" />
            </Columns>
        </NxMultiSelect>
    </div>
</div>

<div class="doc-section">
    <h2>Phone Sheet</h2>
    <p class="doc-note">
        At 600px and below the list opens full screen with a search box; toggles apply on <strong>Done</strong> and Back discards
        them. <code>MobileMode="Always"</code> forces it here.
    </p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <label class="demo-field-label" for="sheet-multi">Plants</label>
        <NxMultiSelect Id="sheet-multi" TItem="string" TValue="string" Data="Plants" @bind-Values="sheetPlants" MobileMode="NxComboBoxMobileMode.Always"
                       MobileTitle="Plants" SelectAll="true" />
        <div class="demo-row"><span class="demo-value" id="sheet-value">Values: <strong>[@string.Join(", ", sheetPlants)]</strong></span></div>
    </div>
</div>

<div class="doc-section">
    <h2>Form Validation</h2>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <EditForm id="multi-form" Model="report" OnValidSubmit="Submit" FormName="multi-form">
            <DataAnnotationsValidator />
            <label class="demo-field-label" for="report-plants">Plants</label>
            <NxMultiSelect Id="report-plants" TItem="string" TValue="string" Data="Plants" @bind-Values="report.Plants" Placeholder="At least two" />
            <ValidationMessage For="() => report.Plants" />
            <div class="demo-row" style="margin-top:16px">
                <NxButton id="multi-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Run report</NxButton>
                <span class="demo-value" id="multi-result">@result</span>
            </div>
        </EditForm>
    </div>
</div>

<DocPager Slug="multiselect" Page="examples" />

@code {
    static readonly string[] Plants = ["Albany", "Bethlehem", "Hartford", "Newburgh", "Syracuse", "Worcester"];
    static readonly string[] Shifts = ["Day", "Swing", "Night", "Weekend"];

    IEnumerable<string> states = [], plants = [], shifts = ["Day", "Night"], sheetPlants = [];
    IEnumerable<int> inspectors = [], team = [2, 7], parts = [];
    string result = "Not run";
    readonly ReportForm report = new();

    void Submit() => result = $"Report for {string.Join(", ", report.Plants)}";

    class ReportForm
    {
        [MinLength(2, ErrorMessage = "Pick at least two plants.")]
        public IEnumerable<string> Plants { get; set; } = [];
    }
}
