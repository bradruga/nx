@page "/dateinput"
@page "/dateinput/overview"

<DocHeader Slug="dateinput" Page="overview" />

<div class="doc-section">
    <h2>What It Is</h2>
    <p class="doc-note">
        <code>NxDateInput</code> is a typed date with no calendar button: <a href="datepicker/overview">NxDatePicker</a>'s field on
        its own. Typing is masked in the culture's order, and Up and Down step the day, month or year under the caret, like a
        spin box. Use it beside an <code>NxCalendar</code>, as ERP's date dialog does, or anywhere a popup would be in
        the way.
    </p>
</div>

<div class="doc-section">
    <h2>Basic Usage</h2>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <NxDateInput TValue="DateTime" Id="overview-date" Label="Ship date" @bind-Value="ship" />
        <span class="demo-value" id="overview-value">Value: <strong>@ship.ToString("yyyy-MM-dd")</strong></span>
    </div>
    <pre class="doc-code">@basicCode</pre>
</div>

<div class="doc-section">
    <h2>Keyboard &amp; Accessibility</h2>
    <div class="doc-table-wrap">
        <table class="doc-table">
            <thead><tr><th>Key</th><th>Behavior</th></tr></thead>
            <tbody>
                <tr><td>Digits</td><td>Fill the pattern; separators are added (<code>10232026</code> becomes 10/23/2026), and typing one early pads (<code>1/5/</code> becomes 01/05/).</td></tr>
                <tr><td>↑ / ↓</td><td>Step the part under the caret: the day, the month or the year, wrapping within its range. An empty field starts from today.</td></tr>
                <tr><td>Enter / leaving the field</td><td>Commits the typed date; unreadable text goes back to the last date.</td></tr>
                <tr><td>Escape</td><td>With <code>Clearable</code>: clears it.</td></tr>
                <tr><td>Screen readers</td><td>A plain text input with its label; the Up/Down keys are described.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<DocPager Slug="dateinput" Page="overview" />

@code {
    DateTime ship = new(2026, 10, 23);

    const string basicCode =
        """
        <NxDateInput TValue="DateTime" Label="Ship date" @bind-Value="order.ShipDate" />
        """;
}
