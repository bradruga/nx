@page "/dateinput/playground"

<DocHeader Slug="dateinput" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner demo-preview-inner-stretch">
                <NxDateInput TValue="DateOnly?" Id="playground-date" @bind-Value="pgValue" @bind-Value:after="() => pgChanges++"
                             Label="@OrNull(pgLabel)" FloatingLabel="pgFloating" Placeholder="@OrNull(pgPlaceholder)"
                             Format="@(OrNull(pgFormat) ?? "d")" Min="pgUseMin ? Min : null" Max="pgUseMax ? Max : null"
                             Clearable="pgClearable" Disabled="pgDisabled" ReadOnly="pgReadOnly" />
            </div>
            <div class="demo-row">
                <span class="demo-value" id="playground-value">Value: <strong>@(pgValue?.ToString("yyyy-MM-dd") ?? "null")</strong></span>
                <span class="demo-counter" id="playground-changes">ValueChanged × @pgChanges</span>
            </div>
        </div>

        <div class="demo-controls">
            <div class="demo-controls-title">Text</div>
            <label class="demo-control"><span>Label</span><input type="text" id="pg-label" @bind="pgLabel" @bind:event="oninput" /></label>
            <label class="demo-control"><span>FloatingLabel</span><input type="checkbox" id="pg-floating" @bind="pgFloating" /></label>
            <label class="demo-control"><span>Placeholder</span><input type="text" id="pg-placeholder" @bind="pgPlaceholder" @bind:event="oninput" /></label>
            <label class="demo-control">
                <span>Format</span>
                <select id="pg-format" @bind="pgFormat">
                    @foreach (var f in Formats)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </label>

            <div class="demo-controls-title">Limits</div>
            <label class="demo-control"><span>Min <code>@Min</code></span><input type="checkbox" id="pg-min" @bind="pgUseMin" /></label>
            <label class="demo-control"><span>Max <code>@Max</code></span><input type="checkbox" id="pg-max" @bind="pgUseMax" /></label>

            <div class="demo-controls-title">State</div>
            <label class="demo-control"><span>Clearable</span><input type="checkbox" id="pg-clearable" @bind="pgClearable" /></label>
            <label class="demo-control"><span>ReadOnly</span><input type="checkbox" id="pg-readonly" @bind="pgReadOnly" /></label>
            <label class="demo-control"><span>Disabled</span><input type="checkbox" id="pg-disabled" @bind="pgDisabled" /></label>
        </div>

        <div class="demo-playground-code">
            <pre class="doc-code">@PlaygroundCode</pre>
        </div>
    </div>
</div>

<DocPager Slug="dateinput" Page="playground" />

@code {
    static string? OrNull(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    static readonly string[] Formats = ["d", "yyyy-MM-dd", "MMM d, yyyy", "dddd, MMMM d, yyyy"];
    static readonly DateOnly Min = new(2026, 1, 1), Max = new(2026, 12, 31);

    DateOnly? pgValue = new DateOnly(2026, 6, 15);
    string pgLabel = "Delivery date", pgPlaceholder = "", pgFormat = "d";
    bool pgFloating, pgUseMin, pgUseMax, pgClearable = true, pgDisabled, pgReadOnly;
    int pgChanges;

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string> { "TValue=\"DateOnly?\"", "@bind-Value=\"delivery\"" };
            if (OrNull(pgLabel) is { } label) attrs.Add($"Label=\"{label}\"");
            if (pgFloating) attrs.Add("FloatingLabel=\"true\"");
            if (OrNull(pgPlaceholder) is { } placeholder) attrs.Add($"Placeholder=\"{placeholder}\"");
            if (pgFormat != "d") attrs.Add($"Format=\"{pgFormat}\"");
            if (pgUseMin) attrs.Add("Min=\"new DateOnly(2026, 1, 1)\"");
            if (pgUseMax) attrs.Add("Max=\"new DateOnly(2026, 12, 31)\"");
            if (pgClearable) attrs.Add("Clearable=\"true\"");
            if (pgReadOnly) attrs.Add("ReadOnly=\"true\"");
            if (pgDisabled) attrs.Add("Disabled=\"true\"");
            return "<NxDateInput " + string.Join(" ", attrs) + " />";
        }
    }
}
