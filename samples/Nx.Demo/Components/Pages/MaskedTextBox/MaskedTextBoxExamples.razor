@page "/maskedtextbox/examples"
@using System.ComponentModel.DataAnnotations

<DocHeader Slug="maskedtextbox" Page="examples" />

<div class="doc-section">
    <h2>Common Masks</h2>
    <p class="doc-note">Without <code>IncludeLiterals</code> the value is only what was typed — the phone below is stored as ten digits.</p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <NxMaskedTextBox Id="mask-phone" Label="Phone" Mask="(000) 000-0000" @bind-Value="phone" />
                <span class="demo-value" id="mask-phone-value">Value: <strong>@(phone ?? "null")</strong></span>
            </div>
            <div>
                <NxMaskedTextBox Id="mask-zip" Label="ZIP+4" Mask="00000-0000" IncludeLiterals="true" @bind-Value="zip" />
                <span class="demo-value" id="mask-zip-value">Value: <strong>@(zip ?? "null")</strong></span>
            </div>
            <div>
                <NxMaskedTextBox Id="mask-part" Label="Part code" Mask="LL-000-A" IncludeLiterals="true" @bind-Value="part" />
                <span class="demo-value" id="mask-part-value">Value: <strong>@(part ?? "null")</strong></span>
            </div>
            <div>
                <NxMaskedTextBox Id="mask-time" Label="Shift (hh:mm–hh:mm)" Mask="00:00–00:00" IncludeLiterals="true" @bind-Value="shift" />
                <span class="demo-value" id="mask-time-value">Value: <strong>@(shift ?? "null")</strong></span>
            </div>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Prompt &amp; Mask on Focus</h2>
    <p class="doc-note">
        <code>Prompt</code> is the character in an empty slot (<code>_</code> by default). <code>MaskOnFocus</code> hides the
        mask of an empty field until it is focused, so the placeholder shows.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <NxMaskedTextBox Id="prompt-dot" Label="Prompt ·" Mask="000-000" Prompt="'·'" @bind-Value="dot" />
            <NxMaskedTextBox Id="prompt-focus" Label="Mask on focus" Mask="00-0000" MaskOnFocus="true" Placeholder="YY-MM00" @bind-Value="onFocus" />
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Clear &amp; State</h2>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <NxMaskedTextBox Id="clear-mask" Label="Clearable" Clearable="true" Mask="(000) 000-0000" @bind-Value="clearable" />
            <NxMaskedTextBox Id="readonly-mask" Label="Read-only" ReadOnly="true" Mask="00-0000" IncludeLiterals="true" Value="26-0301" />
            <NxMaskedTextBox Id="disabled-mask" Label="Disabled" Disabled="true" Mask="00-0000" IncludeLiterals="true" Value="26-0302" />
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Form Validation</h2>
    <p class="doc-note"><code>IsComplete</code> tells whether every slot is filled; here a <code>RegularExpression</code> checks the whole number.</p>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <EditForm id="mask-form" Model="model" OnValidSubmit="() => result = Saved()" FormName="mask-form">
            <DataAnnotationsValidator />
            <NxMaskedTextBox Id="mask-bid" Label="Bid number" Mask="00-0000" IncludeLiterals="true" @bind-Value="model.BidNumber" />
            <NxValidationMessage For="() => model.BidNumber" />
            <div class="demo-row" style="margin-top:16px">
                <NxButton id="mask-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Save bid</NxButton>
                <span class="demo-value" id="mask-result">@result</span>
            </div>
        </EditForm>
    </div>
</div>

<DocPager Slug="maskedtextbox" Page="examples" />

@code {
    string? phone = "2075550142", zip, part = "PC-104-B", shift, dot, onFocus, clearable = "8005550199";
    string result = "Not saved";
    readonly BidForm model = new();

    string Saved() => $"Saved {model.BidNumber}";

    class BidForm
    {
        [Required(ErrorMessage = "Enter the bid number.")]
        [RegularExpression(@"^\d{2}-\d{4}$", ErrorMessage = "A bid number is YY-MM00, all six digits.")]
        public string? BidNumber { get; set; }
    }
}
