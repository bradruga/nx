@page "/circulargauge/examples"
@implements IDisposable

<DocHeader Slug="circulargauge" Page="examples" />

<div class="doc-section">
    <h2>Loading Progress</h2>
    <p class="doc-note">As ERP's AIA reconciliation: the share loaded so far, with "Loading…" in the middle and no animation between steps.</p>
    <div class="demo-stage demo-stage-column">
        <NxCircularGauge Id="loading-gauge" Value="loaded" Transitions="false" Size="160px" AriaLabel="Loading">
            <CenterTemplate>@(context >= 100 ? "Done" : "Loading…")</CenterTemplate>
        </NxCircularGauge>
        <div class="demo-row">
            <NxButton id="loading-start" Size="NxButtonSize.Small" OnClick="StartAsync" Disabled="running">Load</NxButton>
            <span class="demo-value" id="loading-value">@loaded%</span>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Range &amp; Color</h2>
    <p class="doc-note"><code>Min</code> and <code>Max</code> set the scale; <code>Color</code> the arc — here it turns amber, then red, as the yard fills.</p>
    <div class="demo-stage demo-stage-column">
        <NxCircularGauge Id="yard-gauge" Value="pieces" Min="0" Max="240" Color="@YardColor" Size="180px" AriaLabel="Yard pieces">
            <CenterTemplate><span class="demo-gauge-value">@context</span><br /><span class="demo-gauge-label">of 240 spots</span></CenterTemplate>
        </NxCircularGauge>
        <NxSlider TValue="int" Min="0" Max="240" LargeStep="40" @bind-Value="pieces" aria-label="Pieces in the yard" Style="width:280px;max-width:100%" />
    </div>
</div>

<div class="doc-section">
    <h2>Sizes</h2>
    <p class="doc-note"><code>Size</code> is any CSS length; the ring's thickness scales with it.</p>
    <div class="demo-stage">
        @foreach (var (size, v) in new[] { ("64px", 30.0), ("120px", 55.0), ("200px", 80.0) })
        {
            <NxCircularGauge Value="v" Size="@size" AriaLabel="@($"Example at {size}")">
                <CenterTemplate>@context%</CenterTemplate>
            </NxCircularGauge>
        }
    </div>
</div>

<DocPager Slug="circulargauge" Page="examples" />

@code {
    readonly CancellationTokenSource stop = new();
    int loaded, pieces = 150;
    bool running;

    string YardColor => pieces > 216 ? "var(--nx-danger)" : pieces > 168 ? "var(--nx-warning)" : "var(--nx-success)";

    async Task StartAsync()
    {
        running = true;
        loaded = 0;
        try
        {
            while (loaded < 100)
            {
                await Task.Delay(120, stop.Token);
                loaded = Math.Min(100, loaded + 7);
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            return;
        }
        running = false;
    }

    public void Dispose()
    {
        stop.Cancel();
        stop.Dispose();
    }
}
