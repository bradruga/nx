@page "/circulargauge"
@page "/circulargauge/overview"

<DocHeader Slug="circulargauge" Page="overview" />

<div class="doc-section">
    <h2>What It Is</h2>
    <p class="doc-note">
        <code>NxCircularGauge</code> shows one value on a ring that fills clockwise from the top, from <code>Min</code> to
        <code>Max</code>, with anything you like in the middle — a percentage, a label, a status. It animates to a new value and
        is a <code>meter</code> to screen readers. One scale and one pointer, as ERP uses a gauge, set by plain parameters.
    </p>
</div>

<div class="doc-section">
    <h2>Basic Usage</h2>
    <div class="demo-stage">
        <NxCircularGauge Id="overview-gauge" Value="value" AriaLabel="Reconciled">
            <CenterTemplate><span class="demo-gauge-value">@context.ToString("0")%</span><br /><span class="demo-gauge-label">reconciled</span></CenterTemplate>
        </NxCircularGauge>
        <div class="demo-row">
            <NxButton id="overview-less" Size="NxButtonSize.Small" OnClick="() => value = Math.Max(0, value - 15)">− 15</NxButton>
            <NxButton id="overview-more" Size="NxButtonSize.Small" OnClick="() => value = Math.Min(100, value + 15)">+ 15</NxButton>
        </div>
    </div>
    <DocCode Code="@basicCode" />
</div>

<div class="doc-section">
    <h2>Accessibility</h2>
    <div class="doc-table-wrap">
        <table class="doc-table">
            <thead><tr><th>Part</th><th>Behavior</th></tr></thead>
            <tbody>
                <tr><td>Role</td><td>A <code>meter</code> with <code>aria-valuemin</code>, <code>-max</code> and <code>-now</code>, named by <code>AriaLabel</code>.</td></tr>
                <tr><td>Motion</td><td>The arc's animation is off when the user asks for reduced motion, or with <code>Transitions="false"</code>.</td></tr>
                <tr><td>Center</td><td>Read as text; the ring itself is hidden from screen readers.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<DocPager Slug="circulargauge" Page="overview" />

@code {
    double value = 64;

    const string basicCode =
        """
        <NxCircularGauge Value="reconciledPercent" AriaLabel="Reconciled">
            <CenterTemplate>@context.ToString("0")% reconciled</CenterTemplate>
        </NxCircularGauge>
        """;
}
