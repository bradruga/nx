@page "/combobox/examples"
@using System.ComponentModel.DataAnnotations

<DocHeader Slug="combobox" Page="examples" />

<div class="doc-section">
    <h2>Simple List</h2>
    <p class="doc-note">
        When the items are the values — a list of strings — no selectors are needed. Type to filter, or press
        <kbd class="doc-kbd">↓</kbd> to open the whole list.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="simple-combo">State</label>
                <NxComboBox Id="simple-combo" Data="SampleData.States" @bind-Value="simpleState" Placeholder="Pick a state" Clearable="true" />
            </div>
            <div class="demo-row"><span class="demo-value" id="simple-value">Value: <strong>@(simpleState ?? "null")</strong></span></div>
        </div>
    </div>
    <DocCode Code="@simpleCode" />
</div>

<div class="doc-section">
    <h2>Value &amp; Selected Item</h2>
    <p class="doc-note">
        <code>ItemText</code> is what the user sees and types against; <code>ItemValue</code> is what is stored — here the
        customer's <code>Id</code>. Bind <code>@@bind-Value</code> for the key, <code>@@bind-SelectedItem</code> for the
        whole record. Setting either from code updates the field.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="value-combo">Customer</label>
                <NxComboBox Id="value-combo" TItem="Customer" TValue="int?" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id"
                            @bind-Value="customerId" @bind-SelectedItem="customer" Clearable="true" Placeholder="Search customers" />
            </div>
            <div class="demo-row" style="align-self:end">
                <span class="demo-value" id="value-id">Value: <strong>@(customerId?.ToString() ?? "null")</strong></span>
                <span class="demo-value" id="value-item">City: <strong>@(customer?.City ?? "—")</strong></span>
            </div>
        </div>
        <div class="demo-row">
            <NxButton id="value-set-11" Size="NxSize.Small" OnClick="() => customerId = 11">Set Value = 11</NxButton>
            <NxButton id="value-set-item" Size="NxSize.Small" OnClick="() => customer = SampleData.Customers[3]">Set SelectedItem = Cape Cod</NxButton>
            <NxButton id="value-clear" Size="NxSize.Small" Variant="NxButtonVariant.Ghost" OnClick="() => { customerId = null; customer = null; }">Clear from code</NxButton>
        </div>
    </div>
    <DocCode Code="@valueCode" />
</div>

<div class="doc-section">
    <h2>Filtering</h2>
    <p class="doc-note">
        <code>Contains</code> (the default) and <code>StartsWith</code> match the item text, ignoring case, and the matched
        text is underlined. <code>None</code> keeps the list whole and only moves the highlight. <code>CustomFilter</code>
        replaces them all — this one matches the customer code or any word of the name, so <em>gran</em> and
        <em>KIEW</em> both work.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="filter-contains">Contains</label>
                <NxComboBox Id="filter-contains" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id" @bind-Value="filterContains" />
            </div>
            <div>
                <label class="demo-field-label" for="filter-starts">StartsWith</label>
                <NxComboBox Id="filter-starts" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id" Filter="NxComboBoxFilter.StartsWith" @bind-Value="filterStarts" />
            </div>
            <div>
                <label class="demo-field-label" for="filter-none">None</label>
                <NxComboBox Id="filter-none" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id" Filter="NxComboBoxFilter.None" @bind-Value="filterNone" />
            </div>
            <div>
                <label class="demo-field-label" for="filter-custom">CustomFilter: code or word</label>
                <NxComboBox Id="filter-custom" Data="SampleData.Customers" ItemText="@(c => $"{c.Code} — {c.Name}")" ItemValue="c => c.Id"
                            CustomFilter="MatchCodeOrWord" @bind-Value="filterCustom" />
            </div>
        </div>
    </div>
    <DocCode Code="@filterCode" />
</div>

<div class="doc-section">
    <h2>Popup Positioning</h2>
    <p class="doc-note">
        The popup opens below the field and flips above it when there is not enough room below — scroll this field to the
        bottom of the window and open it. It is positioned against the window, so a clipping container like the one on the
        right (<code>overflow: hidden</code>, 60 px tall) does not cut it off. It closes on <kbd class="doc-kbd">Esc</kbd>,
        on <kbd class="doc-kbd">Tab</kbd>, and on a click anywhere outside.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="position-combo">Flips near the bottom edge</label>
                <NxComboBox Id="position-combo" Data="SampleData.States" @bind-Value="positionState" />
            </div>
            <div class="demo-clip-box">
                <label class="demo-field-label" for="clip-combo">Inside overflow: hidden</label>
                <NxComboBox Id="clip-combo" Data="SampleData.States" @bind-Value="clipState" />
            </div>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="popup-positioning" />
</div>

<div class="doc-section">
    <h2>Async Data Provider</h2>
    <p class="doc-note">
        <code>DataProvider</code> is called when the list opens and, after <code>DebounceDelay</code> (300 ms by default),
        as the user types. Each call gets the typed text and a <code>CancellationToken</code> that is cancelled when a newer
        call starts, so a slow response never overwrites a newer one. A spinner shows while it runs. This one waits 700 ms.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="provider-combo">Customer (server search)</label>
                <NxComboBox Id="provider-combo" TItem="Customer" TValue="int?" DataProvider="SearchCustomers"
                            ItemText="c => c.Name" ItemValue="c => c.Id"
                            @bind-Value="providerId" @bind-SelectedItem="providerCustomer"
                            Placeholder="Type a name, code or city" Clearable="true">
                    <ItemTemplate Context="c">
                        <span>@c.Name</span>
                        <span class="demo-item-meta">@c.City</span>
                    </ItemTemplate>
                </NxComboBox>
            </div>
            <div class="demo-row" style="align-self:end">
                <span class="demo-value" id="provider-value">Value: <strong>@(providerId?.ToString() ?? "null")</strong></span>
            </div>
        </div>
        <EventLog @ref="providerLog" Label="Provider calls" EmptyText="Open the list or type to call the provider." />
    </div>
    <DocCode Code="@providerCode" />
</div>

<div class="doc-section">
    <h2>Value Before the List Loads</h2>
    <p class="doc-note">
        A <code>DataProvider</code> has no items until its list opens, so a bound <code>Value</code> has no text to show.
        <code>ItemByValue</code> finds that one item: it is called once for a value the list has not loaded, and the field
        shows its text straight away. The second field has the same value and no <code>ItemByValue</code>, so it has no text
        to show.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-form-grid demo-form-grid-2">
            <div>
                <label class="demo-field-label" for="lookup-combo">Customer (ItemByValue)</label>
                <NxComboBox Id="lookup-combo" TItem="Customer" TValue="int?" DataProvider="LoadCustomers" ItemByValue="FindCustomer"
                            ItemText="c => c.Name" ItemValue="c => c.Id" @bind-Value="lookupId" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="lookup-value">Value: <strong>@(lookupId?.ToString() ?? "null")</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="lookup-none">Customer (provider only)</label>
                <NxComboBox Id="lookup-none" TItem="Customer" TValue="int?" DataProvider="LoadCustomers"
                            ItemText="c => c.Name" ItemValue="c => c.Id" @bind-Value="lookupNoneId" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="lookup-none-value">Value: <strong>@(lookupNoneId?.ToString() ?? "null")</strong></span></div>
            </div>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="value-before-the-list-loads" />
    <DocCode Code="@lookupCode" />
</div>

<div class="doc-section">
    <h2>Virtualization</h2>
    <p class="doc-note">
        A list of <code>VirtualizeThreshold</code> rows or more (200 by default) renders only the rows in view, so this list of
        <strong>@SampleData.Parts.Count.ToString("N0")</strong> parts opens and scrolls instantly; nothing to switch on. Every
        row is then one height, measured from the rows the first time such a list opens, or set with <code>ItemHeight</code>.
        Keyboard navigation and <kbd class="doc-kbd">PgDn</kbd> scroll the list to keep the highlighted row in view. The
        second list has taller rows from an <code>ItemTemplate</code> and virtualizes from 50 rows.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid demo-form-grid-2">
            <div>
                <label class="demo-field-label" for="virtual-combo">Part</label>
                <NxComboBox Id="virtual-combo" Data="SampleData.Parts" ItemText="@(p => $"{p.Number}  {p.Description}")" ItemValue="p => p.Id"
                            @bind-Value="partId" Placeholder="50,000 parts — type to filter" Clearable="true" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="virtual-value">Value: <strong>@(partId?.ToString() ?? "null")</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="virtual-template">Part (two-line rows, measured)</label>
                <NxComboBox Id="virtual-template" Data="SampleData.Parts" ItemText="p => p.Number" ItemValue="p => p.Id"
                            VirtualizeThreshold="50" @bind-Value="templatePartId" Placeholder="Type to filter">
                    <ItemTemplate Context="p">
                        <span class="demo-person"><strong>@p.Number</strong><span>@p.Description</span></span>
                    </ItemTemplate>
                </NxComboBox>
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="virtual-template-value">Value: <strong>@(templatePartId?.ToString() ?? "null")</strong></span></div>
            </div>
        </div>
    </div>
    <DocCode Code="@virtualCode" />
</div>

<div class="doc-section">
    <h2>Grouping</h2>
    <p class="doc-note">
        <code>ItemGroup</code> puts items under headers, in the order each group first appears. Headers are skipped by the
        arrow keys. <code>GroupHeaderTemplate</code> customizes them — here with a count.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="group-combo">Customer by region</label>
                <NxComboBox Id="group-combo" Data="CustomersByRegion" ItemText="c => c.Name" ItemValue="c => c.Id" ItemGroup="c => c.Region"
                            @bind-Value="groupedId">
                    <GroupHeaderTemplate Context="region">
                        @region <span class="demo-group-count">@SampleData.Customers.Count(c => c.Region == region)</span>
                    </GroupHeaderTemplate>
                </NxComboBox>
            </div>
            <div>
                <label class="demo-field-label" for="group-employee">Employee by department</label>
                <NxComboBox Id="group-employee" Data="EmployeesByDepartment" ItemText="e => e.Name" ItemValue="e => e.Id" ItemGroup="e => e.Department"
                            @bind-Value="groupedEmployee" />
            </div>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="grouping" />
</div>

<div class="doc-section">
    <h2>Templates</h2>
    <p class="doc-note">
        <code>ItemTemplate</code> renders each row; <code>SelectedItemTemplate</code> renders the choice in the field while
        it is not focused. Focus the field and it shows plain text again, ready to type.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="template-combo">Assigned to</label>
                <NxComboBox Id="template-combo" Data="SampleData.Employees" ItemText="e => e.Name" ItemValue="e => e.Id"
                            @bind-Value="assigneeId" Clearable="true" Placeholder="Pick an engineer">
                    <ItemTemplate Context="e">
                        <span class="demo-avatar">@Initials(e.Name)</span>
                        <span class="demo-item-main">
                            <span>@e.Name</span>
                            <span class="demo-item-meta">@e.Title · @e.Department</span>
                        </span>
                    </ItemTemplate>
                    <SelectedItemTemplate Context="e">
                        <span class="demo-avatar demo-avatar-sm">@Initials(e.Name)</span>
                        <span>@e.Name</span>
                        <span class="demo-item-meta">@e.Title</span>
                    </SelectedItemTemplate>
                </NxComboBox>
            </div>
        </div>
    </div>
    <DocCode Code="@templateCode" />
</div>

<div class="doc-section">
    <h2>Custom Values</h2>
    <p class="doc-note">
        <code>AllowCustomValue</code> keeps typed text that matches no item — the list becomes suggestions. It needs a
        <code>string</code> value. <kbd class="doc-kbd">Enter</kbd> keeps what you typed unless you arrowed to an item.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <label class="demo-field-label" for="custom-combo">Ship via</label>
                <NxComboBox Id="custom-combo" Data="SampleData.ShipVia" AllowCustomValue="true" @bind-Value="shipVia" Clearable="true" Placeholder="Pick or type" />
            </div>
            <div class="demo-row" style="align-self:end"><span class="demo-value" id="custom-value">Value: <strong>@(shipVia ?? "null")</strong></span></div>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="custom-values" />
</div>

<div class="doc-section">
    <h2>Multi-Column</h2>
    <p class="doc-note">
        Declare <code>NxComboBoxColumn</code> children inside <code>Columns</code> — or pass <code>ColumnDefinitions</code> — and the
        list becomes an aligned grid under a header that stays put while you scroll. Typing matches any column (here, type a city
        or a region); set <code>FilterAllColumns="false"</code> to match the item text only. The field still shows
        <code>ItemText</code>. Keyboard navigation and virtualization work as before — the second list is the 50,000 parts.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid demo-form-grid-2">
            <div>
                <label class="demo-field-label" for="columns-combo">Customer</label>
                <NxComboBox Id="columns-combo" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id"
                            @bind-Value="columnsCustomerId" PopupWidth="520px" Placeholder="Name, code, city or region" Clearable="true">
                    <Columns>
                        <NxComboBoxColumn Field="c => c.Code" Header="Code" Width="64px" />
                        <NxComboBoxColumn Field="c => c.Name" Header="Customer" Width="minmax(150px, 2fr)" />
                        <NxComboBoxColumn Field="c => c.City" Header="City" Width="minmax(90px, 1fr)" />
                        <NxComboBoxColumn Field="c => c.Region" Header="Region" Width="110px">
                            <Template Context="c"><span class="demo-region demo-region-@RegionKey(c.Region)">@c.Region</span></Template>
                        </NxComboBoxColumn>
                    </Columns>
                </NxComboBox>
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="columns-value">Value: <strong>@(columnsCustomerId?.ToString() ?? "null")</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="columns-parts">Part (50,000, virtualized)</label>
                <NxComboBox Id="columns-parts" Data="SampleData.Parts" ItemText="p => p.Number" ItemValue="p => p.Id"
                            ColumnDefinitions="PartColumns" PopupWidth="460px" @bind-Value="columnsPartId" Placeholder="Number, description or category" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="columns-part-value">Value: <strong>@(columnsPartId?.ToString() ?? "null")</strong></span></div>
            </div>
        </div>
    </div>
    <DocCode Code="@columnsCode" />
</div>

<div class="doc-section">
    <h2>Multi-Select</h2>
    <p class="doc-note">
        <code>Multiple="true"</code> keeps the list open while you pick: click, <kbd class="doc-kbd">Enter</kbd>, or
        <kbd class="doc-kbd">Space</kbd> once you have arrowed to an item toggles it. Choices show as chips;
        <kbd class="doc-kbd">Backspace</kbd> in the empty field removes the last one, the clear button removes them all.
        Bind <code>@@bind-Values</code> and/or <code>@@bind-SelectedItems</code>. <code>MaxVisibleChips</code> collapses the rest into
        "+N more", and <code>ChipTemplate</code> renders each chip.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-form-grid demo-form-grid-2">
            <div>
                <label class="demo-field-label" for="multi-combo">Crew</label>
                <NxComboBox Id="multi-combo" Data="SampleData.Employees" ItemText="e => e.Name" ItemValue="e => e.Id"
                            Multiple="true" @bind-Values="crewIds" MaxVisibleChips="3" Clearable="true" Placeholder="Add people">
                    <ChipTemplate Context="e"><span class="demo-avatar demo-avatar-xs">@Initials(e.Name)</span>@e.Name</ChipTemplate>
                </NxComboBox>
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="multi-values">Values: <strong>[@string.Join(", ", crewIds)]</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="multi-states">Service area, with columns</label>
                <NxComboBox Id="multi-states" Data="SampleData.Customers" ItemText="c => c.City" ItemValue="c => c.Id"
                            Multiple="true" @bind-SelectedItems="serviceCities" ColumnDefinitions="CityColumns" PopupWidth="380px"
                            Clearable="true" Placeholder="Cities" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="multi-items">SelectedItems: <strong>@serviceCities.Count()</strong></span></div>
            </div>
        </div>
        <EditForm id="multi-form" Model="crewForm" OnValidSubmit="SubmitCrew" FormName="multi-form">
            <DataAnnotationsValidator />
            <label class="demo-field-label" for="multi-required">Inspectors (at least two)</label>
            <NxComboBox Id="multi-required" Data="SampleData.Employees" ItemText="e => e.Name" ItemValue="e => e.Id"
                        Multiple="true" @bind-Values="crewForm.InspectorIds" Placeholder="Pick two or more" />
            <ValidationMessage For="() => crewForm.InspectorIds" />
            <div class="demo-row" style="margin-top:12px">
                <NxButton id="multi-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Assign</NxButton>
                <span class="demo-value" id="multi-result">@crewResult</span>
            </div>
        </EditForm>
    </div>
    <DocCode Code="@multipleCode" />
</div>

<div class="doc-section">
    <h2>Mobile Overlay</h2>
    <p class="doc-note">
        Opt in with <code>MobileMode</code> and the list opens full screen: a search box at the top that takes focus, a back
        button, and the list in the rest of the screen — virtualized and multi-column when configured. Picking an item closes
        it; back and <kbd class="doc-kbd">Esc</kbd> close without a change; with <code>Multiple</code>, Done commits.
        <code>MobileMode="Auto"</code> uses it at <code>MobileBreakpoint</code> (600 px) and below, as on the third field;
        <code>Always</code> forces it, as on the first two, so you can try it on a desktop. The default, <code>Never</code>,
        keeps the popup on every screen.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-form-grid demo-form-grid-2">
            <div>
                <label class="demo-field-label" for="mobile-combo">Customer (overlay)</label>
                <NxComboBox Id="mobile-combo" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id"
                            MobileMode="NxMobileMode.Always" MobileTitle="Find a customer" @bind-Value="mobileCustomerId" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="mobile-value">Value: <strong>@(mobileCustomerId?.ToString() ?? "null")</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="mobile-multi">Parts (overlay, Multiple, columns)</label>
                <NxComboBox Id="mobile-multi" Data="SampleData.Parts" ItemText="p => p.Number" ItemValue="p => p.Id"
                            ColumnDefinitions="PartColumns" Multiple="true" MaxVisibleChips="2" @bind-Values="mobilePartIds"
                            MobileMode="NxMobileMode.Always" MobileTitle="Find parts" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="mobile-multi-values">Values: <strong>[@string.Join(", ", mobilePartIds)]</strong></span></div>
            </div>
            <div>
                <label class="demo-field-label" for="mobile-auto">State (overlay on a phone)</label>
                <NxComboBox Id="mobile-auto" Data="SampleData.States" MobileMode="NxMobileMode.Auto" MobileTitle="Find a state" @bind-Value="mobileState" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="mobile-auto-value">Value: <strong>@(mobileState ?? "null")</strong></span></div>
            </div>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="mobile-overlay" />
</div>

<div class="doc-section">
    <h2>Form Validation</h2>
    <p class="doc-note">
        Inside an <code>EditForm</code>, <code>@@bind-Value</code> identifies the field: the combo box turns red with
        <code>aria-invalid</code> while it has messages and works with the built-in <code>ValidationMessage</code>.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <EditForm id="combo-form" Model="ticket" OnValidSubmit="SubmitTicket" FormName="combo-form">
            <DataAnnotationsValidator />
            <div class="demo-form-grid demo-form-grid-2">
                <div>
                    <label class="demo-field-label" for="form-customer">Customer</label>
                    <NxComboBox Id="form-customer" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id"
                                @bind-Value="ticket.CustomerId" Placeholder="Required" Clearable="true" />
                    <ValidationMessage For="() => ticket.CustomerId" />
                </div>
                <div>
                    <label class="demo-field-label" for="form-state">Job state</label>
                    <NxComboBox Id="form-state" Data="SampleData.States" @bind-Value="ticket.State" Placeholder="Required" />
                    <ValidationMessage For="() => ticket.State" />
                </div>
            </div>
            <div class="demo-row" style="margin-top:16px">
                <NxButton id="combo-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Create ticket</NxButton>
                <span class="demo-value" id="combo-result">@ticketResult</span>
            </div>
        </EditForm>
    </div>
    @* /code *@
    <DocExampleCode Key="form-validation" />
</div>

<DocPager Slug="combobox" Page="examples" />

@code {
    static string Initials(string name) => string.Concat(name.Split(' ').Select(w => w[0]));

    static bool MatchCodeOrWord(Customer c, string text) =>
        c.Code.StartsWith(text, StringComparison.OrdinalIgnoreCase) ||
        c.Name.Split(' ').Any(w => w.StartsWith(text, StringComparison.OrdinalIgnoreCase));

    static readonly List<Customer> CustomersByRegion = SampleData.Customers.OrderBy(c => c.Region).ThenBy(c => c.Name).ToList();
    static readonly List<Employee> EmployeesByDepartment = SampleData.Employees.OrderBy(e => e.Department).ThenBy(e => e.Name).ToList();

    // ── Sections ───────────────────────────────────────────────────────────────
    string? simpleState;
    int? customerId = 8;
    Customer? customer = SampleData.Customers[7];
    int? filterContains, filterStarts, filterNone, filterCustom;
    int? providerId;
    Customer? providerCustomer;
    EventLog? providerLog;
    int providerCalls;
    int? lookupId = 12, lookupNoneId = 12;
    int? partId, templatePartId;
    string? mobileState;
    int? groupedId, groupedEmployee;
    int? assigneeId = 3;
    string? shipVia;
