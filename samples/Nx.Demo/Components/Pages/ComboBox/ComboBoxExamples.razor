    static Task<IEnumerable<Customer>> LoadCustomers(NxComboBoxRequest request) =>
        SampleData.SearchCustomersAsync(request.Filter, 700, request.CancellationToken);

    static Task<Customer?> FindCustomer(int? id) => Task.FromResult(SampleData.Customers.FirstOrDefault(c => c.Id == id));

    async Task<IEnumerable<Customer>> SearchCustomers(NxComboBoxRequest request)
    {
        var call = ++providerCalls;
        providerLog?.Add($"#{call} DataProvider(\"{request.Filter}\") started");
        try
        {
            var result = (await SampleData.SearchCustomersAsync(request.Filter, 700, request.CancellationToken)).ToList();
            providerLog?.Add($"#{call} returned {result.Count} item(s)");
            return result;
        }
        catch (OperationCanceledException)
        {
            providerLog?.Add($"#{call} cancelled by a newer call");
            throw;
        }
    }

