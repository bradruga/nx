@page "/popup/examples"

<DocHeader Slug="popup" Page="examples" />

<div class="doc-section">
    <h2>Column Filter Menu</h2>
    <p class="doc-note">
        As ERP's spreadsheet filter: below the header button, right edges lined up (<code>Align="NxPopupAlign.End"</code>),
        sort first, then a search box over the values with a check box each.
    </p>
    @* code *@
    <div class="demo-stage">
        <div class="demo-popup-header">
            <span>Mix</span>
            <button type="button" id="mix-filter" class="demo-popup-header-button" aria-label="Filter Mix" aria-expanded="@(filterOpen ? "true" : "false")"
                    @onclick="() => filterOpen = !filterOpen"><NxIcon Icon="NxIcons.ChevronDown" /></button>
        </div>
        <NxPopup Id="filter-popup" @bind-Visible="filterOpen" AnchorSelector="#mix-filter" Align="NxPopupAlign.End" Width="240px" AriaLabel="Filter Mix">
            <div class="demo-popup-body">
                <NxButton Variant="NxButtonVariant.Ghost" Size="NxSize.Small" OnClick="() => Sort(false)">Sort A to Z</NxButton>
                <NxButton Variant="NxButtonVariant.Ghost" Size="NxSize.Small" OnClick="() => Sort(true)">Sort Z to A</NxButton>
                <NxTextBox Id="filter-search" @bind-Value="search" Immediate="true" Placeholder="Search" aria-label="Search values" />
                @foreach (var mix in Mixes.Where(m => string.IsNullOrEmpty(search) || m.Contains(search, StringComparison.OrdinalIgnoreCase)))
                {
                    <NxCheckBox TValue="bool" Value="chosen.Contains(mix)" ValueChanged="v => Toggle(mix, v)" Label="@mix" />
                }
            </div>
        </NxPopup>
        <span class="demo-value" id="filter-result">@sortText · @chosen.Count of @Mixes.Length shown</span>
    </div>
    @* /code *@
    <DocExampleCode Key="column-filter-menu" />
</div>

<div class="doc-section">
    <h2>Placement &amp; Align</h2>
    <p class="doc-note">Each side and alignment. Near an edge it flips to the side with room and shifts along the anchor.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <div class="demo-row">
            @foreach (var placement in Enum.GetValues<NxPopupPlacement>())
            {
                var p = placement;
                <NxButton id="@($"place-{p.ToString().ToLowerInvariant()}")" Size="NxSize.Small"
                          Variant="@(shown == p ? NxButtonVariant.Primary : NxButtonVariant.Secondary)" OnClick="() => Show(p)">@p</NxButton>
            }
        </div>
        <div class="demo-row">
            @foreach (var align in Enum.GetValues<NxPopupAlign>())
            {
                var a = align;
                <NxButton Size="NxSize.Small" Variant="@(alignment == a ? NxButtonVariant.Primary : NxButtonVariant.Secondary)" OnClick="() => alignment = a">@a</NxButton>
            }
        </div>
        <div class="demo-popup-target-wrap">
            <span id="place-target" class="demo-popup-target">Anchor</span>
        </div>
        <NxPopup Id="place-popup" Visible="shown is not null" VisibleChanged="v => { if (!v) shown = null; }" AnchorSelector="#place-target"
                 Placement="shown ?? NxPopupPlacement.Bottom" Align="alignment" Offset="8">
            <div class="demo-popup-body">@shown, @alignment</div>
        </NxPopup>
    </div>
    @* /code *@
    <DocExampleCode Key="placement-and-align" />
</div>

<div class="doc-section">
    <h2>Details Card</h2>
    <p class="doc-note">Content that stays open while the user works elsewhere: <code>CloseOnOutsideClick="false"</code> and a close button.</p>
    @* code *@
    <div class="demo-stage">
        <NxButton id="card-anchor" Variant="NxButtonVariant.Link" OnClick="() => cardOpen = true">WP-12</NxButton>
        <NxPopup Id="card-popup" @bind-Visible="cardOpen" AnchorSelector="#card-anchor" Placement="NxPopupPlacement.Right" CloseOnOutsideClick="false"
                 Width="260px" AriaLabel="Panel WP-12">
            <div class="demo-popup-body">
                <div class="demo-row" style="justify-content:space-between">
                    <strong>Wall panel WP-12</strong>
                    <NxButton id="card-close" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" AriaLabel="Close" Icon="@CloseIcon" OnClick="() => cardOpen = false" />
                </div>
                <span>Route 9 Bridge · 14 ft × 8 ft</span>
                <span>Poured 11/10 · stripped 11/11</span>
            </div>
        </NxPopup>
    </div>
    @* /code *@
    <DocExampleCode Key="details-card" />
</div>

<div class="doc-section">
    <h2>Hover Card</h2>
    <p class="doc-note">
        <code>OpenOnHover</code>: rest the pointer on a job and its card opens; move onto the card and it stays, so the link
        in it can be used; leave both and it closes. One popup serves every job: <code>AnchorSelector</code> matches them
        all, and <code>OnOpening</code> says which one by its <code>data-nx-context</code>. From the keyboard, Tab to a job,
        press <kbd class="doc-kbd">↓</kbd> to go into the card and <kbd class="doc-kbd">Esc</kbd> to come back. An
        <code>NxTooltip</code> cannot do this: it ignores the pointer.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-jobs" id="hover-jobs">
            @foreach (var job in Jobs)
            {
                <div class="demo-job" id="@($"job-{job.Number}")" data-nx-context="@job.Number" tabindex="0" style="--demo-job: @job.Color">
                    <strong>@job.Number</strong><span>@job.Name</span>
                </div>
            }
        </div>
        <NxPopup Id="hover-card" @bind-Visible="hoverOpen" AnchorSelector=".demo-job" OpenOnHover="true" OnOpening="e => hovered = Jobs.FirstOrDefault(j => j.Number == e.Context)"
                 Width="280px" AriaLabel="@($"Job {hovered?.Number}")">
            @if (hovered is not null)
            {
                <div class="demo-popup-body demo-job-card">
                    <strong>@hovered.Number · @hovered.Name</strong>
                    <span>@hovered.Customer</span>
                    <span>@hovered.Pieces pieces · ships @hovered.Ships</span>
                    <a id="hover-link" href="gantt/overview">Open job @hovered.Number →</a>
                </div>
            }
        </NxPopup>
        <div class="demo-row"><span class="demo-value" id="hover-state">@(hoverOpen ? $"Showing {hovered?.Number}" : "Rest the pointer on a job")</span></div>
    </div>
    <DocCode Code="@hoverCode" />
</div>

<div class="doc-section">
    <h2>Loaded on Open</h2>
    <p class="doc-note">
        A popup renders nothing while it is closed, so a component inside it starts only when it shows. Here each of 120
        pieces has a history, and none is loaded with the page: the card's content runs its query as the card opens, for
        that one piece. <code>@@key</code> starts it again for the next piece, and a slow answer for the last one never
        lands in the new card. Watch the query count.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-pieces" id="lazy-pieces">
            @foreach (var piece in PieceIds)
            {
                <span class="demo-piece" id="@($"piece-{piece}")" data-nx-context="@piece" tabindex="0">@piece</span>
            }
        </div>
        <NxPopup Id="lazy-card" @bind-Visible="lazyOpen" AnchorSelector=".demo-piece" OpenOnHover="true" OnOpening="e => lazyPiece = e.Context"
                 Width="250px" AriaLabel="@($"History of {lazyPiece}")">
            @if (lazyPiece is not null)
            {
                <div class="demo-popup-body">
                    <strong>@lazyPiece</strong>
                    <DemoPieceHistory @key="lazyPiece" PieceId="@lazyPiece" OnQuery="id => { queries++; lastQuery = id; }" />
                </div>
            }
        </NxPopup>
        <div class="demo-row">
            <span class="demo-counter" id="lazy-queries">Queries run: @queries of 120</span>
            <span class="demo-value" id="lazy-last">@(lastQuery is null ? "Rest the pointer on a piece" : $"Last query: {lastQuery}")</span>
        </div>
    </div>
    <DocCode Code="@lazyCode" />
</div>

<DocPager Slug="popup" Page="examples" />

@code {
    static readonly string[] Mixes = ["5000 psi", "6000 psi", "SCC", "Lightweight", "Grout", "Flowable fill"];
    static readonly RenderFragment CloseIcon = @<NxIcon Icon="NxIcons.X" />;
    sealed record Job(string Number, string Name, string Customer, int Pieces, string Ships, string Color);

    static readonly Job[] Jobs =
    [
        new("55104", "Route 9 Bridge", "Acme Site Development", 48, "Dec 4", "#2e6db4"),
        new("55117", "Riverside Garage", "Baldwin Paving", 212, "Dec 11", "#1e8c8c"),
        new("55123", "Harbor Seawall", "Cape Cod Marine Works", 36, "Dec 18", "#d97a1e"),
        new("55130", "Mill St Culvert", "Brookside Utilities", 9, "Jan 6", "#7a4fb5"),
    ];

    bool hoverOpen;
    Job? hovered;

    static IEnumerable<string> PieceIds => Enumerable.Range(1, 120).Select(i => $"WP-{i:000}");
    bool lazyOpen;
    string? lazyPiece, lastQuery;
    int queries;

    const string lazyCode =
        """
        <NxPopup @bind-Visible="open" AnchorSelector=".piece" OpenOnHover="true" OnOpening="e => pieceId = e.Context">
            <PieceHistory @key="pieceId" PieceId="@pieceId" />
        </NxPopup>

        @* PieceHistory.razor: it only exists while the popup is open *@
        @if (events is null) { <NxLoader /> } else { … }

        @code {
            [Parameter] public string PieceId { get; set; } = "";
            protected override async Task OnInitializedAsync() => events = await db.HistoryOfAsync(PieceId);
        }
        """;

    const string hoverCode =
        """
        @foreach (var job in jobs)
        {
            <div class="job" data-nx-context="@job.Number" tabindex="0">@job.Number</div>
        }

        <NxPopup @bind-Visible="open" AnchorSelector=".job" OpenOnHover="true"
                 OnOpening="e => hovered = jobs.First(j => j.Number == e.Context)">
            <strong>@hovered.Name</strong>
            <a href="jobs/@hovered.Number">Open job →</a>
        </NxPopup>
        """;

    bool filterOpen, cardOpen;
    string? search;
    string sortText = "Unsorted";
    HashSet<string> chosen = [.. Mixes];
    NxPopupPlacement? shown;
    NxPopupAlign alignment;

    void Toggle(string mix, bool on)
    {
        if (on) chosen.Add(mix);
        else chosen.Remove(mix);
    }

    void Sort(bool descending)
    {
        sortText = descending ? "Z to A" : "A to Z";
        filterOpen = false;
    }

    void Show(NxPopupPlacement placement) => shown = shown == placement ? null : placement;
}
