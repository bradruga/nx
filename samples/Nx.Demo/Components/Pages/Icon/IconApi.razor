<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Icon</td><td>NxIconData</td><td>—</td><td>The drawing: a member of <code>NxIcons</code>, or your own.</td></tr>
                <tr><td>Size</td><td>NxIconSize</td><td>Medium</td><td>XSmall 12, Small 14, Medium 16, Large 20, XLarge 24, XXLarge 32, XXXLarge 48 px.</td></tr>
                <tr><td>Color</td><td>NxIconColor</td><td>Inherit</td><td>Inherit (text color), Primary, Success, Warning, Danger, Muted.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>—</td><td>Names the icon (<code>role="img"</code>); without it the icon is <code>aria-hidden</code>.</td></tr>
                <tr><td>Title</td><td>string?</td><td>—</td><td>A native tooltip (SVG <code>&lt;title&gt;</code>).</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the <code>&lt;svg&gt;</code>; other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>NxIconData &amp; NxIcons</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>new NxIconData(Name, Content)</td><td>record</td><td>Content is the SVG markup inside <code>&lt;svg&gt;</code>; Name renders as <code>data-icon</code>.</td></tr>
                <tr><td>ViewBox</td><td>string</td><td><code>0 0 24 24</code> by default.</td></tr>
                <tr><td>Filled</td><td>bool</td><td>Paint with <code>fill</code> instead of a 2-unit stroke.</td></tr>
                <tr><td>NxIcons.{Name}</td><td>NxIconData</td><td>The built-in icons, one property each.</td></tr>
                <tr><td>NxIcons.All</td><td>IReadOnlyDictionary&lt;string, NxIconData&gt;</td><td>Every built-in icon by name.</td></tr>
            </tbody>
        </table>
    </div>
</div>

