            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Data</td><td>IEnumerable&lt;TItem&gt;?</td><td>—</td><td>The items, one slide each.</td></tr>
                <tr><td>Template</td><td>RenderFragment&lt;TItem&gt;?</td><td>the item's text</td><td>Renders a slide.</td></tr>
                <tr><td>Page</td><td>int</td><td>1</td><td>The slide shown, from 1. Use <code>@@bind-Page</code>.</td></tr>
                <tr><td>AutomaticPageChange</td><td>bool</td><td>true</td><td>Moves on by itself.</td></tr>
                <tr><td>AutomaticPageChangeInterval</td><td>int</td><td>5000</td><td>Milliseconds per slide (at least 500).</td></tr>
                <tr><td>Arrows</td><td>bool</td><td>true</td><td>Previous / next buttons over the sides.</td></tr>
                <tr><td>Pageable</td><td>bool</td><td>true</td><td>A dot per slide.</td></tr>
                <tr><td>ShowPauseButton</td><td>bool?</td><td>with the dots</td><td>A stop / start button for the rotation.</td></tr>
                <tr><td>Width / Height</td><td>string?</td><td>100% / 320px</td><td>CSS sizes.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>"Carousel"</td><td>The region's accessible name.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>On the outer element; other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

