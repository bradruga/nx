@page "/carousel/examples"

<DocHeader Slug="carousel" Page="examples" />

<div class="doc-section">
    <h2>A Lobby Screen</h2>
    <p class="doc-note">
        ERP's lobby and break room screens hide the arrows and dots (<code>Arrows="false"</code>, <code>Pageable="false"</code>)
        and let it rotate every 10 seconds; nobody touches a TV. Without dots there is no pause button either.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxCarousel Id="lobby-carousel" Data="DemoSlides.Projects" Height="240px" Arrows="false" Pageable="false"
                    AutomaticPageChangeInterval="10000" AriaLabel="Lobby pictures">
            <Template><DemoSlideView Slide="context" ShowCaption="false" /></Template>
        </NxCarousel>
    </div>
    @* /code *@
    <DocExampleCode Key="a-lobby-screen" />
</div>

<div class="doc-section">
    <h2>Stopping the Rotation</h2>
    <p class="doc-note">
        The spotlight stops rotating while a picture is open in a viewer: bind <code>AutomaticPageChange</code> to that state.
        Click a slide to open it here.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxCarousel Id="spotlight-carousel" Data="DemoSlides.Projects" Height="240px" AutomaticPageChangeInterval="4000"
                    AutomaticPageChange="!viewerOpen" AriaLabel="Spotlight">
            <Template>
                <button type="button" class="demo-slide-button" aria-label="@($"Open {context.Project}")" @onclick="() => Open(context)">
                    <DemoSlideView Slide="context" />
                </button>
            </Template>
        </NxCarousel>
        <div class="demo-row">
            <span class="demo-value" id="spotlight-state">@(viewerOpen ? $"Viewing {opened?.Project} — rotation stopped" : "Rotating every 4 s")</span>
            @if (viewerOpen)
            {
                <NxButton id="spotlight-close" Size="NxSize.Small" OnClick="() => viewerOpen = false">Close viewer</NxButton>
            }
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="stopping-the-rotation" />
</div>

<div class="doc-section">
    <h2>From Code</h2>
    <p class="doc-note"><code>@@bind-Page</code> moves it from outside; <code>NextAsync</code> and <code>PreviousAsync</code> step it.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxCarousel @ref="stepper" Id="code-carousel" Data="DemoSlides.Projects" Height="200px" AutomaticPageChange="false"
                    Arrows="false" @bind-Page="codePage" AriaLabel="Projects">
            <Template><DemoSlideView Slide="context" /></Template>
        </NxCarousel>
        <div class="demo-row">
            <NxButton id="code-prev" Size="NxSize.Small" OnClick="() => stepper!.PreviousAsync()">Previous</NxButton>
            <NxButton id="code-next" Size="NxSize.Small" OnClick="() => stepper!.NextAsync()">Next</NxButton>
            <NxButton id="code-last" Size="NxSize.Small" OnClick="() => codePage = DemoSlides.Projects.Count">Last</NxButton>
            <span class="demo-value" id="code-page">Page <strong>@codePage</strong></span>
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="from-code" />
</div>

<div class="doc-section">
    <h2>Any Content</h2>
    <p class="doc-note">A slide is any markup: here this week's numbers, one card at a time.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxCarousel Id="stats-carousel" Data="Stats" Height="160px" AutomaticPageChangeInterval="5000" AriaLabel="This week">
            <Template>
                <div class="demo-stat-slide">
                    <span class="demo-stat-number">@context.Number</span>
                    <span>@context.Label</span>
                </div>
            </Template>
        </NxCarousel>
    </div>
    @* /code *@
    <DocExampleCode Key="any-content" />
</div>

<DocPager Slug="carousel" Page="examples" />

@code {
    static readonly (string Number, string Label)[] Stats =
    [
        ("214", "pieces poured this week"), ("38", "loads shipped"), ("0", "lost-time incidents"), ("96%", "on-time deliveries"),
    ];

    NxCarousel<DemoSlide>? stepper;
    DemoSlide? opened;
    bool viewerOpen;
    int codePage = 1;

    void Open(DemoSlide slide)
    {
        opened = slide;
        viewerOpen = true;
    }
}
