@page "/signature/api"

<DocHeader Slug="signature" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Value</td><td>string?</td><td>—</td><td>The signature as a PNG data URL; <code>null</code> when empty. Use <code>@@bind-Value</code>.</td></tr>
                <tr><td>Width / Height</td><td>string</td><td>300px / 150px</td><td>The pad's size.</td></tr>
                <tr><td>StrokeWidth</td><td>double</td><td>2</td><td>The pen, in pixels.</td></tr>
                <tr><td>Color</td><td>string</td><td>#000000</td><td>The ink, saved in the image.</td></tr>
                <tr><td>BackgroundColor</td><td>string</td><td>#ffffff</td><td>The paper, saved in the image.</td></tr>
                <tr><td>ExportScale</td><td>double</td><td>2</td><td>The saved image's size over the pad's.</td></tr>
                <tr><td>Placeholder</td><td>string?</td><td>Sign here</td><td>On the empty pad, above the guide line.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>Greyed out; no signing or clearing.</td></tr>
                <tr><td>ReadOnly</td><td>bool</td><td>false</td><td>Shows the signature; no changes.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>Signature</td><td>The pad's accessible name.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the outer element; other attributes go there too.</td></tr>
                <tr><td>ValueExpression</td><td>Expression?</td><td>—</td><td><code>EditForm</code> validation; set by <code>@@bind-Value</code>.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ValueChanged</td><td>EventCallback&lt;string?&gt;</td><td>When a stroke ends; <code>null</code> when cleared.</td></tr>
                <tr><td>ClearAsync()</td><td>Task</td><td>Clears the pad and raises <code>ValueChanged</code> with <code>null</code>.</td></tr>
            </tbody>
        </table>
    </div>
</div>

