            <tbody>
                <tr><td>--nx-signature-paper</td><td>#ffffff</td><td>Behind the canvas while it loads.</td></tr>
                <tr><td>--nx-signature-guide</td><td>#9a9aa6</td><td>The guide line and placeholder (not saved).</td></tr>
                <tr><td>--nx-signature-control / -hover / -hover-bg</td><td>#5f6b73 / #1f1f23 / 6% black</td><td>The clear button on the paper.</td></tr>
            </tbody>
        </table>
    </div>
</div>

