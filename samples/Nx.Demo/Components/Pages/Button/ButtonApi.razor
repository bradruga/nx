            <tbody>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>The label.</td></tr>
                <tr><td>Variant</td><td>NxButtonVariant</td><td>Secondary</td><td>Primary, Secondary, Danger, Ghost, Link, Success, Warning, Info.</td></tr>
                <tr><td>Size</td><td>NxButtonSize</td><td>Medium</td><td>Small, Medium, Large.</td></tr>
