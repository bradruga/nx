                <tr><td>AutoLoading</td><td>bool</td><td>false</td><td>Show the loading state while OnClick runs.</td></tr>
                <tr><td>FullWidth</td><td>bool</td><td>false</td><td>Stretch to the container.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>—</td><td>Accessible name.</td></tr>
                <tr><td>Title</td><td>string?</td><td>—</td><td>Tooltip.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>Extra class and inline style on the button.</td></tr>
                <tr><td>(other attributes)</td><td>—</td><td>—</td><td><code>id</code>, <code>form</code>, <code>aria-*</code>, <code>data-*</code> pass through to the button.</td></tr>
