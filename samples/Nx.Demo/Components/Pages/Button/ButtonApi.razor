                <tr><td>Icon</td><td>RenderFragment?</td><td>—</td><td>Icon markup. Icon-only when there is no label.</td></tr>
                <tr><td>IconPosition</td><td>NxIconPosition</td><td>Start</td><td>Start or End.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>Native disabled.</td></tr>
                <tr><td>Loading</td><td>bool</td><td>false</td><td>Spinner; blocks clicks and submission; stays focusable.</td></tr>
