@page "/button/playground"

<DocHeader Slug="button" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live. The code below the preview follows your settings.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner @(pgFullWidth ? "demo-preview-inner-stretch" : "")">
                <NxButton id="playground-button"
                          Variant="pgVariant"
                          Size="pgSize"
                          Type="pgType"
                          Disabled="pgDisabled"
                          Loading="pgLoading"
                          LoadingText="@(string.IsNullOrWhiteSpace(pgLoadingText) ? null : pgLoadingText)"
                          FullWidth="pgFullWidth"
                          Class="@(string.IsNullOrWhiteSpace(pgClass) ? null : pgClass)"
                          Style="@(string.IsNullOrWhiteSpace(pgStyle) ? null : pgStyle)"
                          PreventDoubleClick="pgPreventDoubleClick"
                          AutoLoading="pgAutoLoading"
                          MinimumLoadingTime="pgMinLoading"
                          IconPosition="pgIconPosition"
                          Icon="@(pgIcon ? IconFragment(pgIconName) : null)"
                          AriaLabel="@(pgIconOnly ? pgLabel : null)"
                          Title="@(pgIconOnly ? pgLabel : null)"
                          ChildContent="@(pgIconOnly ? null : Text(pgLabel))"
                          OnClick="PlaygroundClick" />
            </div>
            <div class="demo-row">
                <span class="demo-counter" id="playground-clicks">Clicks handled: @pgClicks</span>
            </div>
        </div>

        <div class="demo-controls" style="max-height: none">
            <div class="demo-controls-title">Appearance</div>
            <div class="demo-control">
                <span>Variant</span>
                <NxDropDown Id="pg-variant" Data="Enum.GetValues<NxButtonVariant>()" @bind-Value="pgVariant" aria-label="Variant" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>Size</span>
                <NxToggleGroup Data="Enum.GetValues<NxButtonSize>()" @bind-Value="pgSize" Size="NxSize.Small" AriaLabel="Size" />
            </div>
            <div class="demo-control">
                <span>Label</span>
                <NxTextBox @bind-Value="pgLabel" Immediate="true" aria-label="Label" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>FullWidth</span>
                <NxCheckBox @bind-Value="pgFullWidth" aria-label="FullWidth" />
            </div>
            <div class="demo-control">
                <span>Class</span>
                <NxTextBox Id="pg-class" @bind-Value="pgClass" Immediate="true" Placeholder="(none)" aria-label="Class" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>Style</span>
                <NxTextBox Id="pg-style" @bind-Value="pgStyle" Immediate="true" Placeholder="(none)" aria-label="Style" Style="@FieldWidth" />
            </div>

            <div class="demo-controls-title">Icon</div>
            <div class="demo-control">
                <span>Icon</span>
                <NxCheckBox Id="pg-icon" @bind-Value="pgIcon" aria-label="Icon" />
            </div>
            <div class="demo-control">
                <span>Glyph</span>
                <NxDropDown Data="iconNames" @bind-Value="pgIconName" Disabled="!pgIcon" aria-label="Glyph" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>IconPosition</span>
                <NxToggleGroup Data="Enum.GetValues<NxIconPosition>()" @bind-Value="pgIconPosition" Size="NxSize.Small" AriaLabel="Icon position" />
            </div>
            <div class="demo-control">
                <span>Icon only</span>
                <NxCheckBox Id="pg-icon-only" @bind-Value="pgIconOnly" @bind-Value:after="AfterIconOnly" aria-label="Icon only" />
            </div>

            <div class="demo-controls-title">State</div>
            <div class="demo-control">
                <span>Disabled</span>
                <NxCheckBox Id="pg-disabled" @bind-Value="pgDisabled" aria-label="Disabled" />
            </div>
            <div class="demo-control">
                <span>Loading</span>
                <NxCheckBox Id="pg-loading" @bind-Value="pgLoading" aria-label="Loading" />
            </div>
            <div class="demo-control">
                <span>LoadingText</span>
                <NxTextBox @bind-Value="pgLoadingText" Immediate="true" Placeholder="(none)" aria-label="LoadingText" Style="@FieldWidth" />
            </div>

            <div class="demo-controls-title">Behavior</div>
            <div class="demo-control">
                <span>Type</span>
                <NxDropDown Data="Enum.GetValues<NxButtonType>()" @bind-Value="pgType" aria-label="Type" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>PreventDoubleClick</span>
                <NxCheckBox @bind-Value="pgPreventDoubleClick" aria-label="PreventDoubleClick" />
            </div>
            <div class="demo-control">
                <span>AutoLoading</span>
                <NxCheckBox Id="pg-auto-loading" @bind-Value="pgAutoLoading" aria-label="AutoLoading" />
            </div>
            <div class="demo-control">
                <span>MinimumLoadingTime</span>
                <NxNumericTextBox Id="pg-min-loading" @bind-Value="pgMinLoading" Min="0" Step="250" Disabled="!pgAutoLoading" aria-label="MinimumLoadingTime" Style="@FieldWidth" />
            </div>
            <div class="demo-control">
                <span>Handler delay (ms)</span>
                <NxNumericTextBox @bind-Value="pgDelay" Min="0" Step="250" aria-label="Handler delay" Style="@FieldWidth" />
            </div>
            <NxButton id="pg-reset" Size="NxButtonSize.Small" Icon="@IconFragment("refresh")" OnClick="ResetDefaults">Reset to defaults</NxButton>
        </div>

        <div class="demo-playground-code">
            <DocCode Code="@PlaygroundCode" />
        </div>
    </div>
    <EventLog @ref="playgroundLog" Label="Playground clicks" EmptyText="Click the playground button." />
</div>

<DocPager Slug="button" Page="playground" />

@code {
    // ── Playground ─────────────────────────────────────────────────────────────
    NxButtonVariant pgVariant;
    NxButtonSize pgSize;
    NxButtonType pgType;
    NxIconPosition pgIconPosition;
    string pgLabel = "";
    string pgLoadingText = "";
    string pgClass = "";
    string pgStyle = "";
    string pgIconName = "";
    bool pgIcon;
    bool pgIconOnly;
    bool pgDisabled;
    bool pgLoading;
    bool pgFullWidth;
    bool pgPreventDoubleClick;
    bool pgAutoLoading;
    int pgMinLoading;
    int pgDelay;
    int pgClicks;
    EventLog? playgroundLog;

    protected override void OnInitialized() => ResetDefaults();

    void ResetDefaults()
    {
        pgVariant = NxButtonVariant.Primary;
        pgSize = NxButtonSize.Medium;
        pgType = NxButtonType.Button;
        pgIconPosition = NxIconPosition.Start;
        pgLabel = "Save changes";
        pgLoadingText = "";
        pgClass = "";
        pgStyle = "";
        pgIconName = "save";
        pgIcon = true;
        pgIconOnly = false;
        pgDisabled = false;
        pgLoading = false;
        pgFullWidth = false;
        pgPreventDoubleClick = true;
        pgAutoLoading = false;
        pgMinLoading = 1000;
        pgDelay = 1000;
    }

    const string FieldWidth = "width: 130px";
    static readonly string[] iconNames = ["save", "plus", "download", "trash", "edit", "arrow-right", "settings", "refresh", "check"];

    static RenderFragment IconFragment(string name) => @<DemoIcon Name="@name" />;
    static RenderFragment Text(string text) => @<text>@text</text>;

    void AfterIconOnly()
    {
        if (pgIconOnly)
            pgIcon = true;
    }

    async Task PlaygroundClick()
    {
        pgClicks++;
        playgroundLog?.Add($"OnClick #{pgClicks} started");
        if (pgDelay > 0)
            await Task.Delay(pgDelay);
        playgroundLog?.Add($"OnClick #{pgClicks} finished");
    }

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string>();
            if (pgVariant != NxButtonVariant.Secondary) attrs.Add($"Variant=\"NxButtonVariant.{pgVariant}\"");
            if (pgSize != NxButtonSize.Medium) attrs.Add($"Size=\"NxButtonSize.{pgSize}\"");
            if (pgType != NxButtonType.Button) attrs.Add($"Type=\"NxButtonType.{pgType}\"");
            if (pgIcon) attrs.Add($"Icon=\"@{IconField}\"");
            if (pgIcon && pgIconPosition != NxIconPosition.Start && !pgIconOnly) attrs.Add("IconPosition=\"NxIconPosition.End\"");
            if (pgIconOnly) attrs.Add($"AriaLabel=\"{pgLabel}\"");
            if (pgDisabled) attrs.Add("Disabled=\"true\"");
            if (pgLoading) attrs.Add("Loading=\"@saving\"");
            if (!string.IsNullOrWhiteSpace(pgLoadingText)) attrs.Add($"LoadingText=\"{pgLoadingText}\"");
            if (pgFullWidth) attrs.Add("FullWidth=\"true\"");
            if (!string.IsNullOrWhiteSpace(pgClass)) attrs.Add($"Class=\"{pgClass}\"");
            if (!string.IsNullOrWhiteSpace(pgStyle)) attrs.Add($"Style=\"{pgStyle}\"");
            if (!pgPreventDoubleClick) attrs.Add("PreventDoubleClick=\"false\"");
            if (pgAutoLoading) attrs.Add("AutoLoading=\"true\"");
            if (pgAutoLoading && pgMinLoading != 1000) attrs.Add($"MinimumLoadingTime=\"{pgMinLoading}\"");
            attrs.Add("OnClick=\"SaveAsync\"");

            var open = "<NxButton " + string.Join("\n          ", attrs);
            var button = pgIconOnly ? $"{open} />" : $"{open}>\n    {pgLabel}\n</NxButton>";
            return pgIcon
                ? $"{button}\n\n@code {{\n    RenderFragment {IconField} = @<svg>…</svg>;\n}}"
                : button;
        }
    }

    // "arrow-right" → "arrowRightIcon"
    string IconField => string.Concat(pgIconName.Split('-').Select((p, i) => i == 0 ? p : char.ToUpperInvariant(p[0]) + p[1..])) + "Icon";
}
