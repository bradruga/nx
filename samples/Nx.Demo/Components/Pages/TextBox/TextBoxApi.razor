                <tr><td>Prefix / Suffix</td><td>RenderFragment?</td><td>—</td><td>Content inside the field before / after the text.</td></tr>
                <tr><td>Type</td><td>NxTextBoxType</td><td>Text</td><td>Text, Password, Email, Search, Tel, Url.</td></tr>
                <tr><td>InputMode</td><td>NxInputMode?</td><td>null</td><td>On-screen keyboard hint.</td></tr>
                <tr><td>AutoComplete</td><td>string?</td><td>—</td><td>The autocomplete attribute.</td></tr>
