            <tbody>
                <tr><td>Value</td><td>string?</td><td>—</td><td>Use <code>@@bind-Value</code>.</td></tr>
                <tr><td>Immediate</td><td>bool</td><td>false</td><td>Update while typing instead of on change.</td></tr>
                <tr><td>DebounceDelay</td><td>int (ms)</td><td>0</td><td>With Immediate, wait for a pause in typing.</td></tr>
                <tr><td>Label</td><td>string?</td><td>—</td><td>Label text.</td></tr>
