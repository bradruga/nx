                <tr><td>ShowCounter</td><td>bool</td><td>false</td><td>Show a length / limit counter.</td></tr>
                <tr><td>Clearable</td><td>bool</td><td>false</td><td>Clear button; Esc clears.</td></tr>
                <tr><td>ShowPasswordToggle</td><td>bool</td><td>true</td><td>Reveal button on password fields.</td></tr>
                <tr><td>ReadOnly / Disabled</td><td>bool</td><td>false</td><td>Native readonly / disabled.</td></tr>
                <tr><td>AutoFocus</td><td>bool</td><td>false</td><td>Focus after first render.</td></tr>
                <tr><td>Id</td><td>string?</td><td>generated</td><td>The input id.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the outer element. Other attributes go to the input.</td></tr>
