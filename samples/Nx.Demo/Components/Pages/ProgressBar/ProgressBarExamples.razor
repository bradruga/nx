@page "/progressbar/examples"
@implements IDisposable

<DocHeader Slug="progressbar" Page="examples" />

<div class="doc-section">
    <h2>Value Out of Max</h2>
    <p class="doc-note">With <code>Max</code> the value is a count — chunks, slides, rows. The label is still the percentage.</p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <NxProgressBar id="count-bar" Value="processed" Max="Chunks" AriaLabel="Transcript" />
        <div class="demo-row">
            <NxButton id="count-start" Size="NxButtonSize.Small" Variant="NxButtonVariant.Primary" OnClick="ProcessAsync" Disabled="running">Process transcript</NxButton>
            <span class="demo-value" id="count-value">@processed of @Chunks chunks</span>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Label Template</h2>
    <p class="doc-note">
        <code>LabelTemplate</code> gets the value, max and percentage as <code>context</code>, and whether it is complete.
    </p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <NxProgressBar id="template-bar" Value="processed" Max="Chunks" AriaLabel="Transcript">
            <LabelTemplate>
                @if (context.IsComplete)
                {
                    <span>Processing transcript complete.</span>
                }
                else
                {
                    <span>Processing transcript… @context.Percent.ToString("0")%</span>
                }
            </LabelTemplate>
        </NxProgressBar>
    </div>
</div>

<div class="doc-section">
    <h2>Thin</h2>
    <p class="doc-note">A slim bar with no label, e.g. how far through a form's slides you are.</p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <div class="demo-row demo-row-spread" style="max-width:none"><strong>Safety briefing</strong><span id="thin-step">Slide @slide of @Slides</span></div>
        <NxProgressBar id="thin-bar" Value="slide" Max="Slides" Thin="true" AriaLabel="Slides" />
        <NxButtonGroup AriaLabel="Slides" Size="NxButtonSize.Small">
            <NxButton id="thin-back" Disabled="slide <= 1" OnClick="() => slide--">Back</NxButton>
            <NxButton id="thin-next" Disabled="slide >= Slides" OnClick="() => slide++">Next</NxButton>
        </NxButtonGroup>
    </div>
</div>

<div class="doc-section">
    <h2>Indeterminate</h2>
    <p class="doc-note">For work whose size is unknown — waiting for a server, say.</p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <NxProgressBar id="indeterminate-bar" Indeterminate="true" AriaLabel="Connecting" />
        <NxProgressBar Indeterminate="true" Thin="true" AriaLabel="Loading" />
    </div>
</div>

<div class="doc-section">
    <h2>Colors &amp; Height</h2>
    <p class="doc-note">Tokens on the bar or any container: <code>--nx-progressbar-fill</code>, <code>-track</code>, <code>-height</code>, <code>-radius</code>.</p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <NxProgressBar Value="92" AriaLabel="Budget" Style="--nx-progressbar-fill: var(--nx-danger)" />
        <NxProgressBar Value="55" AriaLabel="Cure" Style="--nx-progressbar-fill: var(--nx-success); --nx-progressbar-height: 28px; --nx-progressbar-radius: 4px" />
    </div>
</div>

<DocPager Slug="progressbar" Page="examples" />

@code {
    const int Chunks = 8, Slides = 6;
    int processed = 3, slide = 2;
    bool running, disposed;

    async Task ProcessAsync()
    {
        running = true;
        processed = 0;
        while (processed < Chunks && !disposed)
        {
            await Task.Delay(250);
            processed++;
            StateHasChanged();
        }
        running = false;
    }

    public void Dispose() => disposed = true;
}
