@page "/slider/examples"
@using System.ComponentModel.DataAnnotations

<DocHeader Slug="slider" Page="examples" />

<div class="doc-section">
    <h2>Ticks, Buttons &amp; Value</h2>
    <p class="doc-note">
        <code>LargeStep</code> puts a labelled tick every so many; <code>ShowButtons</code> adds − and +; <code>ShowValue</code>
        prints the value at the end, through <code>Format</code>.
    </p>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <NxSlider TValue="int" Id="ticks-slider" Label="Pour sequence" Min="1" Max="12" LargeStep="1" @bind-Value="sequence" />
        <NxSlider TValue="int" Id="buttons-slider" Label="Trucks" Min="0" Max="8" ShowButtons="true" ShowValue="true" @bind-Value="trucks" />
        <NxSlider TValue="decimal" Id="percent-slider" Label="Retainage" Min="0m" Max="0.1m" SmallStep="0.005m" LargeStep="0.025m"
                  Format="P1" ShowValue="true" @bind-Value="retainage" />
    </div>
</div>

<div class="doc-section">
    <h2>While Dragging or on Release</h2>
    <p class="doc-note">
        By default <code>ValueChanged</code> fires as the thumb moves. With <code>Immediate="false"</code> it fires once, when the
        thumb is let go — for a value that saves or reloads something.
    </p>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <NxSlider TValue="int" Id="live-slider" Label="Live" Min="0" Max="100" LargeStep="25" @bind-Value="live" @bind-Value:after="() => liveCount++" />
        <NxSlider TValue="int" Id="release-slider" Label="On release" Min="0" Max="100" LargeStep="25" Immediate="false"
                  @bind-Value="released" @bind-Value:after="() => releaseCount++" />
        <div class="demo-row">
            <span class="demo-counter" id="live-count">Live × @liveCount</span>
            <span class="demo-counter" id="release-count">On release × @releaseCount</span>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>A Synchronized Value</h2>
    <p class="doc-note">
        ERP's pub/sub demo broadcasts a slider's value to other pages; here two sliders share one field, so moving either moves the
        other — an outside change always wins over what the thumb shows.
    </p>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <NxSlider TValue="int" Id="sync-a" Label="This page" Min="0" Max="10" LargeStep="5" @bind-Value="shared" />
        <NxSlider TValue="int" Id="sync-b" Label="Another subscriber" Min="0" Max="10" LargeStep="5" @bind-Value="shared" />
    </div>
</div>

<div class="doc-section">
    <h2>Validation &amp; Disabled</h2>
    <p class="doc-note">In an <code>EditForm</code> the slider takes the field's valid / invalid state and turns red when invalid.</p>
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <EditForm id="slider-form" Model="mix" OnValidSubmit="() => result = Saved()" FormName="slider-form">
            <DataAnnotationsValidator />
            <NxSlider TValue="int" Id="slump-slider" Label="Slump (in)" Min="0" Max="10" LargeStep="2" ShowValue="true" @bind-Value="mix.Slump" />
            <NxValidationMessage For="() => mix.Slump" />
            <div class="demo-row" style="margin-top:16px">
                <NxButton id="slider-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Save mix</NxButton>
                <span class="demo-value" id="slider-result">@result</span>
            </div>
        </EditForm>
        <NxSlider TValue="int" Id="disabled-slider" Label="Disabled" Min="0" Max="10" Value="6" Disabled="true" />
    </div>
</div>

<DocPager Slug="slider" Page="examples" />

@code {
    int sequence = 3, trucks = 2, live = 40, released = 40, liveCount, releaseCount, shared = 5;
    decimal retainage = 0.05m;
    string result = "Not saved";
    readonly MixForm mix = new() { Slump = 9 };

    string Saved() => $"Saved slump {mix.Slump} in";

    class MixForm
    {
        [Range(3, 7, ErrorMessage = "Slump must be 3 to 7 inches.")]
        public int Slump { get; set; }
    }
}
