@page "/tilelayout/api"

<DocHeader Slug="tilelayout" Page="api" />

<div class="doc-section">
    <h2>NxTileLayout</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>The <code>NxTileLayoutItem</code>s.</td></tr>
                <tr><td>Columns</td><td>int</td><td>3</td><td>The number of columns.</td></tr>
                <tr><td>ColumnWidth</td><td>string?</td><td>no limit</td><td>The widest a column grows; columns share the width up to it.</td></tr>
                <tr><td>RowHeight</td><td>string?</td><td>auto</td><td>One row's height. Auto rows fit their content and are not resizable.</td></tr>
                <tr><td>Gap</td><td>string?</td><td>--nx-tilelayout-gap</td><td>Space between tiles.</td></tr>
                <tr><td>Reorderable</td><td>bool</td><td>false</td><td>Drag a tile by its header onto another's place; Ctrl+arrows.</td></tr>
                <tr><td>Resizable</td><td>bool</td><td>false</td><td>A corner handle changes the spans; Shift+arrows.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>—</td><td>The list of tiles' accessible name.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>On the outer element; other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>NxTileLayoutItem</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Id</td><td>string?</td><td>generated</td><td>The tile's key in the state and the events.</td></tr>
                <tr><td>HeaderText / HeaderTemplate</td><td>string? / RenderFragment?</td><td>—</td><td>The header.</td></tr>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>The tile's content; it scrolls inside the tile.</td></tr>
                <tr><td>ColSpan / RowSpan</td><td>int</td><td>1</td><td>The spans; an outside change replaces the user's.</td></tr>
                <tr><td>Visible</td><td>bool</td><td>true</td><td>A hidden tile keeps its place in the order.</td></tr>
                <tr><td>Class</td><td>string?</td><td>—</td><td>On the tile.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>OnReorder</td><td>EventCallback&lt;NxTileReorderEventArgs&gt;</td><td>After a move: <code>Id</code>, <code>OldIndex</code>, <code>NewIndex</code>.</td></tr>
                <tr><td>OnResize</td><td>EventCallback&lt;NxTileResizeEventArgs&gt;</td><td>After a resize: <code>Id</code>, <code>ColSpan</code>, <code>RowSpan</code>.</td></tr>
                <tr><td>GetState()</td><td>NxTileLayoutState</td><td><code>ItemStates</code>: each tile's Id, Order, ColSpan, RowSpan, Visible.</td></tr>
                <tr><td>SetState(state)</td><td>void</td><td>Restores an arrangement; tiles it does not name go after the others.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Variable</th><th>Default</th><th>Used for</th></tr></thead>
            <tbody>
                <tr><td>--nx-tilelayout-gap</td><td>16px</td><td>Space between tiles.</td></tr>
                <tr><td>--nx-tile-bg</td><td>--nx-surface</td><td>A tile's fill.</td></tr>
                <tr><td>--nx-tile-border</td><td>--nx-border</td><td>A tile's border and header rule.</td></tr>
                <tr><td>--nx-tile-shadow</td><td>0 1px 2px rgba(0,0,0,.06)</td><td>A tile's shadow.</td></tr>
            </tbody>
        </table>
    </div>
</div>

