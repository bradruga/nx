@page "/togglebutton/api"

<DocHeader Slug="togglebutton" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Selected</td><td>bool</td><td>false</td><td>On or off. Use <code>@@bind-Selected</code>.</td></tr>
                <tr><td>SelectedChanged</td><td>EventCallback&lt;bool&gt;</td><td></td><td>The new state, on each press.</td></tr>
                <tr><td>ChildContent / Icon / IconPosition</td><td></td><td></td><td>As NxButton; no label makes it icon-only.</td></tr>
                <tr><td>Variant / Size</td><td>NxButtonVariant? / NxButtonSize?</td><td>the group's, else Secondary / Medium</td><td>As NxButton.</td></tr>
                <tr><td>Disabled / FullWidth</td><td>bool</td><td>false</td><td>As NxButton.</td></tr>
                <tr><td>AriaLabel / Title</td><td>string?</td><td>—</td><td>Name (required icon-only) and tooltip.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the button; other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS</h2>
    <p class="doc-note">
        NxButton draws <code>[aria-pressed=true]</code>: outline variants in <code>--nx-accent</code> on <code>--nx-accent-subtle</code>,
        Primary and Danger a shade darker and pressed in.
    </p>
</div>

