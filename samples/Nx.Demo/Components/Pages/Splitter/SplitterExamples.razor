@page "/splitter/examples"

<DocHeader Slug="splitter" Page="examples" />

<div class="doc-section">
    <h2>Stacked</h2>
    <p class="doc-note"><code>Orientation="Vertical"</code> stacks the panes; the bars run across and move with ↑ and ↓.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxSplitter Id="vertical-splitter" Orientation="NxOrientation.Vertical" Style="height: 300px">
            <NxSplitterPane Id="vertical-top" Title="Schedule" @bind-Size="topSize" Min="60px">
                <p>Pour schedule for the week.</p>
            </NxSplitterPane>
            <NxSplitterPane Id="vertical-bottom" Title="Notes">
                <p>Notes for the selected pour.</p>
            </NxSplitterPane>
        </NxSplitter>
        <div class="demo-row"><span class="demo-value" id="vertical-size">Top: <strong>@topSize</strong></span></div>
    </div>
    @* /code *@
    <DocExampleCode Key="stacked" />
</div>

<div class="doc-section">
    <h2>Three Panes, Min &amp; Max</h2>
    <p class="doc-note">
        Sizes take px or %, and a resized pane reports back in its own unit. Here the side panes are 200 px and 25%, the middle
        takes the rest, and each side pane stops at its <code>Min</code> and <code>Max</code>.
    </p>
    <div class="demo-stage demo-stage-column">
        <NxSplitter Id="three-splitter" Style="height: 220px">
            <NxSplitterPane Id="three-left" Title="Folders" @bind-Size="leftSize" Min="120px" Max="320px"><p>Folders</p></NxSplitterPane>
            <NxSplitterPane Id="three-middle" Title="Drawings"><p>Drawings</p></NxSplitterPane>
            <NxSplitterPane Id="three-right" Title="Preview" @bind-Size="rightSize" Min="15%" Max="40%"><p>Preview</p></NxSplitterPane>
        </NxSplitter>
        <div class="demo-row"><span class="demo-value" id="three-size">Left: <strong>@leftSize</strong> · Right: <strong>@rightSize</strong></span></div>
    </div>
    <DocCode Code="@threeCode" />
</div>

<div class="doc-section">
    <h2>Collapsing Panes</h2>
    <p class="doc-note">
        A pane collapses to nothing and back through <code>@@bind-Collapsed</code>; its content is kept and its bar stops
        resizing meanwhile. The splitter draws no button for it: the control is yours, here two toggle buttons in a toolbar.
    </p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <div class="demo-row">
            <NxToggleButton id="toggle-nav" Selected="!navCollapsed" SelectedChanged="on => navCollapsed = !on">Navigation</NxToggleButton>
            <NxToggleButton id="toggle-props" Selected="!propsCollapsed" SelectedChanged="on => propsCollapsed = !on">Properties</NxToggleButton>
            <span class="demo-value" id="collapse-state">Navigation: <strong>@(navCollapsed ? "collapsed" : "open")</strong> · Properties: <strong>@(propsCollapsed ? "collapsed" : "open")</strong></span>
        </div>
        <NxSplitter Id="collapse-splitter" Style="height: 220px">
            <NxSplitterPane Id="collapse-nav" Title="Navigation" Size="200px" @bind-Collapsed="navCollapsed">
                <NxTextBox Id="collapse-filter" Label="Filter (kept while collapsed)" @bind-Value="filter" />
            </NxSplitterPane>
            <NxSplitterPane Id="collapse-main" Title="Editor"><p>Editor</p></NxSplitterPane>
            <NxSplitterPane Id="collapse-props" Title="Properties" Size="180px" @bind-Collapsed="propsCollapsed"><p>Properties</p></NxSplitterPane>
        </NxSplitter>
    </div>
    @* /code *@
    <DocExampleCode Key="collapsing-panes" />
</div>

<div class="doc-section">
    <h2>Tool Windows</h2>
    <p class="doc-note">
        An IDE layout, as VS Code and Rider have: each panel has its own header with a hide button, and the strip down the
        side brings it back. The header, the buttons and the strip are the page's; the splitter only takes
        <code>@@bind-Collapsed</code>, and a hidden panel takes its bar with it.
    </p>
    <div class="demo-stage demo-stage-column">
        <div class="demo-ide" id="ide">
            <div class="demo-ide-stripe" role="toolbar" aria-label="Tool windows">
                <NxToggleButton id="ide-show-explorer" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.Folder)" AriaLabel="Explorer" Title="Explorer"
                                Selected="!explorerHidden" SelectedChanged="on => explorerHidden = !on" />
                <NxToggleButton id="ide-show-structure" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.ListUnordered)" AriaLabel="Structure" Title="Structure"
                                Selected="!structureHidden" SelectedChanged="on => structureHidden = !on" />
                <span class="demo-ide-stripe-end">
                    <NxToggleButton id="ide-show-terminal" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.Rows)" AriaLabel="Terminal" Title="Terminal"
                                    Selected="!terminalHidden" SelectedChanged="on => terminalHidden = !on" />
                </span>
            </div>
            <NxSplitter Id="ide-splitter" Class="demo-ide-main">
                <NxSplitterPane Id="ide-explorer" Title="Explorer" Size="190px" Min="130px" @bind-Collapsed="explorerHidden">
                    <div class="demo-ide-panel">
                        <div class="demo-ide-head">
                            <span>Explorer</span>
                            <NxButton id="ide-hide-explorer" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.Minus)" AriaLabel="Hide Explorer" Title="Hide" OnClick="() => explorerHidden = true" />
                        </div>
                        <ul class="demo-ide-body demo-ide-list">
                            <li>Pours</li><li class="demo-ide-item-active">PourSchedule.razor</li><li>PourService.cs</li><li>Forms</li><li>FormSet.cs</li>
                        </ul>
                    </div>
                </NxSplitterPane>
                <NxSplitterPane Id="ide-center" Title="Editor">
                    <NxSplitter Id="ide-center-splitter" Orientation="NxOrientation.Vertical">
                        <NxSplitterPane Id="ide-editor" Title="Editor" Min="80px">
                            <div class="demo-ide-panel">
                                <div class="demo-ide-head demo-ide-head-tab"><span>PourSchedule.razor</span></div>
                                <pre class="demo-ide-body demo-ide-code">@editorText</pre>
                            </div>
                        </NxSplitterPane>
                        <NxSplitterPane Id="ide-terminal" Title="Terminal" Size="104px" Min="64px" @bind-Collapsed="terminalHidden">
                            <div class="demo-ide-panel">
                                <div class="demo-ide-head">
                                    <span>Terminal</span>
                                    <NxButton id="ide-hide-terminal" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.Minus)" AriaLabel="Hide Terminal" Title="Hide" OnClick="() => terminalHidden = true" />
                                </div>
                                <pre class="demo-ide-body demo-ide-code">@terminalText</pre>
                            </div>
                        </NxSplitterPane>
                    </NxSplitter>
                </NxSplitterPane>
                <NxSplitterPane Id="ide-structure" Title="Structure" Size="170px" Min="120px" @bind-Collapsed="structureHidden">
                    <div class="demo-ide-panel">
                        <div class="demo-ide-head">
                            <span>Structure</span>
                            <NxButton id="ide-hide-structure" Variant="NxButtonVariant.Ghost" Size="NxSize.Small" Icon="@Ico(NxIcons.Minus)" AriaLabel="Hide Structure" Title="Hide" OnClick="() => structureHidden = true" />
                        </div>
                        <ul class="demo-ide-body demo-ide-list">
                            <li>PourSchedule</li><li>OnInitializedAsync()</li><li>Reschedule(Pour)</li><li>SaveAsync()</li>
                        </ul>
                    </div>
                </NxSplitterPane>
            </NxSplitter>
        </div>
        <div class="demo-row">
            <span class="demo-value" id="ide-state">Explorer: <strong>@(explorerHidden ? "hidden" : "shown")</strong> · Terminal: <strong>@(terminalHidden ? "hidden" : "shown")</strong> · Structure: <strong>@(structureHidden ? "hidden" : "shown")</strong></span>
        </div>
    </div>
    <DocCode Code="@ideCode" />
</div>

<div class="doc-section">
    <h2>Nested</h2>
    <p class="doc-note">A pane can hold another splitter: here a list beside a stacked detail and history.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxSplitter Id="nested-splitter" Style="height: 320px">
            <NxSplitterPane Id="nested-list" Title="Orders" Size="30%" Min="140px"><p>Orders</p></NxSplitterPane>
            <NxSplitterPane Id="nested-right" Title="Order">
                <NxSplitter Id="nested-inner" Orientation="NxOrientation.Vertical">
                    <NxSplitterPane Id="nested-detail" Title="Detail" @bind-Size="innerSize" Min="60px"><p>Order detail</p></NxSplitterPane>
                    <NxSplitterPane Id="nested-history" Title="History"><p>Change history</p></NxSplitterPane>
                </NxSplitter>
            </NxSplitterPane>
        </NxSplitter>
        <div class="demo-row"><span class="demo-value" id="nested-size">Detail: <strong>@innerSize</strong></span></div>
    </div>
    @* /code *@
    <DocExampleCode Key="nested" />
</div>

<div class="doc-section">
    <h2>Fixed Panes</h2>
    <p class="doc-note"><code>Resizable="false"</code> keeps a pane's size; its bar shows no grip and takes no drags.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxSplitter Id="fixed-splitter" Style="height: 160px">
            <NxSplitterPane Id="fixed-left" Title="Toolbox" Size="160px" Resizable="false"><p>Fixed 160 px</p></NxSplitterPane>
            <NxSplitterPane Id="fixed-main" Title="Canvas"><p>Canvas</p></NxSplitterPane>
        </NxSplitter>
    </div>
    @* /code *@
    <DocExampleCode Key="fixed-panes" />
</div>

<DocPager Slug="splitter" Page="examples" />

@code {
    string? topSize = "40%", leftSize = "200px", rightSize = "25%", innerSize = "55%";
    bool navCollapsed, propsCollapsed;
    bool explorerHidden, terminalHidden, structureHidden = true;

    static RenderFragment Ico(NxIconData icon) => @<NxIcon Icon="icon" />;

    const string editorText = "<NxGantt Data=\"pours\" OnUpdate=\"Reschedule\">\n    <Columns>\n        <NxGanttColumn Value=\"p => p.Title\" Expandable=\"true\" />\n    </Columns>\n</NxGantt>";
    const string terminalText = "> dotnet build Nx.slnx\n  0 Warning(s)\n  0 Error(s)";

    const string ideCode =
        """
        <NxToggleButton Icon="@folder" AriaLabel="Explorer" Selected="!explorerHidden" SelectedChanged="on => explorerHidden = !on" />

        <NxSplitter>
            <NxSplitterPane Size="190px" Min="130px" @bind-Collapsed="explorerHidden">
                <div class="panel-head">
                    Explorer
                    <NxButton Icon="@minus" AriaLabel="Hide Explorer" OnClick="() => explorerHidden = true" />
                </div>
                …
            </NxSplitterPane>
            <NxSplitterPane>…</NxSplitterPane>
        </NxSplitter>
        """;
    string filter = "";

    const string threeCode =
        """
        <NxSplitter Style="height: 220px">
            <NxSplitterPane @bind-Size="left" Min="120px" Max="320px">…</NxSplitterPane>
            <NxSplitterPane>…</NxSplitterPane>
            <NxSplitterPane @bind-Size="right" Min="15%" Max="40%">…</NxSplitterPane>
        </NxSplitter>
        """;
}
