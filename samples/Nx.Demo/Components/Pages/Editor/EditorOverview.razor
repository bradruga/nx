@page "/editor"
@page "/editor/overview"

<DocHeader Slug="editor" Page="overview" />

<div class="doc-section">
    <h2>What It Is</h2>
    <p class="doc-note">
        <code>NxEditor</code> edits rich text and binds it as HTML: ticket descriptions, comments, email bodies, notes, a
        report template. <code>Tools</code> lists the toolbar in order — text styles, block formats, fonts and colors,
        alignment, lists, links, pictures and tables — and custom tools take a slot of their own. Click a picture to resize
        it by its corners, or drag it to another place in the text. Undo keeps its own history,
        and pasted Word or web content is cleaned of scripts, comments, classes and Office styles, with Word's lists made
        real lists.
    </p>
</div>

<div class="doc-section">
    <h2>Basic Usage</h2>
    <div class="demo-stage demo-stage-column">
        <NxEditor Id="overview-editor" @bind-Value="notes" AriaLabel="Pour notes" Placeholder="Notes for the crew…" Style="width:100%" />
        <span class="demo-value">Value</span>
        <pre class="doc-code demo-editor-html" id="overview-html">@(string.IsNullOrEmpty(notes) ? "\"\"" : notes)</pre>
    </div>
    <pre class="doc-code">@basicCode</pre>
</div>

<div class="doc-section">
    <h2>Keyboard &amp; Accessibility</h2>
    <div class="doc-table-wrap">
        <table class="doc-table">
            <thead><tr><th>Key</th><th>Behavior</th></tr></thead>
            <tbody>
                <tr><td>Ctrl+B / I / U</td><td>Bold, italic, underline.</td></tr>
                <tr><td>Ctrl+Z / Ctrl+Y (Ctrl+Shift+Z)</td><td>Undo and redo; typing is one step until a pause.</td></tr>
                <tr><td>Ctrl+K</td><td>Opens the link dialog (with the <code>CreateLink</code> tool).</td></tr>
                <tr><td>Picture selected</td><td>Delete or Backspace removes it; Escape (or any other key) lets go of it.</td></tr>
                <tr><td>Tab / Shift+Tab</td><td>In a table: next or previous cell, a new row after the last. Elsewhere: leaves the editor.</td></tr>
                <tr><td>Toolbar</td><td>One tab stop; ← → Home End move between its buttons. Lists and color pickers are their own stops.</td></tr>
                <tr><td>Table grid</td><td>Arrows size the table, Enter inserts it, Escape closes.</td></tr>
                <tr><td>Roles</td><td>A multi-line <code>textbox</code> named by <code>AriaLabel</code>; a <code>toolbar</code>; toggles announce pressed.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<DocPager Slug="editor" Page="overview" />

@code {
    string? notes = "<p>Pour <strong>P-14</strong> at 7:00. Check the <em>embeds</em> before the truck arrives.</p>"
        + "<p><img src=\"samples/wall-panel.svg\" alt=\"Wall panel WP-12 elevation\" width=\"240\" height=\"135\"></p>";

    const string basicCode =
        """
        <NxEditor @bind-Value="notes" AriaLabel="Pour notes" Placeholder="Notes for the crew…" />
        """;
}
