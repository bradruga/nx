@page "/colorgradient/api"

<DocHeader Slug="colorgradient" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Value</td><td>string?</td><td>—</td><td>The color. Use <code>@@bind-Value</code>. Hex (3, 4, 6, 8 digits) or rgb() / rgba() in.</td></tr>
                <tr><td>ValueFormat</td><td>NxColorFormat</td><td>Hex</td><td>How the value is written: <code>#rrggbb(aa)</code> or <code>rgb(a)()</code>.</td></tr>
                <tr><td>Format</td><td>NxColorFormat</td><td>Hex</td><td>Which text boxes show first: one HEX box or R, G, B (A) boxes.</td></tr>
                <tr><td>ShowOpacityEditor</td><td>bool</td><td>true</td><td>The opacity slider and an A box; off keeps colors opaque.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>Turns every part off.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>"Color"</td><td>The group's accessible name.</td></tr>
                <tr><td>Id</td><td>string?</td><td>generated</td><td>The outer element's id; the HEX box is <code>{Id}-hex</code>.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the outer element; other attributes go there too.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ValueChanged</td><td>EventCallback&lt;string?&gt;</td><td>While dragging, on each slider step, and when typed text is committed.</td></tr>
                <tr><td>FocusAsync()</td><td>ValueTask</td><td>Focuses the square's thumb.</td></tr>
            </tbody>
        </table>
    </div>
    <p class="doc-note"><code>ValueExpression</code> connects it to an <code>EditForm</code>; <code>@@bind-Value</code> sets it.</p>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Variable</th><th>Default</th><th>Used for</th></tr></thead>
            <tbody>
                <tr><td>--nx-colorgradient-width</td><td>272px</td><td>The component's width (never wider than its container).</td></tr>
                <tr><td>--nx-colorgradient-area-height</td><td>168px</td><td>The square's height.</td></tr>
                <tr><td>--nx-colorgradient-check</td><td>#d4d4da</td><td>The checkerboard behind transparent colors.</td></tr>
            </tbody>
        </table>
    </div>
</div>

