@page "/window/playground"

<DocHeader Slug="window" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live. Changing a parameter while the window is open applies it at once.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner">
                <NxButton id="pg-open" Variant="NxButtonVariant.Primary" OnClick="() => pgVisible = true">Open window</NxButton>
                <NxWindow @key="pgKey" Id="playground-window" @bind-Visible="pgVisible" @bind-Visible:after="Changed"
                          Title="@pgTitle" Icon="@(pgIcon ? Icon : null)" Modal="pgModal"
                          CloseOnEscape="pgEscape" CloseOnBackdropClick="pgBackdrop" Closable="pgClosable"
                          Minimizable="pgMinimizable" Maximizable="pgMaximizable" Draggable="pgDraggable" Resizable="pgResizable"
                          Size="pgSize" Width="@OrNull(pgWidth)" Height="@OrNull(pgHeight)" Left="@OrNull(pgLeft)" Top="@OrNull(pgTop)"
                          Inline="pgInline" OnMoved="e => pgMoved = e" OnResized="e => pgResized = e">
                    <ChildContent>
                        <p>Window body. Tab through the fields; Esc closes when <code>CloseOnEscape</code> is on.</p>
                        <NxTextBox Id="pg-field" Label="A field" @bind-Value="pgText" />
                    </ChildContent>
                    <Footer>
                        @if (pgFooter)
                        {
                            <NxButton id="pg-cancel" OnClick="() => pgVisible = false">Cancel</NxButton>
                            <NxButton id="pg-ok" Variant="NxButtonVariant.Primary" OnClick="() => pgVisible = false">OK</NxButton>
                        }
                    </Footer>
                </NxWindow>
            </div>
            <div class="demo-row">
                <span class="demo-value" id="playground-value">Visible: <strong>@(pgVisible ? "true" : "false")</strong></span>
                <span class="demo-counter" id="playground-changes">VisibleChanged × @pgChanges</span>
                <span class="demo-counter" id="playground-moved">OnMoved: @(pgMoved is null ? "—" : $"{pgMoved.Left}, {pgMoved.Top}")</span>
                <span class="demo-counter" id="playground-resized">OnResized: @(pgResized is null ? "—" : $"{pgResized.Width} × {pgResized.Height}")</span>
            </div>
        </div>

        <div class="demo-controls">
            <div class="demo-controls-title">Behavior</div>
            <label class="demo-control"><span>Modal</span><input type="checkbox" id="pg-modal" @bind="pgModal" /></label>
            <label class="demo-control"><span>CloseOnEscape</span><input type="checkbox" id="pg-escape" @bind="pgEscape" /></label>
            <label class="demo-control"><span>CloseOnBackdropClick</span><input type="checkbox" id="pg-backdrop" @bind="pgBackdrop" /></label>
            <label class="demo-control"><span>Closable</span><input type="checkbox" id="pg-closable" @bind="pgClosable" /></label>
            <label class="demo-control"><span>Draggable</span><input type="checkbox" id="pg-draggable" @bind="pgDraggable" /></label>
            <label class="demo-control"><span>Resizable</span><input type="checkbox" id="pg-resizable" @bind="pgResizable" /></label>
            <label class="demo-control"><span>Inline</span><input type="checkbox" id="pg-inline" @bind="pgInline" /></label>

            <div class="demo-controls-title">Title bar</div>
            <label class="demo-control"><span>Title</span><input type="text" @bind="pgTitle" @bind:event="oninput" /></label>
            <label class="demo-control"><span>Icon</span><input type="checkbox" id="pg-icon" @bind="pgIcon" /></label>
            <label class="demo-control"><span>Minimizable</span><input type="checkbox" id="pg-minimizable" @bind="pgMinimizable" /></label>
            <label class="demo-control"><span>Maximizable</span><input type="checkbox" id="pg-maximizable" @bind="pgMaximizable" /></label>
            <label class="demo-control"><span>Footer</span><input type="checkbox" id="pg-footer" @bind="pgFooter" /></label>

            <div class="demo-controls-title">Size &amp; position (applied on open)</div>
            <label class="demo-control">
                <span>Size</span>
                <select id="pg-size" @bind="pgSize">
                    @foreach (var s in Enum.GetValues<NxWindowSize>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>
            <label class="demo-control"><span>Width</span><input type="text" id="pg-width" placeholder="e.g. 720px" @bind="pgWidth" @bind:after="Remount" /></label>
            <label class="demo-control"><span>Height</span><input type="text" id="pg-height" placeholder="e.g. 50vh" @bind="pgHeight" @bind:after="Remount" /></label>
            <label class="demo-control"><span>Left</span><input type="text" id="pg-left" placeholder="centered" @bind="pgLeft" @bind:after="Remount" /></label>
            <label class="demo-control"><span>Top</span><input type="text" id="pg-top" placeholder="centered" @bind="pgTop" @bind:after="Remount" /></label>
        </div>

        <div class="demo-playground-code">
            <DocCode Code="@PlaygroundCode" />
        </div>
    </div>
</div>

<DocPager Slug="window" Page="playground" />

@code {
    static readonly RenderFragment Icon = @<DemoIcon Name="box" />;
    static string? OrNull(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    bool pgVisible, pgModal = true, pgEscape = true, pgBackdrop, pgClosable = true, pgDraggable = true, pgResizable;
    bool pgIcon = true, pgMinimizable, pgMaximizable, pgFooter = true, pgInline;
    NxWindowMovedEventArgs? pgMoved;
    NxWindowResizedEventArgs? pgResized;
    string pgTitle = "Panel P-1042", pgText = "", pgWidth = "", pgHeight = "", pgLeft = "", pgTop = "";
    NxWindowSize pgSize = NxWindowSize.Medium;
    int pgKey, pgChanges;

    void Changed() => pgChanges++;
    void Remount() => pgKey++;

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string> { "@bind-Visible=\"open\"" };
            if (!string.IsNullOrWhiteSpace(pgTitle)) attrs.Add($"Title=\"{pgTitle}\"");
            if (!pgModal) attrs.Add("Modal=\"false\"");
            if (!pgEscape) attrs.Add("CloseOnEscape=\"false\"");
            if (pgBackdrop) attrs.Add("CloseOnBackdropClick=\"true\"");
            if (!pgClosable) attrs.Add("Closable=\"false\"");
            if (!pgDraggable) attrs.Add("Draggable=\"false\"");
            if (pgResizable) attrs.Add("Resizable=\"true\"");
            if (pgMinimizable) attrs.Add("Minimizable=\"true\"");
            if (pgMaximizable) attrs.Add("Maximizable=\"true\"");
            if (pgSize != NxWindowSize.Medium) attrs.Add($"Size=\"NxWindowSize.{pgSize}\"");
            if (OrNull(pgWidth) is { } w) attrs.Add($"Width=\"{w}\"");
            if (OrNull(pgHeight) is { } h) attrs.Add($"Height=\"{h}\"");
            if (OrNull(pgLeft) is { } l) attrs.Add($"Left=\"{l}\"");
            if (OrNull(pgTop) is { } t) attrs.Add($"Top=\"{t}\"");
            if (pgInline) attrs.Add("Inline=\"true\"");
            attrs.Add("OnMoved=\"e => moved = e\"");
            attrs.Add("OnResized=\"e => resized = e\"");
            var body = "\n    <ChildContent>…</ChildContent>";
            if (pgIcon) body = "\n    <Icon>…</Icon>" + body;
            if (pgFooter) body += "\n    <Footer>\n        <NxButton>Cancel</NxButton>\n        <NxButton Variant=\"NxButtonVariant.Primary\">OK</NxButton>\n    </Footer>";
            return "<NxWindow " + string.Join("\n          ", attrs) + ">" + body + "\n</NxWindow>";
        }
    }
}
