@page "/dropdownbutton/api"

<DocHeader Slug="dropdownbutton" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>The label. Without one there is no arrow.</td></tr>
                <tr><td>Icon</td><td>RenderFragment?</td><td>—</td><td>Icon before the label, or alone (icon-only).</td></tr>
                <tr><td>Items</td><td>IReadOnlyList&lt;NxMenuItem&gt;?</td><td>—</td><td>The menu items (see NxContextMenu's API).</td></tr>
                <tr><td>Variant / Size</td><td>NxButtonVariant / NxButtonSize</td><td>Secondary / Medium</td><td>As NxButton.</td></tr>
                <tr><td>ShowArrow</td><td>bool</td><td>true</td><td>The down arrow after the label.</td></tr>
                <tr><td>AlignEnd</td><td>bool</td><td>false</td><td>Right-align the menu with the button.</td></tr>
                <tr><td>FullWidth / Disabled</td><td>bool</td><td>false</td><td>As NxButton.</td></tr>
                <tr><td>AriaLabel / MenuAriaLabel / Title</td><td>string?</td><td>—</td><td>Button name (required icon-only), menu name, tooltip.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>Button id (the menu is <code>{Id}-menu</code>); outer class and style.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>OnItemClick</td><td>NxMenuItemClickEventArgs</td><td>An item was picked; the menu has closed.</td></tr>
                <tr><td>OpenAsync() / CloseAsync()</td><td>Task</td><td>Opens or closes the menu.</td></tr>
                <tr><td>IsOpen</td><td>bool</td><td>Whether the menu is open.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <p class="doc-note">The button reads NxButton's variables; the menu NxContextMenu's.</p>
</div>

