@page "/scheduler"
@page "/scheduler/overview"

<DocHeader Slug="scheduler" Page="overview" />

<div class="doc-section">
    <h2>What It Is</h2>
    <p class="doc-note">
        <code>NxScheduler</code> shows a week of items on seven day columns: each placed by its start and end, side by side
        where they overlap, split at midnight when it runs overnight. Work hours are shaded and the calendar opens scrolled to
        them; Today and the arrows move between weeks through <code>@@bind-Date</code>. Fields are read by name.
        It is read-only and has one view — what ERP's shift schedule uses.
    </p>
</div>

<div class="doc-section">
    <h2>Basic Usage</h2>
    <p class="doc-note">ERP's shift schedule: the whole day shown, 7 to 7 shaded as work hours, one-hour slots, each shift in its color with its crew.</p>
    <div class="demo-stage demo-stage-column">
        <NxScheduler Id="overview-scheduler" Data="DemoShifts.Week(week)" @bind-Date="week" WorkDayStart="new(7, 0)" WorkDayEnd="new(19, 0)"
                     SlotDuration="60" SlotDivisions="1" Height="560px" Style="width:100%">
            <ItemTemplate>
                <div class="demo-shift" style="background:@context.Color">
                    <div class="demo-shift-name">@context.ShiftName</div>
                    @foreach (var employee in context.Employees)
                    {
                        <div class="demo-shift-employee">@employee</div>
                    }
                </div>
            </ItemTemplate>
        </NxScheduler>
        <span class="demo-value" id="overview-week">Week of @DemoShifts.WeekStart(week).ToString("MMM d")</span>
    </div>
    <pre class="doc-code">@basicCode</pre>
</div>

<div class="doc-section">
    <h2>Keyboard &amp; Accessibility</h2>
    <div class="doc-table-wrap">
        <table class="doc-table">
            <thead><tr><th>Key</th><th>Behavior</th></tr></thead>
            <tbody>
                <tr><td>Tab</td><td>Today, previous and next week, then the calendar.</td></tr>
                <tr><td>Arrows / Page Up / Page Down</td><td>On the calendar: scroll the hours and, on a narrow screen, the days.</td></tr>
                <tr><td>Roles</td><td>The week's range is a heading announced when it changes; each day is a list named by its date; each item reads its title and times.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<DocPager Slug="scheduler" Page="overview" />

@code {
    DateTime week = DateTime.Today;

    const string basicCode =
        """
        <NxScheduler Data="appointments" @bind-Date="week" WorkDayStart="new(7, 0)" WorkDayEnd="new(19, 0)"
                     SlotDuration="60" SlotDivisions="1" Height="calc(100vh - 340px)">
            <ItemTemplate>
                <div class="shift-appointment" style="background:@context.Color">
                    <div class="shift-name">@context.ShiftName</div>
                    @foreach (var employee in context.Employees) { <div>@employee</div> }
                </div>
            </ItemTemplate>
        </NxScheduler>
        """;
}
