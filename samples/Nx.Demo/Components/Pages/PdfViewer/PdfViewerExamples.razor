@page "/pdfviewer/examples"
@inject IWebHostEnvironment Env

<DocHeader Slug="pdfviewer" Page="examples" />

<div class="doc-section">
    <h2>From an Address</h2>
    <p class="doc-note"><code>Url</code> opens a file the browser can fetch — here one from the demo's own <code>wwwroot</code> — page fit.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <NxPdfViewer Id="url-pdf" Url="@DemoPdf.Url" Zoom="NxPdfViewerZoom.PageFit" Height="480px" Style="width:100%" />
    </div>
    @* /code *@
    <DocExampleCode Key="from-an-address" />
</div>

<div class="doc-section">
    <h2>Following the Page</h2>
    <p class="doc-note"><code>@@bind-Page</code> follows the page in view and jumps to one set from code. <code>OnLoad</code> gives the page count.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <div class="demo-row">
            @for (var i = 1; i <= Math.Max(pageCount, 1); i++)
            {
                var target = i;
                <NxButton id="@($"page-jump-{i}")" Size="NxButtonSize.Small" Variant="@(currentPage == target ? NxButtonVariant.Primary : NxButtonVariant.Secondary)"
                          OnClick="() => currentPage = target">Page @i</NxButton>
            }
            <span class="demo-value" id="page-value">Page @currentPage of @pageCount</span>
        </div>
        <NxPdfViewer Id="page-pdf" Data="pdf" @bind-Page="currentPage" OnLoad="n => pageCount = n" Tools="NxPdfViewerTools.Zoom | NxPdfViewerTools.Search"
                     Zoom="NxPdfViewerZoom.PageWidth" Height="420px" Style="width:100%" />
    </div>
    @* /code *@
    <DocExampleCode Key="following-the-page" />
</div>

<div class="doc-section">
    <h2>Switching Documents</h2>
    <p class="doc-note">A new <code>Data</code> array opens the new document: the find box clears and the viewer starts at page 1.</p>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <div class="demo-row">
            <NxButton id="switch-report" Size="NxButtonSize.Small" OnClick="() => switched = pdf">Pour report</NxButton>
            <NxButton id="switch-none" Size="NxButtonSize.Small" OnClick="() => switched = null">No document</NxButton>
            <NxButton id="switch-broken" Size="NxButtonSize.Small" OnClick="() => switched = Broken">A broken file</NxButton>
            <span class="demo-value" id="switch-error">@switchError</span>
        </div>
        <NxPdfViewer Id="switch-pdf" Data="switched" Tools="NxPdfViewerTools.Pager | NxPdfViewerTools.Download" NoDataText="Pick a document above"
                     OnError="e => switchError = e" OnLoad="_ => switchError = null" Height="360px" Style="width:100%" />
    </div>
    @* /code *@
    <DocExampleCode Key="switching-documents" />
</div>

<DocPager Slug="pdfviewer" Page="examples" />

@code {
    static readonly byte[] Broken = "%PDF-1.4 this is not really a PDF"u8.ToArray();
    byte[]? pdf, switched;
    int currentPage = 1, pageCount;
    string? switchError;

    protected override void OnInitialized() => pdf = switched = DemoPdf.Read(Env);
}
