@page "/dropdown/playground"

<DocHeader Slug="dropdown" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live, over the 20 demo customers bound by id.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner demo-preview-inner-stretch">
                <div style="width:100%">
                    <label class="demo-field-label" for="playground-dropdown">Customer</label>
                    <NxDropDown @key="pgKey" Id="playground-dropdown" Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => (int?)c.Id"
                                ItemGroup="@(pgGroup ? c => c.Region : null)" @bind-Value="pgValue" @bind-Value:after="Changed"
                                DefaultText="@OrNull(pgDefault)" Placeholder="@OrNull(pgPlaceholder)" Clearable="pgClearable"
                                Virtualize="pgVirtualize" Disabled="pgDisabled" ReadOnly="pgReadOnly" MobileMode="pgMobile" />
                </div>
            </div>
            <div class="demo-row">
                <span class="demo-value" id="playground-value">Value: <strong>@(pgValue?.ToString() ?? "null")</strong></span>
                <span class="demo-counter" id="playground-changes">ValueChanged × @pgChanges</span>
            </div>
        </div>

        <div class="demo-controls">
            <div class="demo-controls-title">Text</div>
            <label class="demo-control"><span>DefaultText</span><input type="text" id="pg-default" @bind="pgDefault" @bind:event="oninput" /></label>
            <label class="demo-control"><span>Placeholder</span><input type="text" id="pg-placeholder" @bind="pgPlaceholder" @bind:event="oninput" /></label>

            <div class="demo-controls-title">List</div>
            <label class="demo-control"><span>ItemGroup (region)</span><input type="checkbox" id="pg-group" @bind="pgGroup" /></label>
            <label class="demo-control"><span>Virtualize</span><input type="checkbox" id="pg-virtualize" @bind="pgVirtualize" /></label>

            <div class="demo-controls-title">Behavior</div>
            <label class="demo-control"><span>Clearable</span><input type="checkbox" id="pg-clearable" @bind="pgClearable" /></label>
            <label class="demo-control"><span>ReadOnly</span><input type="checkbox" id="pg-readonly" @bind="pgReadOnly" /></label>
            <label class="demo-control"><span>Disabled</span><input type="checkbox" id="pg-disabled" @bind="pgDisabled" /></label>
            <label class="demo-control">
                <span>MobileMode</span>
                <select id="pg-mobile" @bind="pgMobile" @bind:after="Remount">
                    <option value="@NxComboBoxMobileMode.Auto">Auto</option>
                    <option value="@NxComboBoxMobileMode.Always">Always</option>
                    <option value="@NxComboBoxMobileMode.Never">Never</option>
                </select>
            </label>
        </div>

        <div class="demo-playground-code">
            <DocCode Code="@PlaygroundCode" />
        </div>
    </div>
</div>

<DocPager Slug="dropdown" Page="playground" />

@code {
    static string? OrNull(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    int? pgValue = 5;
    string pgDefault = "(none)", pgPlaceholder = "";
    bool pgGroup, pgVirtualize, pgClearable, pgReadOnly, pgDisabled;
    NxComboBoxMobileMode pgMobile = NxComboBoxMobileMode.Auto;
    int pgKey, pgChanges;

    void Changed() => pgChanges++;
    void Remount() => pgKey++;

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string> { "Data=\"customers\"", "ItemText=\"c => c.Name\"", "ItemValue=\"c => (int?)c.Id\"", "@bind-Value=\"customerId\"" };
            if (pgGroup) attrs.Add("ItemGroup=\"c => c.Region\"");
            if (OrNull(pgDefault) is { } d) attrs.Add($"DefaultText=\"{d}\"");
            if (OrNull(pgPlaceholder) is { } p) attrs.Add($"Placeholder=\"{p}\"");
            if (pgVirtualize) attrs.Add("Virtualize=\"true\"");
            if (pgClearable) attrs.Add("Clearable=\"true\"");
            if (pgReadOnly) attrs.Add("ReadOnly=\"true\"");
            if (pgDisabled) attrs.Add("Disabled=\"true\"");
            if (pgMobile != NxComboBoxMobileMode.Auto) attrs.Add($"MobileMode=\"NxComboBoxMobileMode.{pgMobile}\"");
            return "<NxDropDown " + string.Join("\n            ", attrs) + " />";
        }
    }
}
