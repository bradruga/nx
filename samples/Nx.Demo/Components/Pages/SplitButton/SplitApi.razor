@page "/splitbutton/api"

<DocHeader Slug="splitbutton" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ChildContent / Icon</td><td>RenderFragment?</td><td>—</td><td>The primary action's label and icon.</td></tr>
                <tr><td>Items</td><td>IReadOnlyList&lt;NxMenuItem&gt;?</td><td>—</td><td>The menu items (see NxContextMenu's API).</td></tr>
                <tr><td>Variant / Size</td><td>NxButtonVariant / NxSize</td><td>Secondary / Medium</td><td>Both halves, as NxButton.</td></tr>
                <tr><td>Loading</td><td>bool</td><td>false</td><td>The primary half's loading state.</td></tr>
                <tr><td>Disabled / MenuDisabled</td><td>bool</td><td>false</td><td>Both halves / the arrow only.</td></tr>
                <tr><td>AriaLabel</td><td>string?</td><td>—</td><td>The primary action's name (for icon-only) and the group's.</td></tr>
                <tr><td>MenuAriaLabel</td><td>string?</td><td>"More options"</td><td>The arrow's and the menu's name.</td></tr>
                <tr><td>Title</td><td>string?</td><td>—</td><td>Tooltip on the primary action.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>Primary id (arrow <code>{Id}-toggle</code>, menu <code>{Id}-menu</code>); outer class and style.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>OnClick</td><td>MouseEventArgs</td><td>The primary action.</td></tr>
                <tr><td>OnItemClick</td><td>NxMenuItemClickEventArgs</td><td>A menu item was picked.</td></tr>
                <tr><td>OpenAsync() / CloseAsync()</td><td>Task</td><td>Opens or closes the menu.</td></tr>
                <tr><td>IsOpen</td><td>bool</td><td>Whether the menu is open.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <p class="doc-note">The halves read NxButton's variables; the menu NxContextMenu's.</p>
</div>

