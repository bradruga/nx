@page "/radio/playground"

<DocHeader Slug="radio" Page="playground" />

<div class="doc-section">
    <h2>Playground</h2>
    <p class="doc-note">Every parameter, live. The group is bound to a string from a list of finishes.</p>

    <div class="demo-playground">
        <div class="demo-preview">
            <div class="demo-preview-inner demo-preview-inner-stretch">
                @if (pgDeclared)
                {
                    <NxRadioGroup Id="playground-radio" @bind-Value="pgValue" @bind-Value:after="() => pgChanges++"
                                  Label="@LabelOrNull" Orientation="pgOrientation" Disabled="pgDisabled">
                        @foreach (var finish in Finishes)
                        {
                            <NxRadioButton Value="finish" Label="@finish" Disabled="@(pgDisableOne && finish == Finishes[2])" />
                        }
                    </NxRadioGroup>
                }
                else
                {
                    <NxRadioGroup TValue="string" Id="playground-radio" Data="Finishes" @bind-Value="pgValue" @bind-Value:after="() => pgChanges++"
                                  Label="@LabelOrNull" Orientation="pgOrientation" Disabled="pgDisabled"
                                  ItemDisabled="@(pgDisableOne ? f => f == Finishes[2] : null)"
                                  ItemTemplate="@(pgTemplate ? FinishTemplate : null)" />
                }
            </div>
            <div class="demo-row">
                <span class="demo-value" id="playground-value">Value: <strong>@(pgValue ?? "null")</strong></span>
                <span class="demo-counter" id="playground-changes">ValueChanged × @pgChanges</span>
            </div>
        </div>

        <div class="demo-controls">
            <div class="demo-controls-title">Items</div>
            <div class="demo-control">
                <span>Items from</span>
                <div class="demo-segmented" role="group" aria-label="Items from">
                    <button type="button" id="pg-data" aria-pressed="@(!pgDeclared ? "true" : "false")" @onclick="() => pgDeclared = false">Data</button>
                    <button type="button" id="pg-declared" aria-pressed="@(pgDeclared ? "true" : "false")" @onclick="() => pgDeclared = true">Declared</button>
                </div>
            </div>
            <label class="demo-control"><span>Disable "@Finishes[2]"</span><input type="checkbox" id="pg-disable-one" @bind="pgDisableOne" /></label>
            <label class="demo-control"><span>ItemTemplate (Data)</span><input type="checkbox" id="pg-template" @bind="pgTemplate" disabled="@pgDeclared" /></label>

            <div class="demo-controls-title">Layout</div>
            <label class="demo-control"><span>Label</span><input type="text" @bind="pgLabel" @bind:event="oninput" /></label>
            <div class="demo-control">
                <span>Orientation</span>
                <div class="demo-segmented" role="group" aria-label="Orientation">
                    @foreach (var o in Enum.GetValues<NxOrientation>())
                    {
                        <button type="button" id="@($"pg-orientation-{o}")" aria-pressed="@(pgOrientation == o ? "true" : "false")" @onclick="() => pgOrientation = o">@o</button>
                    }
                </div>
            </div>

            <div class="demo-controls-title">State</div>
            <label class="demo-control"><span>Disabled</span><input type="checkbox" id="pg-disabled" @bind="pgDisabled" /></label>
        </div>

        <div class="demo-playground-code">
            <pre class="doc-code">@PlaygroundCode</pre>
        </div>
    </div>
</div>

<DocPager Slug="radio" Page="playground" />

@code {
    static readonly string[] Finishes = ["Smooth form", "Broom", "Exposed aggregate", "Sandblast"];

    static readonly RenderFragment<string> FinishTemplate = f =>
        @<text><span class="demo-swatch demo-swatch-@(Array.IndexOf(Finishes, f))"></span>@f</text>;

    string? pgValue = Finishes[0];
    string pgLabel = "Finish";
    bool pgDeclared, pgDisableOne, pgTemplate, pgDisabled;
    NxOrientation pgOrientation = NxOrientation.Vertical;
    int pgChanges;

    string? LabelOrNull => string.IsNullOrWhiteSpace(pgLabel) ? null : pgLabel;

    string PlaygroundCode
    {
        get
        {
            var attrs = new List<string>();
            if (!pgDeclared) attrs.Add("Data=\"finishes\"");
            attrs.Add("@bind-Value=\"finish\"");
            if (LabelOrNull is { } l) attrs.Add($"Label=\"{l}\"");
            if (pgOrientation != NxOrientation.Vertical) attrs.Add("Orientation=\"NxOrientation.Horizontal\"");
            if (pgDisableOne && !pgDeclared) attrs.Add($"ItemDisabled=\"f => f == \\\"{Finishes[2]}\\\"\"");
            if (pgDisabled) attrs.Add("Disabled=\"true\"");
            var open = "<NxRadioGroup " + string.Join("\n              ", attrs);
            if (pgDeclared)
                return open + ">\n    @foreach (var f in finishes)\n    {\n        <NxRadioButton Value=\"f\" Label=\"@f\" />\n    }\n</NxRadioGroup>";
            if (pgTemplate)
                return open + ">\n    <ItemTemplate Context=\"f\"><Swatch Finish=\"@f\" /> @f</ItemTemplate>\n</NxRadioGroup>";
            return open + " />";
        }
    }
}
