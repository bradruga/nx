@page "/switch/examples"

<DocHeader Slug="switch" Page="examples" />

<div class="doc-section">
    <h2>Sizes</h2>
    @* code *@
    <div class="demo-stage demo-stage-column">
        @foreach (var size in Enum.GetValues<NxSize>())
        {
            <div class="demo-row">
                <span class="demo-row-label">@size</span>
                <NxToggleSwitch Id="@($"size-{size}")" Size="size" Value="sizes[size]" ValueChanged="v => sizes[size] = v" Label="Auto-schedule" />
            </div>
        }
    </div>
    @* /code *@
    <DocExampleCode Key="sizes" />
</div>

<div class="doc-section">
    <h2>On / Off Text</h2>
    <p class="doc-note">
        <code>OnText</code> and <code>OffText</code> show inside the track, opposite the thumb, or with
        <code>StateTextPosition="Beside"</code> next to it.
    </p>
    <div class="demo-stage demo-stage-column">
        <NxToggleSwitch Id="text-inside" @bind-Value="inside" OnText="On" OffText="Off" Label="Inside the track" />
        <NxToggleSwitch Id="text-beside" @bind-Value="beside" OnText="Yes" OffText="No" StateTextPosition="NxToggleTextPosition.Beside" Label="Beside the track" />
    </div>
    <DocCode Code="@textCode" />
</div>

<div class="doc-section">
    <h2>Loading</h2>
    <p class="doc-note">
        For a setting saved to the server as it changes: set <code>Loading</code> while the save runs. A spinner shows in the thumb,
        clicks are ignored, and the switch keeps focus. This one takes a second to save.
    </p>
    <div class="demo-stage demo-stage-column">
        <NxToggleSwitch Id="loading-switch" Value="published" ValueChanged="PublishAsync" Loading="saving" Label="Publish to the customer portal" />
        <EventLog @ref="log" Label="Saves" EmptyText="Flip the switch." />
    </div>
    <DocCode Code="@loadingCode" />
</div>

<div class="doc-section">
    <h2>Label Position</h2>
    @* code *@
    <div class="demo-stage demo-stage-column demo-stage-narrow">
        <div class="demo-switch-list">
            <NxToggleSwitch Id="pos-start-1" @bind-Value="settingA" Label="Show cost columns" LabelPosition="NxLabelPosition.Start" />
            <NxToggleSwitch Id="pos-start-2" @bind-Value="settingB" Label="Compact rows" LabelPosition="NxLabelPosition.Start" />
            <NxToggleSwitch Id="pos-start-3" @bind-Value="settingC" Label="Group by job" LabelPosition="NxLabelPosition.Start" />
        </div>
    </div>
    @* /code *@
    <DocExampleCode Key="label-position" />
</div>

<div class="doc-section">
    <h2>Disabled</h2>
    @* code *@
    <div class="demo-stage">
        <NxToggleSwitch Id="disabled-on" Value="true" Disabled="true" Label="Disabled, on" />
        <NxToggleSwitch Id="disabled-off" Value="false" Disabled="true" Label="Disabled, off" />
    </div>
    @* /code *@
    <DocExampleCode Key="disabled" />
</div>

<div class="doc-section">
    <h2>Form Validation</h2>
    @* code *@
    <div class="demo-stage demo-stage-column">
        <EditForm id="switch-form" Model="form" OnValidSubmit="Submit" FormName="switch-form">
            <DataAnnotationsValidator />
            <NxToggleSwitch Id="form-switch" @bind-Value="form.Certified" Label="Mix design certified for this job" />
            <ValidationMessage For="() => form.Certified" />
            <div class="demo-row" style="margin-top:12px">
                <NxButton id="form-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Schedule pour</NxButton>
                <span class="demo-value" id="form-result">@result</span>
            </div>
        </EditForm>
    </div>
    @* /code *@
    <DocExampleCode Key="form-validation" />
</div>

<DocPager Slug="switch" Page="examples" />

@code {
    readonly Dictionary<NxSize, bool> sizes = new() { [NxSize.Small] = true, [NxSize.Medium] = true, [NxSize.Large] = true };
    bool inside = true, beside, published, saving, settingA = true, settingB, settingC = true;
    EventLog? log;

    async Task PublishAsync(bool value)
    {
        saving = true;
        log?.Add($"Saving {(value ? "published" : "unpublished")}…");
        await Task.Delay(1000);
        published = value;
        saving = false;
        log?.Add("Saved");
    }

    readonly PourForm form = new();
    string result = "Not scheduled";

    void Submit() => result = "Scheduled";

    class PourForm
    {
        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "Certify the mix design first.")]
        public bool Certified { get; set; }
    }

    const string textCode =
        """
        <NxToggleSwitch @bind-Value="enabled" OnText="On" OffText="Off" />
        <NxToggleSwitch @bind-Value="enabled" OnText="Yes" OffText="No"
                        StateTextPosition="NxToggleTextPosition.Beside" />
        """;

    const string loadingCode =
        """
        <NxToggleSwitch Value="published" ValueChanged="PublishAsync" Loading="saving" Label="Publish" />

        @code {
            async Task PublishAsync(bool value)
            {
                saving = true;
                await api.SetPublishedAsync(value);
                published = value;
                saving = false;
            }
        }
        """;
}
