@page "/"
@inject NavigationManager Nav

<PageTitle>Nx Components</PageTitle>

<section class="home-hero">
    <h1>Blazor components for the ERP portal.</h1>
    <p>
        Nx is a small, dependency-free component library for Blazor on .NET 10 — the building blocks of the
        portal. Every component is themed by CSS custom properties, works with <code>EditForm</code>
        validation, and is driven from the keyboard first.
    </p>
    <div class="home-badges">
        <span class="home-badge">@DemoCatalog.Components.Count components</span>
        <span class="home-badge">.NET 10 · Interactive Server</span>
        <span class="home-badge">bUnit + Playwright tested</span>
        <span class="home-badge">Light &amp; dark themes</span>
    </div>
</section>

<div class="doc-section">
    <h2>Components</h2>
    <div class="home-filter" id="home-filter">
        <NxToggleGroup Data="Filters" Value="SelectedFilter" ValueChanged="(string? value) => FilterBy(value)" AriaLabel="Category">
            <ItemTemplate Context="filter">@filter<span class="home-filter-count">@CountOf(filter)</span></ItemTemplate>
        </NxToggleGroup>
    </div>
    @foreach (var category in DemoCatalog.Categories.Where(c => SelectedFilter == AllFilter || c == SelectedFilter))
    {
        <h3 class="home-category">@category</h3>
        <div class="component-grid">
            @foreach (var component in DemoCatalog.Components.Where(c => c.Category == category))
            {
                <div class="component-card" id="card-@component.Slug">
                    <div class="component-card-preview">@Preview(component.Slug)</div>
                    <div class="component-card-body">
                        <a class="component-card-title" href="@($"{component.Slug}/overview")">@component.Name</a>
                        <p class="component-card-desc">@component.Summary</p>
                        <div class="component-card-features">
                            @foreach (var feature in component.Features)
                            {
                                <span>@feature</span>
                            }
                        </div>
                        <a class="component-card-link" href="@($"{component.Slug}/overview")">Open demo →</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="doc-section">
    <h2>Getting Started</h2>
    <div class="home-steps">
        <div class="home-step">
            <h3><span class="home-step-num">1</span>Reference the library</h3>
            <p class="doc-note">Add a project reference to <code>src/Nx.Components</code>.</p>
            <pre class="doc-code">@step1</pre>
        </div>
        <div class="home-step">
            <h3><span class="home-step-num">2</span>Add the theme</h3>
            <p class="doc-note">One stylesheet of tokens; each component's layout ships in the scoped CSS bundle.</p>
            <pre class="doc-code">@step2</pre>
        </div>
        <div class="home-step">
            <h3><span class="home-step-num">3</span>Use the components</h3>
            <p class="doc-note">Import the namespace in <code>_Imports.razor</code> and go.</p>
            <pre class="doc-code">@step3</pre>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Theming</h2>
    <p class="doc-note">
        Every color, radius and size is a custom property in <code>nx-theme.css</code>. Override them on <code>:root</code>,
        or on any container to theme part of a page. Add <code>class="nx-theme-dark"</code> for the dark theme — the
        moon button in the header does exactly that. This site brands the accent green; the library default is blue.
    </p>
    <pre class="doc-code">@themeCode</pre>
</div>

@code {
    const string AllFilter = "All";
    static readonly IReadOnlyList<string> Filters = [AllFilter, .. DemoCatalog.Categories];

    /// <summary>The category the grid shows, from <c>?category=</c>; anything else shows all.</summary>
    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }

    string SelectedFilter => DemoCatalog.Categories.FirstOrDefault(c => string.Equals(c, Category, StringComparison.OrdinalIgnoreCase)) ?? AllFilter;

    static int CountOf(string? filter) => filter == AllFilter ? DemoCatalog.Components.Count : DemoCatalog.Components.Count(c => c.Category == filter);

    void FilterBy(string? filter) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("category", filter is null or AllFilter ? null : filter), replace: true);

    int? customerId;
    decimal? price = 1240m;
    DateOnly? pourDate = DateOnly.FromDateTime(DateTime.Today);
    DateOnly? windowFrom = DateOnly.FromDateTime(DateTime.Today), windowTo = DateOnly.FromDateTime(DateTime.Today.AddDays(4));
    TimeOnly? arrival = new(7, 15);
    string? shipVia;
    IEnumerable<string> homeStates = ["Maine", "Vermont", "New York"];
    readonly IReadOnlyList<NxMenuItem> homeMenu = DemoMenus.EditItems();
    readonly IReadOnlyList<NxMenuItem> homeExport = DemoMenus.ExportItems();
    readonly IReadOnlyList<NxMenuItem> homeSave = [new("Save as draft"), new("Save and release")];
    bool rush = true, notify = true;
    string shift = "Day";
    string? range = "Week";

    string? homeCity;
    string? homeColor = "#4371c4";
    string? homeBid = "26-0412";
    bool homeToggle = true;
    int homeSlider = 4;
    static readonly string[] HomeChips = ["5000 psi", "SCC", "Grout"];
    static readonly YardLocation[] HomeYard = [.. DemoYard.Named("Lincoln Ave")];
    const string HomeEditor = "<p>Strip <strong>WP-12</strong> after <em>18 h</em>.</p>";
    static readonly NxEditorTool[] HomeEditorTools = [NxEditorTool.Bold, NxEditorTool.Italic, NxEditorTool.Underline, NxEditorTool.Separator, NxEditorTool.UnorderedList];
    static readonly IReadOnlyList<PermissionNode> HomeExpanded = DemoTree.Permissions.Where(n => n.Id is "acc" or "acc.bills").ToList();
    static RenderFragment IconOf(NxIconData icon) => @<NxIcon Icon="icon" />;
    DateTime? gateOpens = DateTime.Today.AddDays(1).AddHours(6);
    readonly PourForm homeForm = new();
    static readonly IReadOnlyList<string> HomeCities = SampleData.Places.Select(p => p.City).ToList();

    static readonly string[] Shifts = ["Day", "Swing", "Night"];
    static readonly string[] Ranges = ["Day", "Week", "Month"];

    RenderFragment Preview(string slug) => slug switch
    {
        "button" => @<text>
            <NxButton Variant="NxButtonVariant.Primary" Icon="@Icon("save")">Save</NxButton>
            <NxButton>Cancel</NxButton>
            <NxButton Variant="NxButtonVariant.Ghost" Icon="@Icon("settings")" AriaLabel="Settings" />
        </text>,
        "textbox" => @<NxTextBox Label="Customer" Value="Kiewit Northeast" Clearable="true" Style="width:240px" />,
        "numeric" => @<NxNumericTextBox Label="Unit price" @bind-Value="price" Format="N2" Min="0m" Prefix="@Text("$")" Style="width:240px" />,
        "combobox" => @<NxComboBox Data="SampleData.Customers" ItemText="c => c.Name" ItemValue="c => c.Id" @bind-Value="customerId"
                                   Placeholder="Search customers" Clearable="true" Style="width:240px" aria-label="Customer" />,
        "datepicker" => @<NxDatePicker Label="Pour date" @bind-Value="pourDate" Style="width:240px" />,
        "daterange" => @<NxDateRangePicker @bind-StartValue="windowFrom" @bind-EndValue="windowTo" Style="width:300px" />,
        "timepicker" => @<NxTimePicker Label="Truck arrives" @bind-Value="arrival" Step="15" Style="width:240px" />,
        "checkbox" => @<NxCheckBox @bind-Value="rush" Label="Rush order" />,
        "switch" => @<NxToggleSwitch @bind-Value="notify" Label="Notify on ship" OnText="On" OffText="Off" />,
        "radio" => @<NxRadioGroup Data="Shifts" @bind-Value="shift" Orientation="NxOrientation.Horizontal" Label="Shift" />,
        "togglegroup" => @<NxToggleGroup Data="Ranges" @bind-Value="range" AriaLabel="Range" />,
        "window" => @<div class="home-window-preview" aria-hidden="true">
            <div class="home-window-titlebar"><span>Edit pour</span><span class="home-window-x">×</span></div>
            <div class="home-window-body">P-1042 · North wall</div>
            <div class="home-window-footer"><NxButton Size="NxButtonSize.Small" tabindex="-1">Cancel</NxButton><NxButton Size="NxButtonSize.Small" Variant="NxButtonVariant.Primary" tabindex="-1">Save</NxButton></div>
        </div>,
        "tabstrip" => @<NxTabStrip AriaLabel="Job" Style="width:260px">
            <NxTab Title="Details"><span class="home-tab-text">Job 55120</span></NxTab>
            <NxTab Title="Pours"><span class="home-tab-text">2 scheduled</span></NxTab>
            <NxTab Title="Drawings"><span class="home-tab-text">12 approved</span></NxTab>
        </NxTabStrip>,
        "splitter" => @<NxSplitter Style="width:260px; height:110px">
            <NxSplitterPane Size="40%"><span class="home-tab-text">Jobs</span></NxSplitterPane>
            <NxSplitterPane><span class="home-tab-text">Details</span></NxSplitterPane>
        </NxSplitter>,
        "dropdown" => @<NxDropDown TItem="string" TValue="string" Data="SampleData.ShipVia" @bind-Value="shipVia" DefaultText="Any carrier" Style="width:240px" aria-label="Ship via" />,
        "multiselect" => @<NxMultiSelect TItem="string" TValue="string" Data="SampleData.States" @bind-Values="homeStates" Style="width:260px" MaxVisibleChips="2" aria-label="States" />,
        "textarea" => @<NxTextArea Label="Notes" Value="@("Slump 4 in. at 6:40.")" Rows="2" Style="width:260px" />,
        "tooltip" => @<NxTooltip Text="Saves and sends to the plant" ShowDelay="0"><NxButton Variant="NxButtonVariant.Primary">Hover me</NxButton></NxTooltip>,
        "contextmenu" => @<NxContextMenu Items="homeMenu"><div class="demo-context-card" style="max-width:240px"><strong>Right-click me</strong><span>Pour P-1042</span></div></NxContextMenu>,
        "dropdownbutton" => @<NxDropDownButton Items="homeExport">Export</NxDropDownButton>,
        "splitbutton" => @<NxSplitButton Variant="NxButtonVariant.Primary" Items="homeSave">Save</NxSplitButton>,
        "autocomplete" => @<NxAutoComplete Data="HomeCities" @bind-Value="homeCity" Placeholder="Type a city" Style="width:240px" aria-label="City">
            <Prefix><NxIcon Icon="NxIcons.MapMarker" /></Prefix>
        </NxAutoComplete>,
        "datetimepicker" => @<NxDateTimePicker Label="Gate opens" @bind-Value="gateOpens" TimeStep="15" Style="width:240px" />,
        "form" => @<NxForm Model="homeForm" Columns="2" Style="width:280px">
            <NxFormItem Field="@nameof(PourForm.Trucks)" />
            <NxFormItem Field="@nameof(PourForm.Status)" />
        </NxForm>,
        "icon" => @<div class="demo-row">
            <NxIcon Icon="NxIcons.Plus" Size="NxIconSize.XLarge" />
            <NxIcon Icon="NxIcons.Pencil" Size="NxIconSize.XLarge" />
            <NxIcon Icon="NxIcons.Trash" Size="NxIconSize.XLarge" Color="NxIconColor.Danger" />
            <NxIcon Icon="NxIcons.Print" Size="NxIconSize.XLarge" />
            <NxIcon Icon="NxIcons.CheckCircle" Size="NxIconSize.XLarge" Color="NxIconColor.Success" />
        </div>,
        "buttongroup" => @<NxButtonGroup AriaLabel="Week">
            <NxButton>Today</NxButton>
            <NxButton AriaLabel="Previous week" Icon="@IconOf(NxIcons.ChevronLeft)" />
            <NxButton AriaLabel="Next week" Icon="@IconOf(NxIcons.ChevronRight)" />
        </NxButtonGroup>,
        "colorpicker" => @<NxColorPicker @bind-Value="homeColor" AriaLabel="Crew color" ShowValue="true" />,
        "progressbar" => @<NxProgressBar Value="68" AriaLabel="Pieces produced" Style="width:240px" />,
        "notification" => @<div class="home-toast" aria-hidden="true">
            <NxIcon Icon="NxIcons.CheckCircle" Color="NxIconColor.Success" />
            <span>Saved by Dana Ortiz at 9:12 AM</span>
        </div>,
        "togglebutton" => @<NxToggleButton @bind-Selected="homeToggle" Icon="@IconOf(NxIcons.Eye)">Show deleted</NxToggleButton>,
        "maskedtextbox" => @<NxMaskedTextBox Label="Bid number" Mask="00-0000" IncludeLiterals="true" @bind-Value="homeBid" Style="width:240px" />,
        "fileselect" or "upload" => @<div class="home-filezone" aria-hidden="true"><NxIcon Icon="NxIcons.Upload" Color="NxIconColor.Primary" /><span><strong>Select files</strong> or drop them here</span></div>,
        "dialog" => @<div class="home-window-preview" aria-hidden="true">
            <div class="home-window-titlebar"><span>Delete pour</span><span class="home-window-x">×</span></div>
            <div class="home-window-body">Delete pour P-1042?</div>
            <div class="home-window-footer"><NxButton Size="NxButtonSize.Small" Variant="NxButtonVariant.Danger" tabindex="-1">Delete</NxButton><NxButton Size="NxButtonSize.Small" tabindex="-1">Cancel</NxButton></div>
        </div>,
        "mediaquery" => @<div class="home-mq" aria-hidden="true"><code>(min-width: 992px)</code><strong>true</strong></div>,
        "treeview" => @<NxTreeView Data="DemoTree.Permissions" ItemId="n => n.Id" ParentId="n => n.ParentId" ItemText="n => n.Text"
                                   ExpandedItems="HomeExpanded" AriaLabel="Permissions" Style="width:240px; height:120px" />,
        "loader" => @<div class="demo-row">
            <NxLoader />
            <NxLoader Type="NxLoaderType.Pulsing" />
        </div>,
        "chart" => @<NxChart Height="140px" Width="260px" LegendPosition="NxChartLegendPosition.None" ShowTooltips="false" AriaLabel="Loads per day">
            <NxChartSeries Name="Loads" Data="DemoCharts.Days.TakeLast(14)" Field="@nameof(YardDay.Loads)" CategoryField="@nameof(YardDay.Date)" Markers="false" />
            <NxChartSeries Name="Hours" Type="NxChartSeriesType.Area" Data="DemoCharts.Days.TakeLast(14)" Field="@nameof(YardDay.Hours)" CategoryField="@nameof(YardDay.Date)" />
            <NxChartCategoryAxis Visible="false" />
            <NxChartValueAxis Visible="false" />
        </NxChart>,
        "slider" =>@<NxSlider TValue="int" Min="0" Max="10" LargeStep="5" @bind-Value="homeSlider" aria-label="Crew size" Style="width:240px" />,
        "chiplist" => @<NxChipList Data="HomeChips" AriaLabel="Mixes" />,
        "editor" => @<NxEditor Value="@HomeEditor" Tools="HomeEditorTools" Height="112px" AriaLabel="Note" Style="width:260px" />,
        "signature" => @<div class="home-signature" aria-hidden="true"><svg viewBox="0 0 200 60"><path d="M10 42 C30 6 46 58 66 26 S98 50 116 30 S150 40 170 22" /></svg><span>Sign here</span></div>,
        "popup" => @<div class="home-popup" aria-hidden="true"><span class="home-popup-anchor">Filter ▾</span><span class="home-popup-box">Sort A to Z<br />5000 psi<br />SCC</span></div>,
        "pdfviewer" => @<div class="home-pdf" aria-hidden="true"><span><b></b><i></i><i></i><i></i></span><span><b></b><i></i><i></i></span></div>,
        "circulargauge" => @<NxCircularGauge Value="64" Size="110px" AriaLabel="Reconciled"><CenterTemplate>64%</CenterTemplate></NxCircularGauge>,
        "treelist" => @<NxTreeList Data="DemoYard.Locations" ItemId="l => l.ResourceId" ParentId="l => l.CurrentContainerId" ExpandedItems="HomeYard"
                                   SelectionMode="NxTreeSelectionMode.None" Height="132px" AriaLabel="Yard" Style="width:250px">
            <Columns>
                <NxTreeListColumn Field="@nameof(YardLocation.Name)" Title="Location" Width="120px" />
                <NxTreeListColumn Field="@nameof(YardLocation.AggregatePieceCount)" Title="Pieces" Width="64px" />
            </Columns>
        </NxTreeList>,
        "scheduler" => @<div class="home-scheduler" aria-hidden="true">@foreach (var d in new[] { "Mon", "Tue", "Wed" }) { <span class="home-scheduler-day"><b>@d</b><i class="home-shift-day">Day</i><i class="home-shift-swing">Swing</i></span> }</div>,
        "filemanager" => @<div class="home-files" aria-hidden="true"><span class="home-files-tree"><i>▸ Drawings</i><i>▸ Quality</i><i>▸ Photos</i></span><span class="home-files-list"><i class="home-files-folder">Shop</i><i>WP-12.pdf</i><i>Embeds.xlsx</i></span></div>,
        "gantt" => @<div class="home-gantt" aria-hidden="true"><span style="margin-left:0;width:90px">Design</span><span style="margin-left:70px;width:110px;background:#1e8c8c">Production</span><span style="margin-left:160px;width:70px;background:#d97a1e">Erection</span></div>,
        "chat" => @<div class="home-chat" aria-hidden="true"><span>Trucks at 6:30?</span><span class="home-chat-own">Confirmed, three loads.</span></div>,
        "toolbar" => @<NxToolBar AriaLabel="Sheet" Overflow="NxToolBarOverflow.Wrap" Style="width:260px">
            <NxToolBarButton Text="New" Icon="@IconOf(NxIcons.Plus)" />
            <NxToolBarButton Text="Save" Icon="@IconOf(NxIcons.Save)" Variant="NxButtonVariant.Primary" />
            <NxToolBarSeparator />
            <NxToolBarButton Icon="@IconOf(NxIcons.Print)" AriaLabel="Print" />
        </NxToolBar>,
        "colorgradient" => @<div class="home-gradient" aria-hidden="true"><span></span><i></i></div>,
        "carousel" => @<div class="home-carousel" aria-hidden="true"><DemoSlideView Slide="DemoSlides.Projects[0]" ShowCaption="false" /></div>,
        "tilelayout" => @<div class="home-tiles" aria-hidden="true"><span class="home-tile-wide">Today's sets</span><span>CAD</span><span>Loads</span><span>Email</span></div>,
        _ => @<text></text>
    };

    static RenderFragment Icon(string name) => @<DemoIcon Name="@name" />;
    static RenderFragment Text(string text) => @<span>@text</span>;

    const string step1 =
        """
        <ProjectReference Include="..\Nx.Components\Nx.Components.csproj" />
        """;

    const string step2 =
        """
        <link rel="stylesheet" href="@Assets["_content/Nx.Components/nx-theme.css"]" />
        <link rel="stylesheet" href="@Assets["YourApp.styles.css"]" />
        """;

    const string step3 =
        """
        @using Nx.Components

        <NxTextBox Label="Customer" @bind-Value="name" />
        <NxButton Variant="NxButtonVariant.Primary" OnClick="SaveAsync">Save</NxButton>
        """;

    const string themeCode =
        """
        :root {
            --nx-accent:        #16A34A;
            --nx-accent-hover:  #15803D;
            --nx-radius:        4px;
            --nx-control-height-md: 32px;
        }
        """;
}
