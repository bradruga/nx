                <tr><td>Label</td><td>string?</td><td>—</td><td>The legend.</td></tr>
                <tr><td>Columns / ColumnSpacing</td><td>int? / string?</td><td>the form's</td><td>The group's own grid.</td></tr>
                <tr><td>ChildContent / Class / Style</td><td></td><td></td><td>Its items; on the fieldset.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>NxValidationMessage</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>For</td><td>Expression&lt;Func&lt;object?&gt;&gt;?</td><td>—</td><td>The field: <code>For="() =&gt; order.PourDate"</code>.</td></tr>
                <tr><td>Class</td><td>string?</td><td>—</td><td>On the outer element; other attributes go there too.</td></tr>
