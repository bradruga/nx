@page "/form/api"

<DocHeader Slug="form" Page="api" />

<div class="doc-section">
    <h2>NxForm</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Model</td><td>object?</td><td>—</td><td>The object edited; the form makes its EditContext. Set this or EditContext.</td></tr>
                <tr><td>EditContext</td><td>EditContext?</td><td>—</td><td>Your own context. Reads back the context in use either way.</td></tr>
                <tr><td>OnValidSubmit / OnInvalidSubmit</td><td>EventCallback&lt;EditContext&gt;</td><td>—</td><td>Submit after validation passed or failed.</td></tr>
                <tr><td>OnSubmit</td><td>EventCallback&lt;EditContext&gt;</td><td>—</td><td>Every submit, without validating; not with the two above.</td></tr>
                <tr><td>Columns</td><td>int</td><td>1</td><td>Grid columns for the items.</td></tr>
                <tr><td>ColumnSpacing</td><td>string?</td><td>16px</td><td>Space between columns, as CSS.</td></tr>
                <tr><td>Orientation</td><td>NxOrientation</td><td>Vertical</td><td>Labels above (Vertical) or beside (Horizontal) the editors.</td></tr>
                <tr><td>Validation</td><td>RenderFragment?</td><td>DataAnnotationsValidator</td><td>The validators; empty for none.</td></tr>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>Items, groups and any markup.</td></tr>
                <tr><td>Buttons</td><td>RenderFragment?</td><td>—</td><td>The row under the items. No buttons are rendered for you.</td></tr>
                <tr><td>SubmitOnEnter</td><td>bool</td><td>true</td><td><code>false</code>: Enter in a field does not submit.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>On the <code>&lt;form&gt;</code>; generated editors get <code>{Id}-{property}</code>.</td></tr>
                <tr><td>IsValid()</td><td>bool</td><td></td><td>Validates every field, shows the messages, returns whether there were none.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>NxFormItem</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>For</td><td>Expression&lt;Func&lt;object?&gt;&gt;?</td><td>—</td><td>The field, as a lambda (<code>() =&gt; order.PourDate</code>, or nested: <code>() =&gt; order.Site.City</code>): the editor, label and messages.</td></tr>
                <tr><td>Label</td><td>string?</td><td>[Display] or the name in words</td><td>The label; none for your own editor unless set.</td></tr>
                <tr><td>Id</td><td>string?</td><td>{form id}-{property}</td><td>The editor's id, which the label targets (<code>{form id}-Site-City</code> for a nested field); give your own editor the same.</td></tr>
                <tr><td>ColSpan</td><td>int</td><td>1</td><td>Columns spanned, up to the form's or group's Columns.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>Disables the generated editor.</td></tr>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>Your own editor.</td></tr>
                <tr><td>Class / Style</td><td>string?</td><td>—</td><td>On the item.</td></tr>
            </tbody>
        </table>
    </div>
</div>

