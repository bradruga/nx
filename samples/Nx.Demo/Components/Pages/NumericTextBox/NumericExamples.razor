@page "/numeric/examples"
@using System.ComponentModel.DataAnnotations
@using System.Globalization

<DocHeader Slug="numeric" Page="examples" />

<div class="doc-section">
    <h2>Number Types</h2>
    <p class="doc-note">
        The type comes from what you bind. Nullable types allow an empty field; non-nullable ones put the last value back when the
        field is emptied. Integers round typed decimals away from zero.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <NxNumericTextBox Id="type-int" Label="int" @bind-Value="typeInt" Culture="EnUs" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="type-int-value">Value: <strong>@typeInt</strong></span></div>
            </div>
            <div>
                <NxNumericTextBox Id="type-decimal" Label="decimal?" @bind-Value="typeDecimal" Culture="EnUs" Placeholder="Empty is null" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="type-decimal-value">Value: <strong>@(typeDecimal?.ToString(CultureInfo.InvariantCulture) ?? "null")</strong></span></div>
            </div>
            <div>
                <NxNumericTextBox Id="type-double" Label="double" @bind-Value="typeDouble" Culture="EnUs" Step="0.1" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="type-double-value">Value: <strong>@typeDouble.ToString(CultureInfo.InvariantCulture)</strong></span></div>
            </div>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Min, Max &amp; Step</h2>
    <p class="doc-note">
        Typed values are clamped when committed and the spin button at a limit disables. <code>Step</code> sets the arrow and spin
        increment; <kbd class="doc-kbd">PgUp</kbd> and <kbd class="doc-kbd">PgDn</kbd> move ten steps.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <NxNumericTextBox Id="range-pct" Label="Discount (0–100, step 5)" @bind-Value="discount" Min="0" Max="100" Step="5" Culture="EnUs" Suffix="@Text("%")" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="range-pct-value">Value: <strong>@discount</strong></span></div>
            </div>
            <div>
                <NxNumericTextBox Id="range-thickness" Label="Wall thickness (in, step 0.25)" @bind-Value="thickness" Min="4m" Max="24m" Step="0.25m" Decimals="2" Culture="EnUs" Suffix="@Text("in")" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="range-thickness-value">Value: <strong>@thickness.ToString(CultureInfo.InvariantCulture)</strong></span></div>
            </div>
        </div>
    </div>
    <pre class="doc-code">@rangeCode</pre>
</div>

<div class="doc-section">
    <h2>Spin Buttons</h2>
    <p class="doc-note">
        Click a spin button to step once, or hold it: after 400 ms it repeats every 60 ms until you let go or it reaches the limit.
        On touch screens the buttons sit side by side at a size a finger can hit. <code>ShowSpinButtons="false"</code> removes them.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <div>
                <NxNumericTextBox Id="spin-hold" Label="Pieces (hold a button)" @bind-Value="pieces" Min="0" Max="500" Culture="EnUs" />
                <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="spin-hold-value">Value: <strong>@pieces</strong></span></div>
            </div>
            <div>
                <NxNumericTextBox Id="spin-none" Label="No spin buttons" @bind-Value="noSpin" ShowSpinButtons="false" Culture="EnUs" />
            </div>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Format &amp; Culture</h2>
    <p class="doc-note">
        <code>Format</code> takes any .NET numeric format and applies while the field is not focused; focus it and the plain number
        comes back for editing. <code>Culture</code> sets the separators and currency, for display and for parsing what is typed.
        The same value in four cultures:
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            @foreach (var (name, culture) in Cultures)
            {
                <NxNumericTextBox Id="@($"culture-{name}")" Label="@($"{name} · C")" Value="amount" ValueChanged="(decimal v) => amount = v"
                                  Format="C" Culture="culture" />
            }
        </div>
        <div class="demo-row"><span class="demo-value" id="culture-value">Value: <strong>@amount.ToString(CultureInfo.InvariantCulture)</strong></span></div>
    </div>
    <pre class="doc-code">@formatCode</pre>
</div>

<div class="doc-section">
    <h2>Decimals</h2>
    <p class="doc-note">
        <code>Decimals</code> rounds every committed value (half away from zero) and, without a <code>Format</code>, shows that many
        places. Type <em>3.14159</em> below.
    </p>
    <div class="demo-stage demo-stage-narrow">
        <div style="width:100%">
            <NxNumericTextBox Id="decimals-demo" Label="Rate (2 decimals)" @bind-Value="rate" Decimals="2" Culture="EnUs" />
            <div class="demo-row" style="margin-top:8px"><span class="demo-value" id="decimals-value">Value: <strong>@rate.ToString(CultureInfo.InvariantCulture)</strong></span></div>
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Prefix &amp; Suffix</h2>
    <p class="doc-note">
        Units and symbols go in <code>Prefix</code> and <code>Suffix</code>, inside the border. Parsing ignores a typed currency
        symbol, group separators, <code>%</code> and accounting parentheses — <em>(250)</em> is −250.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <NxNumericTextBox Id="affix-cost" Label="Cost" @bind-Value="cost" Format="N2" Culture="EnUs" Prefix="@Text("$")" Suffix="@Text("USD")" />
            <NxNumericTextBox Id="affix-margin" Label="Margin" @bind-Value="margin" Decimals="1" Culture="EnUs" Suffix="@Text("%")" />
            <NxNumericTextBox Id="affix-weight" Label="Weight" @bind-Value="weight" Format="N0" Culture="EnUs" Min="0" Suffix="@Text("lbs")" />
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Select on Focus</h2>
    <p class="doc-note">
        <code>SelectOnFocus</code> selects the whole number when the field gains focus — by Tab or by click — so typing replaces it.
        It suits quantity columns that are overwritten more often than edited.
    </p>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <NxNumericTextBox Id="select-on" Label="Select on focus" @bind-Value="selectOn" SelectOnFocus="true" Culture="EnUs" />
            <NxNumericTextBox Id="select-off" Label="Default" @bind-Value="selectOff" Culture="EnUs" />
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Labels, Clear &amp; State</h2>
    <div class="demo-stage">
        <div class="demo-form-grid">
            <NxNumericTextBox Id="state-floating" Label="Floating label" FloatingLabel="true" @bind-Value="floating" Culture="EnUs" />
            <NxNumericTextBox Id="state-clear" Label="Clearable" @bind-Value="clearable" Clearable="true" Culture="EnUs" />
            <NxNumericTextBox Id="state-readonly" Label="Read-only" Value="1250" ReadOnly="true" Format="N0" Culture="EnUs" />
            <NxNumericTextBox Id="state-disabled" Label="Disabled" Value="0" Disabled="true" Culture="EnUs" />
        </div>
    </div>
</div>

<div class="doc-section">
    <h2>Form Validation</h2>
    <p class="doc-note">
        Inside an <code>EditForm</code> the box reports changes and shows validation state; messages come from
        <code>ValidationMessage</code>. Clamping keeps values in range on its own, so <code>[Range]</code> here is about
        <code>[Required]</code> and business rules.
    </p>
    <div class="demo-stage demo-stage-column" style="max-width:560px">
        <EditForm id="numeric-form" Model="line" OnValidSubmit="SubmitLine" FormName="numeric-form">
            <DataAnnotationsValidator />
            <div class="demo-form-grid demo-form-grid-2">
                <div>
                    <NxNumericTextBox Id="line-qty" Label="Quantity" @bind-Value="line.Quantity" Min="0" Culture="EnUs" />
                    <ValidationMessage For="() => line.Quantity" />
                </div>
                <div>
                    <NxNumericTextBox Id="line-price" Label="Unit price" @bind-Value="line.Price" Format="N2" Culture="EnUs" Prefix="@Text("$")" />
                    <ValidationMessage For="() => line.Price" />
                </div>
            </div>
            <div class="demo-row" style="margin-top:16px">
                <NxButton id="line-submit" Type="NxButtonType.Submit" Variant="NxButtonVariant.Primary">Add line</NxButton>
                <span class="demo-value" id="line-result">@lineResult</span>
            </div>
        </EditForm>
    </div>
</div>

<DocPager Slug="numeric" Page="examples" />

@code {
    static readonly CultureInfo EnUs = CultureInfo.GetCultureInfo("en-US");
    static RenderFragment Text(string text) => @<span>@text</span>;

    static readonly (string Name, CultureInfo Culture)[] Cultures =
    [
        ("en-US", CultureInfo.GetCultureInfo("en-US")),
        ("en-GB", CultureInfo.GetCultureInfo("en-GB")),
        ("de-DE", CultureInfo.GetCultureInfo("de-DE")),
        ("fr-CA", CultureInfo.GetCultureInfo("fr-CA")),
    ];

    int typeInt = 42;
    decimal? typeDecimal;
    double typeDouble = 2.5;
    int discount = 15;
    decimal thickness = 8m;
    int pieces = 24, noSpin = 3;
    decimal amount = 1234567.891m;
    decimal rate = 1.5m;
    decimal cost = 18250m;
    decimal margin = 22.5m;
    int weight = 14800;
    int selectOn = 120, selectOff = 120;
    int? floating, clearable = 75;

    readonly LineForm line = new();
    string lineResult = "No line added";

    void SubmitLine() =>
        lineResult = $"Added {line.Quantity} × {line.Price?.ToString("C", EnUs)}";

    class LineForm
    {
        [Required(ErrorMessage = "Enter a quantity.")]
        [Range(1, 10_000, ErrorMessage = "Quantity is 1 to 10,000.")]
        public int? Quantity { get; set; }

        [Required(ErrorMessage = "Enter a unit price.")]
        public decimal? Price { get; set; }
    }

    const string rangeCode =
        """
        <NxNumericTextBox Label="Discount" @bind-Value="discount" Min="0" Max="100" Step="5">
            <Suffix>%</Suffix>
        </NxNumericTextBox>
        <NxNumericTextBox Label="Wall thickness" @bind-Value="thickness"
                          Min="4m" Max="24m" Step="0.25m" Decimals="2" />
        """;

    const string formatCode =
        """
        <NxNumericTextBox @bind-Value="amount" Format="C" Culture="@CultureInfo.GetCultureInfo("de-DE")" />
        """;
}
