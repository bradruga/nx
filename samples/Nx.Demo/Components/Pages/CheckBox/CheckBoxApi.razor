@page "/checkbox/api"

<DocHeader Slug="checkbox" Page="api" />

<div class="doc-section">
    <h2>Parameters</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>Value</td><td>TValue? (bool / bool?)</td><td>—</td><td>Use <code>@@bind-Value</code>. <code>null</code> is indeterminate.</td></tr>
                <tr><td>ThreeState</td><td>bool</td><td>false</td><td>With bool?, clicks cycle through indeterminate.</td></tr>
                <tr><td>Label</td><td>string?</td><td>—</td><td>Label text.</td></tr>
                <tr><td>ChildContent</td><td>RenderFragment?</td><td>—</td><td>Rich label content after Label.</td></tr>
                <tr><td>LabelPosition</td><td>NxLabelPosition</td><td>End</td><td>End or Start.</td></tr>
                <tr><td>Disabled</td><td>bool</td><td>false</td><td>Native disabled.</td></tr>
                <tr><td>ReadOnly</td><td>bool</td><td>false</td><td>Focusable, aria-readonly, clicks ignored.</td></tr>
                <tr><td>Id / Class / Style</td><td>string?</td><td>—</td><td>Box id; outer class and style. Other attributes go to the box.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>Events &amp; Methods</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Member</th><th>Type</th><th>Description</th></tr></thead>
            <tbody>
                <tr><td>ValueChanged</td><td>EventCallback&lt;TValue?&gt;</td><td>The user toggled the box.</td></tr>
                <tr><td>FocusAsync()</td><td>ValueTask</td><td>Moves keyboard focus to the box.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="doc-section">
    <h2>CSS Variables</h2>
    <div class="doc-table-wrap">
        <table class="doc-table doc-api-table">
            <thead><tr><th>Variable</th><th>Default</th><th>Used for</th></tr></thead>
            <tbody>
                <tr><td>--nx-check-size</td><td>18px</td><td>Box size (shared with NxRadioButton).</td></tr>
                <tr><td>--nx-check-border</td><td>= --nx-border-hover</td><td>Unchecked border.</td></tr>
                <tr><td>--nx-accent / --nx-accent-fg</td><td>#0078d4 / #fff</td><td>Checked fill and mark.</td></tr>
                <tr><td>--nx-surface / --nx-surface-disabled</td><td>#fff / #f5f5f7</td><td>Unchecked and read-only backgrounds.</td></tr>
                <tr><td>--nx-fg-muted</td><td>#6b6b78</td><td>Read-only checked fill.</td></tr>
                <tr><td>--nx-invalid</td><td>= --nx-danger</td><td>Border and label while invalid.</td></tr>
                <tr><td>--nx-focus-ring-color / -width / -offset</td><td>accent / 2px / 2px</td><td>Keyboard focus ring, shaped like the control; none on mouse or touch focus.</td></tr>
                <tr><td>--nx-radius-sm</td><td>4px</td><td>Box corners.</td></tr>
            </tbody>
        </table>
    </div>
</div>

