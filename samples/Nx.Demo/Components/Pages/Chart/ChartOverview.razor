@page "/chart"
@page "/chart/overview"

<DocHeader Slug="chart" Page="overview" />

<div class="doc-section">
    <h2>What It Is</h2>
    <p class="doc-note">
        <code>NxChart</code> draws line, area, column, bar and pie charts as SVG from .NET — no chart library, no canvas. Each
        <code>NxChartSeries</code> reads its <code>Data</code> through <code>Field</code> and <code>CategoryField</code>;
        an <code>NxChartCategoryAxis</code> (plain or dates) and <code>NxChartValueAxis</code> elements set the
        scales. The legend hides and shows series, tooltips follow the pointer, a tap or the arrow keys, and the chart redraws to
        fit its container.
    </p>
</div>

<div class="doc-section">
    <h2>Basic Usage</h2>
    <div class="demo-stage demo-stage-column">
        <NxChart Id="overview-chart" Title="Loads shipped per day" Height="320px">
            <NxChartSeries Name="Loads" Data="DemoCharts.Days" Field="@nameof(YardDay.Loads)" CategoryField="@nameof(YardDay.Date)" />
            <NxChartValueAxis Title="Loads" />
        </NxChart>
    </div>
    <pre class="doc-code">@basicCode</pre>
</div>

<div class="doc-section">
    <h2>Keyboard &amp; Accessibility</h2>
    <div class="doc-table-wrap">
        <table class="doc-table">
            <thead><tr><th>Key / part</th><th>Behavior</th></tr></thead>
            <tbody>
                <tr><td>Tab</td><td>Focuses the plot (one stop), then each legend entry.</td></tr>
                <tr><td>← / →</td><td>The same series' previous / next point, with its tooltip (the next slice in a pie).</td></tr>
                <tr><td>↑ / ↓</td><td>Another series' point in the same category.</td></tr>
                <tr><td>Home / End</td><td>The first / last point.</td></tr>
                <tr><td>Enter / Space</td><td>Raises <code>OnSeriesClick</code> for the point shown.</td></tr>
                <tr><td>Escape</td><td>Hides the tooltip.</td></tr>
                <tr><td>Legend</td><td>Each entry is a toggle button (<code>aria-pressed</code>) that hides or shows its series or slice.</td></tr>
                <tr><td>Screen readers</td><td>The plot is a group named by <code>Title</code>, described by a hidden table of every value.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<DocPager Slug="chart" Page="overview" />

@code {
    const string basicCode =
        """
        <NxChart Title="Loads shipped per day" Height="320px">
            <NxChartSeries Name="Loads" Data="days" Field="@nameof(YardDay.Loads)" CategoryField="@nameof(YardDay.Date)" />
            <NxChartValueAxis Title="Loads" />
        </NxChart>
        """;
}
