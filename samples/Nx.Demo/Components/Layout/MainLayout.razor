@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@* data-interactive tells the Playwright tests the circuit is live and clicks will be handled. *@
<div class="layout-container @(isMobileNavOpen ? "nav-open" : "")" data-interactive="@(RendererInfo.IsInteractive ? "true" : null)">
    <header class="top-nav">
        <div class="nav-inner">
            <button class="doc-hamburger" @onclick="ToggleNav" aria-label="@(isMobileNavOpen ? "Close navigation" : "Open navigation")"
                    aria-expanded="@(isMobileNavOpen ? "true" : "false")" aria-controls="site-nav">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <a href="" class="top-nav-logo">
                <span class="nav-logo-mark">N</span>
                Nx Components
            </a>
            <span class="top-nav-tag">Blazor · .NET 10</span>
            <div class="top-nav-right">
                <SiteSearchButton />
                <button class="top-nav-theme" @onclick="ToggleDark"
                        title="Toggle dark mode" aria-label="Toggle dark mode" aria-pressed="@(isDarkMode ? "true" : "false")">
                    @if (isDarkMode)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/>
                            <line x1="4.22" y1="4.22" x2="7.05" y2="7.05"/><line x1="16.95" y1="16.95" x2="19.78" y2="19.78"/>
                            <line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/>
                            <line x1="4.22" y1="19.78" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.78" y2="4.22"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </svg>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="doc-body">
        <div class="nav-overlay" @onclick="CloseNav"></div>
        <nav class="nav-sidebar" id="site-nav" aria-label="Components" @onkeydown="OnKeyDown">
            <NavMenu />
        </nav>
        <main class="main-content">
            @Body
        </main>
        <NxDialogHost />
        <SiteSearch />
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    bool isDarkMode;
    bool isMobileNavOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "nx-demo-theme");
        if (saved == "dark")
        {
            isDarkMode = true;
            StateHasChanged();
        }
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMobileNavOpen = false;
        InvokeAsync(StateHasChanged);
    }

    async Task ToggleDark()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "nx-demo-theme", isDarkMode ? "dark" : "light");
        await JS.InvokeVoidAsync("__nxSetDark", isDarkMode);
    }

    void ToggleNav() => isMobileNavOpen = !isMobileNavOpen;

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && isMobileNavOpen)
            isMobileNavOpen = false;
    }
    void CloseNav() => isMobileNavOpen = false;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
