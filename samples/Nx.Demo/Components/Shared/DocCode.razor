@* A code sample: highlighted on the server (CodeHighlighter), with a copy button. Token colors live in demo.css. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="doc-code-block">
    <pre class="doc-code" @attributes="AdditionalAttributes">@Highlighted</pre>
    <button type="button" class="doc-code-copy @(copied ? "doc-code-copied" : null)" @onclick="CopyAsync"
            aria-label="@(copied ? "Copied" : "Copy code")" title="Copy code">
        @if (copied)
        {
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            <span>Copied</span>
        }
        else
        {
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
            <span>Copy</span>
        }
    </button>
</div>

@code {
    /// <summary>The code to show and copy.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>Attributes for the <c>pre</c>, such as an id a test reads.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    string? tokenized;
    List<CodeToken> tokens = [];
    bool copied;
    int copyCount;
    IJSObjectReference? module;

    protected override void OnParametersSet()
    {
        if (Code == tokenized)
            return;
        tokens = CodeHighlighter.Tokenize(Code);
        tokenized = Code;
    }

    void Highlighted(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
    {
        foreach (var token in tokens)
        {
            if (token.Kind is null)
            {
                builder.AddContent(0, token.Text);
                continue;
            }
            builder.OpenElement(1, "span");
            builder.AddAttribute(2, "class", token.Kind);
            builder.AddContent(3, token.Text);
            builder.CloseElement();
        }
    }

    async Task CopyAsync()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./doc-code.js");
        if (!await module.InvokeAsync<bool>("copy", Code))
            return;
        var mine = ++copyCount;
        copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        if (mine == copyCount)
            copied = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
            return;
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
